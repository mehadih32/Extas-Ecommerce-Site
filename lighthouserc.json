{
  "ci": {
    "collect": {
      "startServerCommand": "node apps/web/.next/standalone/apps/web/server.js",
      "startServerReadyPattern": "Ready|started server|Local:",
      "url": [
        "http://127.0.0.1:3000/status",
        "http://127.0.0.1:3000/admin/login",
        "http://127.0.0.1:3000/admin/products",
        "http://127.0.0.1:3000/admin/products/queue",
        "http://127.0.0.1:3000/admin/size-charts",
        "http://127.0.0.1:3000/admin/products/import",
        "http://127.0.0.1:3000/admin/products/audit",
        "http://127.0.0.1:3000/admin/products/back-in-stock",
        "http://127.0.0.1:3000/admin/stock",
        "http://127.0.0.1:3000/admin/stock/counts",
        "http://127.0.0.1:3000/admin/stock/movements",
        "http://127.0.0.1:3000/admin/rules",
        "http://127.0.0.1:3000/admin/rules/notices",
        "http://127.0.0.1:3000/admin/combos",
        "http://127.0.0.1:3000/admin/delivery",
        "http://127.0.0.1:3000/",
        "http://127.0.0.1:3000/bn",
        "http://127.0.0.1:3000/checkout",
        "http://127.0.0.1:3000/bn/checkout",
        "http://127.0.0.1:3000/checkout/thanks/0",
        "http://127.0.0.1:3000/bag",
        "http://127.0.0.1:3000/bn/bag",
        "http://127.0.0.1:3000/account/wishlist",
        "http://127.0.0.1:3000/help/faq",
        "http://127.0.0.1:3000/bn/help/exchange",
        "http://127.0.0.1:3000/collections/new-in",
        "http://127.0.0.1:3000/bn/collections/new-in",
        "http://127.0.0.1:3000/search?q=polo",
        "http://127.0.0.1:3000/bn/search",
        "http://127.0.0.1:3000/account/login",
        "http://127.0.0.1:3000/account",
        "http://127.0.0.1:3000/account/orders/0"
      ],
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--no-sandbox --headless=new",
        "throttlingMethod": "devtools"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.9,
            "aggregationMethod": "median-run"
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.9,
            "aggregationMethod": "median-run"
          }
        ],
        "largest-contentful-paint": [
          "error",
          {
            "maxNumericValue": 2500,
            "aggregationMethod": "median-run"
          }
        ],
        "cumulative-layout-shift": [
          "error",
          {
            "maxNumericValue": 0.1,
            "aggregationMethod": "median-run"
          }
        ],
        "total-blocking-time": [
          "error",
          {
            "maxNumericValue": 200,
            "aggregationMethod": "median-run"
          }
        ],
        "server-response-time": [
          "error",
          {
            "maxNumericValue": 600,
            "aggregationMethod": "median-run"
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}

# EXTAS Caddy (PR 7). Automatic HTTPS (Let's Encrypt, with Caddy's internal CA as a fallback so Cloudflare
# "Full" always reaches us; PR 397: the Cloudflare Origin certificate instead once it is in the vault, for "Full (strict)"), HTTP/2 + HTTP/3, compression, security headers.
# The host names are settings (infra/config/server.conf → EXTAS_STAGING_HOST, EXTAS_EXTRA_HOSTS). The preview password and the
# upstream (static page → app, blue/green) are files in /srv/extas/config/caddy/sites written by the scripts.
{
	admin localhost:2019
	servers {
		protocols h1 h2 h3
		# PR 620 · p3 review round 2: CF-Connecting-IP is believed from Cloudflare's ranges only (written by the server
		# setup from infra/config/cloudflare-ips.txt, infra/stack/caddy/client-ip-block.sh); the upstream overwrites the
		# header with {client_ip}, so the app's client address is always Caddy's.
		# A glob, so a server whose setup has not yet written the file still loads (Caddy only warns on no match).
		import /etc/caddy/sites/client-ip*.caddy
	}
}

# PR 378 (B6.1 review): the checkout's "share my location" (GpsShare, PR 159) needs geolocation on this site itself, so
# it is (self), not () — () switched the feature off in every browser. The short page policy is always on: no plugins,
# no <base> tag, no framing by another site. The full policy (what scripts, images and connections a page may use) is
# the app's, from the settings (`security.csp.mode`, report only by default; apps/web/src/lib/security/csp.ts).
(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "SAMEORIGIN"
		Permissions-Policy "camera=(), microphone=(), geolocation=(self), payment=(), usb=()"
		X-Permitted-Cross-Domain-Policies "none"
		# "?": only when the app sent no enforced policy of its own (that one already holds these three lines).
		?Content-Security-Policy "object-src 'none'; base-uri 'self'; frame-ancestors 'self'"
		-Server
	}
}

# PR 602 (S02) — the cache's edge rules (server spec §5, packages/cache). The bag, the checkout, the account, the admin
# and the API are never kept: not by the browser, not by Cloudflare (apps/web/src/lib/cache-policy.ts NEVER_CACHED has
# the same list; apps/web/src/lib/cache.test.ts checks both). Next.js's hashed files keep a year at Cloudflare too,
# because a new build gives them new names. The app's internal addresses (the deploy's "clear the cache" call) are
# never reachable from outside: deploy.sh calls the app inside the Docker network.
(cache_headers) {
	@never_cached path /bag /bag/* /checkout /checkout/* /account /account/* /bn/bag /bn/bag/* /bn/checkout /bn/checkout/* /bn/account /bn/account/* /admin /admin/* /api/*
	header @never_cached {
		Cache-Control "private, no-store"
		CDN-Cache-Control "no-store"
		defer
	}
	@hashed_files path /_next/static/*
	header @hashed_files CDN-Cache-Control "public, max-age=31536000, immutable"
	@internal path /api/internal /api/internal/*
	respond @internal 404
}

# R2 security review (m3, PR 602): a host behind the preview password never lets Cloudflare keep a page. The gate is
# Caddy's alone, so a page Cloudflare kept for a signed-in team member ("Cloudflare keeps pages", cache.pages.cdn, and
# its cache rule on the shop's hosts) would reach anyone without the password. On a gated host every answer but
# Next.js's hashed files (code, never the shop's content) says no-store to Cloudflare and private to the browser,
# whatever the app or that switch says. Imported by the staging block and by a locked extra host (hosts-block.sh).
(gated_cache) {
	@gated_pages not path /_next/static/*
	header @gated_pages {
		Cache-Control "private, no-store"
		CDN-Cache-Control "no-store"
		Cloudflare-CDN-Cache-Control "no-store"
		defer
	}
}

# R2 security review (m1, PR 378): no request body bigger than the server.conf limits reaches the app. Next's proxy
# holds a whole body in memory (up to its 200 MB, apps/web/next.config.ts) before a route can refuse it, so a few dozen
# large anonymous POSTs could run an app copy out of memory. Caddy answers 413 instead: CADDY_UPLOAD_MAX_MB on the
# admin's file uploads (media library, product photos, packing photo, support files), CADDY_BODY_MAX_MB everywhere else.
# The numbers come from the container's environment (compose.yml, stack.env); the fallbacks are server.conf's defaults,
# so a Caddy started before the setup wrote them still loads.
(body_limits) {
	@upload_body path /api/admin/media /api/admin/media/* /api/admin/packing/orders/* /api/admin/support /api/admin/support/*
	request_body @upload_body {
		max_size {$CADDY_UPLOAD_MAX_MB:30}MB
	}
	@capped_body not path /api/admin/media /api/admin/media/* /api/admin/packing/orders/* /api/admin/support /api/admin/support/*
	request_body @capped_body {
		max_size {$CADDY_BODY_MAX_MB:25}MB
	}
}

# PR 403: what every public host shares — the headers, the cache rules, compression, the certificate and the log.
(extas_site) {
	import security_headers
	import cache_headers
	import body_limits
	encode zstd gzip
	# PR 397: sites/tls.caddy (infra/server/bin/extas-origin-cert) names the Cloudflare Origin certificate once its pair
	# is in the vault and checked, else Caddy's automatic certificate (Let's Encrypt, Caddy's own as the fallback).
	# A glob: a server whose setup has not yet written the file still loads, on the automatic certificate.
	import /etc/caddy/sites/tls*.caddy
	# Review R1 (security m5): the access log never keeps what a link or a box carries: no query string at all (the
	# address being typed in ?q=, a payment callback's ids and signature, Meta's verify token), no advance pay link's
	# token (/pay/<token>, /bn/pay/<token>), and no Referer header (it repeats the page's whole address).
	log {
		output file /var/log/caddy/access.log {
			roll_size 50MiB
			roll_keep 10
		}
		format filter {
			wrap json
			request>uri regexp "^(/(?:bn/)?pay/).*$|[?].*$" "${1}"
			request>headers>Referer delete
		}
	}
}

# PR 403: the staging host is ALWAYS behind the preview password and noindex, also after go-live.
# ~~PR 362: the extra host names were served in this same block, so they shared the gate.~~
{$EXTAS_STAGING_HOST} {
	import extas_site
	import gated_cache
	import /etc/caddy/sites/noindex.caddy
	import /etc/caddy/sites/auth.caddy
	import /etc/caddy/sites/upstream.caddy
}

# PR 362 / PR 403: the extra host names (server.conf EXTAS_EXTRA_HOSTS, cleaned by server setup: the main domain on
# go-live day, a store's own domain) have their own block, each with its own automatic certificate. Server setup writes
# it (infra/stack/caddy/hosts-block.sh): locked like the staging host until server.conf EXTAS_MAIN_OPEN="yes" (the
# owner's go-live day step). No extra hosts, no file: a glob.
import /etc/caddy/sites/hosts*.caddy

# Internal only — not published. Health checks, the k6 baseline and deploy smoke tests use it.
:8080 {
	respond /caddy-health "ok" 200
	import /etc/caddy/sites/upstream.caddy
}

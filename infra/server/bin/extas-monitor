#!/usr/bin/env bash
# PR 9 — monitoring from day one (A2.9.13). Runs every minute (extas-monitor.timer).
# Writes $EXTAS_ROOT/state/health.json (read by the admin Server page, PR 423, and the status page) and sends
# Telegram alerts when a disk passes the alarm level, a service is down, a backup failed or is too old, the site is
# slow, or the NVMe is missing. Until the owner adds the Telegram bot in the vault, alerts are written to
# $EXTAS_ROOT/logs/alerts.log only. An alert repeats at most every MONITOR_REPEAT_MIN minutes, and a "fixed" message
# follows when it clears.
set -uo pipefail
CONF="${EXTAS_CONFIG_FILE:-/etc/extas/server.conf}"
# shellcheck source=../../config/server.conf
. "$CONF"
R="$EXTAS_ROOT"; STATE="$R/state"; SEC="$R/config/secrets"
mkdir -p "$STATE/alerts" "$R/logs"
[ -f "$SEC/telegram.env" ] && . "$SEC/telegram.env"   # TELEGRAM_BOT_TOKEN, TELEGRAM_CHAT_ID (from the vault)
# PR 507: "Telegram when a backup fails" (Settings → System → Backups); off, those alerts stay in the log and the
# health page only.
BACKUP_TELEGRAM_FAIL="$(sed -n "s/^BACKUP_TELEGRAM_FAIL='\(yes\|no\)'$/\1/p" "$SEC/backup-settings.env" 2>/dev/null || true)"

send() {
  local text="$1"
  echo "$(date -Is) $text" >> "$R/logs/alerts.log"
  if [ -n "${TELEGRAM_BOT_TOKEN:-}" ] && [ -n "${TELEGRAM_CHAT_ID:-}" ]; then
    curl -fsS -m 10 "https://api.telegram.org/bot${TELEGRAM_BOT_TOKEN}/sendMessage" \
      --data-urlencode "chat_id=${TELEGRAM_CHAT_ID}" --data-urlencode "text=${text}" >/dev/null 2>&1 || true
  fi
}

PROBLEMS=()
alert() { # alert <key> <bad:0|1> <message in simple Bengali>
  local key="$1" bad="$2" msg="$3" f="$STATE/alerts/$1" now last
  now="$(date +%s)"
  if [ "$bad" = 1 ]; then
    PROBLEMS+=("$msg")
    last="$(cat "$f" 2>/dev/null || echo 0)"
    if [ $((now - last)) -ge $((MONITOR_REPEAT_MIN * 60)) ]; then
      if [ -n "${QUIET:-}" ]; then echo "$(date -Is) (quiet) $msg" >> "$R/logs/alerts.log"; else send "⚠️ EXTAS সার্ভার: $msg"; fi
      echo "$now" > "$f"
    fi
  elif [ -f "$f" ]; then
    if [ -z "${QUIET:-}" ]; then send "✅ EXTAS সার্ভার: ঠিক হয়েছে — $key"; fi
    rm -f "$f"
  fi
}

# Disks (every volume) — alarm at EXTAS_DISK_ALARM_PCT
DISKS_JSON="["
while read -r mp pct; do
  p="${pct%\%}"
  DISKS_JSON+="{\"mount\":\"$mp\",\"used_pct\":$p},"
  key="disk$(echo "$mp" | tr '/' '_')"
  alert "$key" "$([ "$p" -ge "$EXTAS_DISK_ALARM_PCT" ] && echo 1 || echo 0)" "ডিস্ক $mp ${p}% ভরে গেছে"
done < <(df --output=target,pcent -x tmpfs -x devtmpfs -x overlay -x squashfs -x efivarfs | tail -n +2 | awk '{print $1, $2}')
DISKS_JSON="${DISKS_JSON%,}]"

# PR 4 follow-up: when / passes DISK_SNAPSHOT_PCT, keep a picture of what fills it (at most every MONITOR_REPEAT_MIN),
# so a fill-up is explained even if a restart clears it: biggest folders on / alone, files over 1 GB, and deleted
# files still held open by a program (these use space but no folder shows them).
root_pct="$(df --output=pcent / | tail -1 | tr -dc '0-9')"
SNAP_DIR="$R/logs/disk-snapshots"
if [ "${root_pct:-0}" -ge "${DISK_SNAPSHOT_PCT:-60}" ]; then
  last="$(ls -1t "$SNAP_DIR" 2>/dev/null | head -1)"
  if [ -z "$last" ] || [ $(( $(date +%s) - $(stat -c %Y "$SNAP_DIR/$last") )) -ge $((MONITOR_REPEAT_MIN * 60)) ]; then
    mkdir -p "$SNAP_DIR"
    {
      echo "# / at ${root_pct}% — $(date -Is)"
      df -h /
      echo; echo "## Biggest folders on / alone"
      timeout 300 du -x -h -d 3 / 2>/dev/null | sort -rh | head -25
      echo; echo "## Files over 1 GB on /"
      timeout 300 find / -xdev -type f -size +1G -printf '%s\t%p\n' 2>/dev/null | sort -rn | head -20 \
        | awk -F'\t' '{printf "%.1f GB\t%s\n", $1/1073741824, $2}'
      echo; echo "## Deleted files still held open (program → size)"
      for fd in /proc/[0-9]*/fd/*; do
        tgt="$(readlink "$fd" 2>/dev/null)" || continue
        case "$tgt" in *' (deleted)') ;; *) continue ;; esac
        sz="$(stat -L -c %s "$fd" 2>/dev/null || echo 0)"
        [ "$sz" -ge 104857600 ] || continue
        pid="${fd#/proc/}"; pid="${pid%%/*}"
        awk -v s="$sz" -v c="$(cat "/proc/$pid/comm" 2>/dev/null)" -v p="$pid" -v t="$tgt" \
          'BEGIN{printf "%.1f GB\t%s (pid %s)\t%s\n", s/1073741824, c, p, t}'
      done | sort -rh | head -20
    } > "$SNAP_DIR/$(date +%Y%m%d-%H%M).txt" 2>&1
    ls -1t "$SNAP_DIR" | tail -n +$(( ${DISK_SNAPSHOT_KEEP:-20} + 1 )) | sed "s|^|$SNAP_DIR/|" | xargs -r rm -f
  fi
fi

# NVMe (PR 601)
nvme="mounted"
if [ -f /run/extas/nvme-missing ] || ! mountpoint -q "$EXTAS_NVME_MOUNT"; then nvme="missing"; fi
alert nvme "$([ "$nvme" = missing ] && echo 1 || echo 0)" "NVMe (দ্রুত অস্থায়ী ডিস্ক) পাওয়া যাচ্ছে না"

# Services
SVC_JSON="["
for c in extas-postgres extas-pgbouncer extas-redis-cache extas-redis-queue extas-meilisearch extas-caddy; do
  st="$(docker inspect -f '{{if .State.Health}}{{.State.Health.Status}}{{else}}{{.State.Status}}{{end}}' "$c" 2>/dev/null || echo missing)"
  SVC_JSON+="{\"name\":\"$c\",\"state\":\"$st\"},"
  alert "svc_$c" "$([ "$st" = healthy ] || [ "$st" = running ] && echo 0 || echo 1)" "$c বন্ধ ($st)"
done
apps="$(docker ps --filter name=extas-app --format '{{.Names}}' | wc -l)"
SVC_JSON+="{\"name\":\"app replicas\",\"state\":\"$apps running\"}]"

# Per-service RAM/CPU against its limit (for PR 423)
STATS_JSON="$(docker stats --no-stream --format '{"name":"{{.Name}}","cpu":"{{.CPUPerc}}","mem":"{{.MemUsage}}","mem_pct":"{{.MemPerc}}"}' 2>/dev/null | paste -sd, -)"

# Site speed (Caddy's internal port, bound to 127.0.0.1 only)
ms="$(curl -s -o /dev/null -m 10 -w '%{time_total}' http://127.0.0.1:8080/ 2>/dev/null | awk '{printf "%d", $1*1000}')"
[ -n "$ms" ] && [ "$ms" -gt 0 ] || ms=99999
alert slow "$([ "${ms:-99999}" -gt "$MONITOR_SLOW_MS" ] && echo 1 || echo 0)" "সাইট ধীর (${ms} ms)"

# Backups: the daily local backup must be fresh; a failed Blob/Drive upload alerts (an unconnected one does not)
BQ=""; [ "${BACKUP_TELEGRAM_FAIL:-yes}" = no ] && BQ=1
bk_age_h=9999
if [ -f "$STATE/backup-daily-local.json" ]; then
  bk_age_h=$(( ($(date +%s) - $(stat -c %Y "$STATE/backup-daily-local.json")) / 3600 ))
  grep -q '"result":"fail"' "$STATE/backup-daily-local.json" && bk_age_h=9999
fi
if [ -f "$STATE/stack.started" ] && [ $(( $(date +%s) - $(stat -c %Y "$STATE/stack.started") )) -gt $((MONITOR_BACKUP_MAX_AGE_H * 3600)) ]; then
  QUIET="$BQ" alert backup_local "$([ "$bk_age_h" -gt "$MONITOR_BACKUP_MAX_AGE_H" ] && echo 1 || echo 0)" "ব্যাকআপ ${MONITOR_BACKUP_MAX_AGE_H} ঘণ্টার বেশি পুরনো বা ব্যর্থ"
fi
for t in blob drive; do
  f="$STATE/backup-daily-$t.json"
  QUIET="$BQ" alert "backup_$t" "$(grep -q '"result":"fail"' "$f" 2>/dev/null && echo 1 || echo 0)" "$t ব্যাকআপ ব্যর্থ হয়েছে"
done
[ -f "$STATE/restore-test.json" ] && QUIET="$BQ" alert restore_test "$(grep -q '"result":"fail"' "$STATE/restore-test.json" && echo 1 || echo 0)" "ব্যাকআপ ফেরানোর পরীক্ষা ব্যর্থ"
# PR 507: the monthly drill as a whole (one copy failing is enough, even when the last one passed).
[ -f "$STATE/restore-drill.json" ] && QUIET="$BQ" alert restore_drill "$(jq -e '.result == "fail"' "$STATE/restore-drill.json" >/dev/null 2>&1 && echo 1 || echo 0)" "মাসিক ফেরানোর মহড়া ব্যর্থ: $(jq -r '.detail' "$STATE/restore-drill.json" 2>/dev/null | cut -c1-300)"

load="$(cut -d' ' -f1 /proc/loadavg)"
mem_used_pct="$(free | awk '/^Mem:/{printf "%d", ($3/$2)*100}')"
problems_json="$(printf '%s\n' "${PROBLEMS[@]:-}" | jq -R . | jq -s 'map(select(length>0))')"
cat > "$STATE/health.json.new" <<JSON
{"at":"$(date -Is)","load1":$load,"cpus":$(nproc),"mem_used_pct":$mem_used_pct,"nvme":"$nvme",
 "site_ms":${ms:-null},"disks":$DISKS_JSON,"services":$SVC_JSON,"stats":[${STATS_JSON}],
 "backup_age_h":$bk_age_h,"problems":$problems_json}
JSON
mv "$STATE/health.json.new" "$STATE/health.json"
cp /run/extas/nvme.json "$STATE/nvme.json" 2>/dev/null || true

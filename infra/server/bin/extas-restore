#!/usr/bin/env bash
# PR 8 — one-command restore (A2.9.12), tested.
#   extas-restore test
#       Restores the newest base backup + WAL into a throwaway PostgreSQL on the NVMe, checks it, removes it; restores
#       one sample product photo from the newest photo archives and compares its checksum; unpacks the newest docs
#       bundle and checks that README.md, the blueprint and the register came back and that its COMMIT matches.
#       Run after every setup and monthly by a timer; the result is shown in the admin and alerted (PR 9, 395, 507).
#   extas-restore drill [--only all|local|blob|drive]
#       PR 507, the monthly restore drill (its timer) and "Run the restore drill now" in the admin: `test` from the
#       server's disk, then from Azure Blob and from Google Drive when the drill settings name them and they are
#       connected — each into the same throw-away database, never the live one. Each writes restore-test-<from>.json;
#       the drill writes restore-drill.json (every run and its words) and, when the owner asked, a good result on
#       Telegram (a failure comes from extas-monitor).
#   extas-restore media [--from local|blob|drive] [--into live]
#       The product photos from the newest full photo archive and the newest diff on it, every checksum checked.
#       Default: into a folder on the NVMe for checking (the path is printed). --into live copies the photos that are
#       missing back into the photo folder after typing RESTORE; it never overwrites or deletes a photo.
#   extas-restore --from local|blob|drive [--at "YYYY-MM-DD HH:MM"] [--backup YYYYMMDD-HHMM] [--target staging|production]
#                 [--confirm RESTORE]
#       local/blob: base backup + WAL replay to the chosen minute (default: as late as possible).
#       drive: the daily encrypted dump (no minute choice) — the fallback when Blob is unavailable.
#       --backup: exactly that backup (PR 396), not the newest before the minute.
#       staging (default): leaves a restored copy running as container extas-pg-restore for checking (until the next
#       restore, test or drill, which starts its own).
#       production: replaces the live database after typing RESTORE (or --confirm RESTORE, PR 396). The old data is
#       kept, never deleted: a base backup swaps the data folder (the old one stays beside it), a Drive dump goes into the
#       live server under a new name and the names are swapped (the old database stays as extas_before_restore_<time>).
#       Before the shop's containers it stopped start again, the restored database is brought to the live version's
#       schema with that version's migrate image (the deploy's migrate step: migrations, then the settings sync), so a
#       backup from before a newer deploy never meets a newer app (R2 ops M3). A failed migration, a failed step, a
#       cancel or a timeout (INT, TERM, HUP) puts the live database back (R2 ops M4).
#   extas-restore request <id> staging|production <local|blob|drive> <backup|-> <minute (ISO, UTC)|-> <staging id|->
#       PR 396, a restore asked for in the admin (the vault sync starts it in a transient unit): staging restores into
#       the check copy and keeps proof of it (state/restore-staging.json: the request, the copy, the backup used);
#       production runs only when that proof is for the same staging request, copy, backup and minute, it passed, and
#       it is no older than RESTORE_STAGING_VALID_H hours. The outcome goes to state/requests/<id>.json for the admin
#       and, for production, to state/restore-production.json and the owner's Telegram.
set -euo pipefail
CONF="${EXTAS_CONFIG_FILE:-/etc/extas/server.conf}"
# shellcheck source=../../config/server.conf
. "$CONF"
R="$EXTAS_ROOT"; SEC="$R/config/secrets"; STATE="$R/state"; LOCAL="$R/backups"
# PR 507: the backup settings of Settings → System → Backups (the vault sync writes them); they win over server.conf.
# Only the known names, each checked, so a broken file can never set anything else.
load_backup_settings() {
  local f="$SEC/backup-settings.env" k v
  [ -f "$f" ] || return 0
  while IFS='=' read -r k v; do
    v="${v#\'}"; v="${v%\'}"
    case "$k" in
      BACKUP_TIME|BACKUP_DRILL_TIME) [[ "$v" =~ ^([01][0-9]|2[0-3]):[0-5][0-9]$ ]] || continue ;;
      BACKUP_KEEP_LOCAL_DAYS|BACKUP_KEEP_BLOB_DAYS|BACKUP_KEEP_DRIVE_DAYS|BACKUP_KEEP_LOCAL_WAL_DAYS|BACKUP_MIN_FREE_PCT|BACKUP_DRILL_DAY)
        [[ "$v" =~ ^[0-9]{1,4}$ ]] || continue ;;
      BACKUP_DRILL_ON|BACKUP_DRILL_BLOB|BACKUP_DRILL_DRIVE|BACKUP_TELEGRAM_FAIL|BACKUP_TELEGRAM_OK) [[ "$v" =~ ^(yes|no)$ ]] || continue ;;
      *) continue ;;
    esac
    printf -v "$k" '%s' "$v"
  done < "$f"
}
load_backup_settings
# A Telegram line to the owner (telegram.env from the vault sync, PR 392); without the bot it goes to the log only.
tg() {
  echo "$(date -Is) $1" >> "$R/logs/alerts.log" 2>/dev/null || true
  [ -f "$SEC/telegram.env" ] || return 0
  # shellcheck disable=SC1091
  ( . "$SEC/telegram.env"
    [ -n "${TELEGRAM_BOT_TOKEN:-}" ] && [ -n "${TELEGRAM_CHAT_ID:-}" ] || exit 0
    curl -fsS -m 10 "${TELEGRAM_API_BASE:-https://api.telegram.org}/bot${TELEGRAM_BOT_TOKEN}/sendMessage" \
      --data-urlencode "chat_id=${TELEGRAM_CHAT_ID}" --data-urlencode "text=$1" >/dev/null 2>&1 ) || true
}
[ -f "$SEC/backup.env" ] && set -a && . "$SEC/backup.env" && set +a
BLOB_PATH="${BACKUP_BLOB_CONTAINER:-extas-backups}"; DRIVE_PATH="${BACKUP_DRIVE_FOLDER-EXTAS-backups}"
dpath() { echo "drive:${DRIVE_PATH:+$DRIVE_PATH/}$1"; }   # see extas-backup (PR 395: empty = the backup folder itself)
TS="$(date +%Y%m%d-%H%M%S)"
WORK="$EXTAS_NVME_MOUNT/scratch/restore-$TS"
NAME="extas-pg-restore"

MEDIA="$R/data/media"   # the product photos on the local disk (see extas-backup)
DOCS="$R/docs/current"  # the server's copy of the repository's docs (PR 594, CN-011)

FROM=local; AT=""; TARGET=staging; MODE=restore; INTO=""; ONLY=all; BACKUP=""; CONFIRM=""; REQ=()
case "${1:-}" in
  test) MODE="test"; shift ;; media) MODE="media"; shift ;; drill) MODE="drill"; shift ;;
  request) MODE="request"; shift; REQ=("$@"); set -- ;;
esac
while [ $# -gt 0 ]; do
  case "$1" in
    --only) ONLY="$2"; shift 2 ;;
    --backup) BACKUP="$2"; shift 2 ;;
    --confirm) CONFIRM="$2"; shift 2 ;;
    --from) FROM="$2"; shift 2 ;;
    --at) AT="$2"; shift 2 ;;
    --target) TARGET="$2"; shift 2 ;;
    --into) INTO="$2"; shift 2 ;;
    *) echo "unknown option $1" >&2; exit 2 ;;
  esac
done

# One restore at a time (PR 396): a staging restore, the restore test and the drill share the container $NAME and its
# `docker rm -f`, so two at once would kill each other's copy. The first run takes state/restore.lock and waits at most
# RESTORE_LOCK_WAIT_S for one already running; the runs it starts itself (the drill's tests, a request's restore)
# share its lock (EXTAS_RESTORE_LOCK_HELD).
if [ -z "${EXTAS_RESTORE_LOCK_HELD:-}" ]; then
  mkdir -p "$STATE"
  exec 9>"$STATE/restore.lock"
  if ! flock -w "${RESTORE_LOCK_WAIT_S:-3600}" 9; then
    busy="another restore, restore test or drill was still running after ${RESTORE_LOCK_WAIT_S:-3600} s; nothing was changed"
    case "$MODE" in
      test|restore) printf '{"result":"fail","detail":"%s","from":"%s","at":"%s","backup":"","target":"%s"}\n' "$busy" "$FROM" \
        "$(date -Is)" "$TARGET" > "$STATE/restore-$MODE.json" ;;
      request) if [[ "${REQ[0]:-}" =~ ^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$ ]]; then
          mkdir -p "$STATE/requests"
          jq -n --arg id "${REQ[0]}" --arg detail "$busy" '{id:$id, ok:false, detail:$detail}' > "$STATE/requests/${REQ[0]}.json"
        fi ;;
    esac
    echo "FAIL: $busy" >&2; exit 1
  fi
  export EXTAS_RESTORE_LOCK_HELD=1
fi

cleanup() { docker rm -f "$NAME" >/dev/null 2>&1 || true; [ "$MODE" = test ] && rm -rf "$WORK"; return 0; }
# The PostgreSQL tools inside the container (31 Oct 2026, GitHub #65): /usr/bin/pg_dump, psql and pg_basebackup there
# are Debian's pg_wrapper, which fails ("You must install at least one postgresql-client-<version> package") since the
# containerd move; the server's own tools are in /usr/lib/postgresql/<n>/bin, put first on PATH. Same as
# infra/deploy/pg-exec.sh `pg_exec`, for any container (the restore test's own one too).
PG_PATH='PATH="$(ls -d /usr/lib/postgresql/*/bin 2>/dev/null | sort -V | tail -1):$PATH"'
pgx() { # pgx [-i] [-u user] <container> <tool> <args…>
  local o=()
  while [ "${1:-}" = -i ] || [ "${1:-}" = -u ]; do
    if [ "$1" = -u ]; then o+=(-u "$2"); shift 2; else o+=(-i); shift; fi
  done
  local c="$1"; shift
  docker exec "${o[@]}" "$c" bash -c "$PG_PATH"'; exec "$@"' pgx "$@"
}
RESTORED=""   # PR 396: the backup a restore used (its stamp), for the admin
result() {
  printf '{"result":"%s","detail":"%s","from":"%s","at":"%s","backup":"%s","target":"%s"}\n' "$1" "$2" "$FROM" "$(date -Is)" \
    "$RESTORED" "$TARGET" > "$STATE/restore-$MODE.json"
  # PR 507: each copy's own last test too, for the Backups page and the drill.
  [ "$MODE" = test ] && cp "$STATE/restore-test.json" "$STATE/restore-test-$FROM.json"
  return 0
}

# ---- the monthly restore drill (PR 507) ---------------------------------------------------------------------------
drill() {
  local f runs=() ok=yes line r d
  [[ "$ONLY" =~ ^(all|local|blob|drive)$ ]] || { echo "--only all, local, blob or drive" >&2; exit 2; }
  for f in local blob drive; do
    [ "$ONLY" = all ] || [ "$ONLY" = "$f" ] || continue
    if [ "$ONLY" = all ]; then
      case "$f" in
        blob) [ "${BACKUP_DRILL_BLOB:-yes}" = yes ] || { runs+=("$f|off|not in the drill (settings)"); continue; } ;;
        drive) [ "${BACKUP_DRILL_DRIVE:-yes}" = yes ] || { runs+=("$f|off|not in the drill (settings)"); continue; } ;;
      esac
    fi
    case "$f" in
      blob) [ -n "${RCLONE_CONFIG_BLOB_TYPE:-}" ] || { runs+=("$f|off|not connected"); continue; } ;;
      drive) { [ -n "${RCLONE_CONFIG_DRIVE_TYPE:-}" ] && [ -s "$SEC/backup.key" ]; } || { runs+=("$f|off|not connected"); continue; } ;;
    esac
    rm -f "$STATE/restore-test.json"
    bash "$0" test --from "$f" >/dev/null 2>&1 || true
    r="$(jq -r '.result // "fail"' "$STATE/restore-test.json" 2>/dev/null || echo fail)"
    d="$(jq -r '.detail // "no result"' "$STATE/restore-test.json" 2>/dev/null || echo 'no result')"
    [ "$r" = ok ] || ok=no
    runs+=("$f|$r|$d")
  done
  line="$(for x in "${runs[@]}"; do IFS='|' read -r f r d <<<"$x"; echo "$f: $r — $d"; done | paste -sd ';' -)"
  printf '%s\n' "${runs[@]}" | jq -R 'split("|") | {from:.[0], result:.[1], detail:(.[2:] | join("|"))}' | jq -s \
    --arg result "$([ "$ok" = yes ] && echo ok || echo fail)" --arg detail "$line" --arg at "$(date -Is)" \
    '{result:$result, detail:$detail, at:$at, runs:.}' > "$STATE/restore-drill.json.tmp"
  mv "$STATE/restore-drill.json.tmp" "$STATE/restore-drill.json"
  if [ "$ok" = yes ]; then
    [ "${BACKUP_TELEGRAM_OK:-no}" = yes ] && tg "${BACKUP_DRILL_OK_TEXT:-restore drill ok}"
    echo "OK: $line"; exit 0
  fi
  echo "FAIL: $line"; exit 1
}
if [ "$MODE" = drill ]; then drill; fi

# ---- a restore asked for in the admin (PR 396) --------------------------------------------------------------------
restore_request() { # <id> <staging|production> <from> <backup|-> <at|-> <staging id|->
  local id="${1:-}" env="${2:-}" from="${3:-}" bk="${4:--}" at="${5:--}" sof="${6:--}" out rc=0 ok=false detail used
  local args=() since now
  req_done() { jq -n --arg id "$id" --argjson ok "$1" --arg detail "$2" --arg backup "${3:-}" \
    '{id:$id, ok:$ok, detail:$detail} + (if $backup == "" then {} else {backup:$backup} end)' > "$STATE/requests/$id.json"; }
  [[ "$id" =~ ^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$ ]] || { echo "request: an id" >&2; exit 2; }
  mkdir -p "$STATE/requests"
  [ "$bk" = - ] && bk=""; [ "$at" = - ] && at=""; [ "$sof" = - ] && sof=""
  if ! [[ "$env" =~ ^(staging|production)$ ]] || ! [[ "$from" =~ ^(local|blob|drive)$ ]] \
    || { [ -n "$bk" ] && ! [[ "$bk" =~ ^[0-9]{8}-[0-9]{4}$ ]]; } \
    || { [ -n "$at" ] && ! [[ "$at" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}(:[0-9]{2}(\.[0-9]{1,3})?)?Z$ ]]; } \
    || { [ -n "$sof" ] && ! [[ "$sof" =~ ^[0-9a-f-]{36}$ ]]; }; then
    req_done false "not a restore this server runs"; exit 2
  fi
  args=(--from "$from"); [ -n "$bk" ] && args+=(--backup "$bk")
  # The minute comes in UTC; the restore takes it in the server's own time zone (EXTAS_TIMEZONE).
  [ -n "$at" ] && args+=(--at "$(TZ="$EXTAS_TIMEZONE" date -d "$at" '+%Y-%m-%d %H:%M')")
  rm -f "$STATE/restore-restore.json"
  if [ "$env" = staging ]; then
    out="$(bash "$0" "${args[@]}" --target staging 2>&1)" || rc=$?
    [ "$rc" = 0 ] && jq -e '.result == "ok"' "$STATE/restore-restore.json" >/dev/null 2>&1 && ok=true
    used="$(jq -r '.backup // empty' "$STATE/restore-restore.json" 2>/dev/null || true)"
    detail="$(jq -r '.detail // empty' "$STATE/restore-restore.json" 2>/dev/null || true)"; [ -n "$detail" ] || detail="$(tail -1 <<<"$out")"
    [ -n "$used" ] || ok=false
    jq -n --arg id "$id" --argjson ok "$ok" --arg from "$from" --arg backup "$used" --arg at "$at" --arg detail "$detail" \
      --arg finishedAt "$(date -Is)" '{id:$id, ok:$ok, from:$from, backup:$backup, at:$at, detail:$detail, finishedAt:$finishedAt}' \
      > "$STATE/restore-staging.json"
    req_done "$ok" "$detail" "$used"
    [ "$ok" = true ] && exit 0 || exit 1
  fi
  # production: only after the check copy of the very same backup passed, recently
  now="$(date +%s)"
  since="$(jq -r '.finishedAt // empty' "$STATE/restore-staging.json" 2>/dev/null || true)"
  if [ -z "$sof" ] || [ -z "$bk" ] || [ -z "$since" ] \
    || ! jq -e --arg id "$sof" --arg from "$from" --arg bk "$bk" --arg at "$at" \
      '.id == $id and .ok == true and .from == $from and .backup == $bk and .at == $at' "$STATE/restore-staging.json" >/dev/null 2>&1 \
    || [ $(( now - $(date -d "$since" +%s) )) -gt $(( ${RESTORE_STAGING_VALID_H:-24} * 3600 )) ]; then
    detail="the check copy of this backup has not passed within ${RESTORE_STAGING_VALID_H:-24} hours: restore it to staging first"
    req_done false "$detail" "$bk"
    jq -n --arg detail "$detail" --arg at "$(date -Is)" --arg from "$from" --arg backup "$bk" \
      '{result:"refused", detail:$detail, at:$at, from:$from, backup:$backup}' > "$STATE/restore-production.json"
    exit 1
  fi
  out="$(bash "$0" "${args[@]}" --target production --confirm RESTORE 2>&1)" || rc=$?
  [ "$rc" = 0 ] && jq -e '.result == "ok"' "$STATE/restore-restore.json" >/dev/null 2>&1 && ok=true
  detail="$(jq -r '.detail // empty' "$STATE/restore-restore.json" 2>/dev/null || true)"; [ -n "$detail" ] || detail="$(tail -1 <<<"$out")"
  jq -n --arg result "$([ "$ok" = true ] && echo ok || echo fail)" --arg detail "$detail" --arg at "$(date -Is)" \
    --arg from "$from" --arg backup "$bk" --arg id "$id" \
    '{result:$result, detail:$detail, at:$at, from:$from, backup:$backup, request:$id}' > "$STATE/restore-production.json"
  req_done "$ok" "$detail" "$bk"
  if [ "$ok" = true ]; then tg "${RESTORE_PROD_OK_TEXT:-production restored} ($from, $bk)"; exit 0; fi
  tg "${RESTORE_PROD_FAIL_TEXT:-production restore failed}: $detail"; exit 1
}
if [ "$MODE" = request ]; then restore_request "${REQ[@]}"; fi
[ -z "$BACKUP" ] || [[ "$BACKUP" =~ ^[0-9A-Za-z_-]{1,40}$ ]] || { echo "--backup: a backup's stamp" >&2; exit 2; }

# ---- product photos (PR 8) ----------------------------------------------------------------------------------------
# media_set <dir>: the newest full photo archive in <dir> and the newest diff made on it → MEDIA_FULL, MEDIA_DIFF
# (names without .tar; the stamps sort by time).
MEDIA_FULL=""; MEDIA_DIFF=""
media_set() {
  local f s
  MEDIA_FULL=""; MEDIA_DIFF=""
  for f in "$1"/media-*-full.tar; do [ -e "$f" ] && MEDIA_FULL="$(basename "$f" .tar)"; done
  [ -n "$MEDIA_FULL" ] || return 1
  s="${MEDIA_FULL#media-}"; s="${s%-full}"
  for f in "$1"/media-*-diff-"$s".tar; do [ -e "$f" ] && MEDIA_DIFF="$(basename "$f" .tar)"; done
  return 0
}
manifest_of() { echo "media-$(cut -c7-19 <<<"$1").sha256"; }   # media-<stamp>-… → media-<stamp>.sha256

# media_sample <dir with the archives> <work dir>: every archive of the set reads to the end; one photo, picked at
# random from the newest archive that has any, is restored and its checksum compared with the one recorded at backup
# time. Sets MEDIA_DETAIL; non-zero on failure.
MEDIA_DETAIL=""
media_sample() {
  local d="$1" w="$2" a line="" src="" sum path got
  if ! media_set "$d"; then
    if [ "${BACKUP_MEDIA:-yes}" = yes ] && [ -n "$(find "$MEDIA" -type f -print -quit 2>/dev/null)" ]; then
      MEDIA_DETAIL="photos: no photo archive, although the photo folder has photos"; return 1
    fi
    MEDIA_DETAIL="photos: none on the local disk yet"; return 0
  fi
  for a in $MEDIA_FULL $MEDIA_DIFF; do
    tar -tf "$d/$a.tar" >/dev/null 2>&1 || { MEDIA_DETAIL="photos: $a.tar does not read"; return 1; }
    [ -f "$d/$(manifest_of "$a")" ] || { MEDIA_DETAIL="photos: the checksum list of $a is missing"; return 1; }
  done
  for a in $MEDIA_DIFF $MEDIA_FULL; do
    line="$(shuf -n 1 "$d/$(manifest_of "$a")" 2>/dev/null || true)"
    [ -n "$line" ] && { src="$a"; break; }
  done
  [ -n "$line" ] || { MEDIA_DETAIL="photos: the archive holds no photo yet"; return 0; }
  sum="${line%%  *}"; path="${line#*  }"
  mkdir -p "$w/media"
  tar -C "$w/media" -xf "$d/$src.tar" "$path" 2>/dev/null || { MEDIA_DETAIL="photos: ${path##*/} did not come back from $src.tar"; return 1; }
  got="$(sha256sum "$w/media/$path" | cut -d' ' -f1)"
  [ "$got" = "$sum" ] || { MEDIA_DETAIL="photos: ${path##*/} came back from $src.tar with a different checksum"; return 1; }
  MEDIA_DETAIL="photos: sample ${path##*/} restored from $src.tar, checksum matches"
}

# Every photo of the newest set into <target>: full archive, then the diff on it (which also applies the photos taken
# away since), then every checksum that can be checked. Prints how many photos were checked.
media_extract() { # media_extract <dir with the archives> <target>
  local d="$1" t="$2" a
  mkdir -p "$t"
  for a in $MEDIA_FULL $MEDIA_DIFF; do tar -C "$t" --listed-incremental=/dev/null -xf "$d/$a.tar"; done
  # newest checksum per photo: the diff's list wins over the full archive's
  { [ -n "$MEDIA_DIFF" ] && cat "$d/$(manifest_of "$MEDIA_DIFF")"; cat "$d/$(manifest_of "$MEDIA_FULL")"; } \
    | awk '{ p = substr($0, 67); if (!(p in seen)) { seen[p] = 1; print } }' > "$t.sha256"
  (cd "$t" && sha256sum --quiet --strict --ignore-missing -c "$t.sha256") || return 1
  (cd "$t" && awk '{ print substr($0, 67) }' "$t.sha256" | while IFS= read -r p; do [ -f "$p" ] && echo .; done | wc -l)
}

# ---- the docs bundle (CN-011) -------------------------------------------------------------------------------------
# docs_check <dir with the bundles> <work dir>: the newest docs-<stamp>.tar.gz unpacks, README.md, docs/BLUEPRINT.md
# and docs/MASTER-REGISTER.md are in it, and the commit in its COMMIT is the one recorded at backup time
# (docs-<stamp>.commit). Sets DOCS_DETAIL; non-zero on failure.
DOCS_DETAIL=""
docs_check() {
  local d="$1" w="$2/docs" f last="" want got
  for f in "$d"/docs-*.tar.gz; do [ -e "$f" ] && last="$(basename "$f" .tar.gz)"; done
  if [ -z "$last" ]; then
    if [ -f "$DOCS/COMMIT" ]; then DOCS_DETAIL="docs: no docs bundle, although the server has the docs"; return 1; fi
    DOCS_DETAIL="docs: none on the server yet"; return 0
  fi
  mkdir -p "$w"
  tar -C "$w" -xzf "$d/$last.tar.gz" 2>/dev/null || { DOCS_DETAIL="docs: $last.tar.gz does not unpack"; return 1; }
  for f in README.md docs/BLUEPRINT.md docs/MASTER-REGISTER.md COMMIT; do
    [ -s "$w/$f" ] || { DOCS_DETAIL="docs: $f did not come back from $last.tar.gz"; return 1; }
  done
  want="$(cat "$d/$last.commit" 2>/dev/null || true)"
  got="$(sed -n 's/^commit=//p' "$w/COMMIT")"
  if [ -z "$want" ] || [ "$got" != "$want" ]; then DOCS_DETAIL="docs: the COMMIT in $last.tar.gz does not match the backup's record"; return 1; fi
  DOCS_DETAIL="docs: $last.tar.gz back with README, blueprint and register, COMMIT ${got:0:12} matches"
}

media_restore() {
  local src="$WORK/archives" t n last s dir f
  mkdir -p "$src"
  case "$FROM" in
    local) src="$LOCAL/media" ;;
    blob)
      [ -n "${RCLONE_CONFIG_BLOB_TYPE:-}" ] || { echo "Azure Blob is not connected"; exit 1; }
      last="$(rclone lsf "blob:$BLOB_PATH/media" --include 'media-*-full.tar' | sort | tail -1)"
      [ -n "$last" ] || { echo "no photo archive in Blob"; exit 1; }
      s="${last#media-}"; s="${s%-full.tar}"
      rclone copy -q "blob:$BLOB_PATH/media" "$src" --include "media-$s*" --include "media-*-diff-$s.tar"
      for f in "$src"/media-*-diff-"$s".tar; do
        [ -e "$f" ] && rclone copy -q "blob:$BLOB_PATH/media" "$src" --include "$(manifest_of "$(basename "$f")")"
      done ;;
    drive)
      [ -n "${RCLONE_CONFIG_DRIVE_TYPE:-}" ] || { echo "Google Drive is not connected"; exit 1; }
      # The newest day that has a photo archive; a diff names the day of its full archive.
      for dir in $(rclone lsf --dirs-only "$(dpath "")" | tr -d / | sort -r); do
        last="$(rclone lsf "$(dpath "$dir")" --include 'media-*.tar.gpg' | head -1)"
        [ -n "$last" ] && break
      done
      [ -n "${last:-}" ] || { echo "no photo archive on Google Drive"; exit 1; }
      rclone copy -q "$(dpath "$dir")" "$WORK/drive" --include 'media-*'
      case "$last" in *-diff-*) s="${last##*-diff-}"; s="${s%.tar.gpg}"; rclone copy -q "$(dpath "$s")" "$WORK/drive" --include 'media-*' ;; esac
      for f in "$WORK/drive"/*.gpg; do
        gpg --batch --yes --pinentry-mode loopback --passphrase-file "$SEC/backup.key" -o "$src/$(basename "$f" .gpg)" -d "$f"
      done ;;
    *) echo "--from local, blob or drive" >&2; exit 2 ;;
  esac
  media_set "$src" || { echo "no photo archive to restore from ($FROM)"; exit 1; }
  t="$WORK/media"
  if ! n="$(media_extract "$src" "$t")"; then echo "FAIL: a restored photo has a different checksum"; exit 1; fi
  echo "OK: $n photos restored from $MEDIA_FULL${MEDIA_DIFF:+ + $MEDIA_DIFF} ($FROM), every checksum matches."
  if [ "$INTO" != live ]; then
    echo "They are in $t for checking. Nothing in the live photo folder was changed."
    exit 0
  fi
  read -r -p "Copy the photos that are missing into the live photo folder? Type RESTORE: " ok
  [ "$ok" = "RESTORE" ] || { echo "cancelled"; exit 1; }
  # Photo names carry their checksum, so a photo that is there is the same photo: only the missing ones are copied.
  rsync -a --ignore-existing --chown=1000:1000 "$t/" "$MEDIA/"
  echo "Done: missing photos copied into $MEDIA (nothing overwritten, nothing deleted). The restored set stays in $t."
}

if [ "$MODE" = media ]; then
  mkdir -p "$WORK"
  trap 'rm -rf "$WORK/archives" "$WORK/drive"' EXIT   # the restored photos stay for checking
  media_restore
  exit 0
fi

mkdir -p "$WORK/pgdata" "$WORK/wal"
chown -R 999:999 "$WORK"; chmod 700 "$WORK/pgdata"

pick_base() { # newest base backup taken before $AT (or newest overall); PR 396: exactly --backup when given
  local d best=""
  if [ -n "$BACKUP" ]; then [ -d "$1/$BACKUP" ] && echo "$BACKUP"; return 0; fi
  for d in $(ls -1 "$1" 2>/dev/null | sort); do
    if [ -z "$AT" ] || [ "$(date -d "${d:0:8} ${d:9:2}:${d:11:2}" +%s)" -le "$(date -d "$AT" +%s)" ]; then best="$d"; fi
  done
  echo "$best"
}

if [ "$FROM" = drive ]; then
  [ -n "${RCLONE_CONFIG_DRIVE_TYPE:-}" ] || { echo "Google Drive is not connected"; exit 1; }
  # The newest backup that was checked whole in Drive (PR 395), else the newest one there.
  last=""
  if [ -n "$BACKUP" ]; then
    rclone lsf --dirs-only "$(dpath "")" | tr -d / | grep -qx "$BACKUP" || { echo "no backup $BACKUP in Google Drive"; exit 1; }
    last="$BACKUP"
  else
    for dir in $(rclone lsf --dirs-only "$(dpath "")" | tr -d / | sort -r); do
      if [ -n "$(rclone lsf "$(dpath "$dir")" --include CHECKED 2>/dev/null)" ]; then last="$dir"; break; fi
    done
    [ -n "$last" ] || last="$(rclone lsf --dirs-only "$(dpath "")" | sort | tail -1 | tr -d /)"
  fi
  [ -n "$last" ] || { echo "no backup in Google Drive yet"; exit 1; }
  RESTORED="$last"
  rclone copy -q "$(dpath "$last")" "$WORK/drive"
  gpg --batch --yes --pinentry-mode loopback --passphrase-file "$SEC/backup.key" -o "$WORK/extas.dump" -d "$WORK/drive/extas-$last.dump.gpg"
  BASE=""
else
  if [ "$FROM" = blob ]; then
    [ -n "${RCLONE_CONFIG_BLOB_TYPE:-}" ] || { echo "Azure Blob is not connected"; exit 1; }
    mkdir -p "$WORK/blob-base"
    rclone lsf --dirs-only "blob:$BLOB_PATH/base" | tr -d / > "$WORK/list"
    BASE=""; while read -r d; do
      if [ -n "$BACKUP" ]; then [ "$d" = "$BACKUP" ] && BASE="$d"; continue; fi
      if [ -z "$AT" ] || [ "$(date -d "${d:0:8} ${d:9:2}:${d:11:2}" +%s)" -le "$(date -d "$AT" +%s)" ]; then BASE="$d"; fi
    done < <(sort "$WORK/list")
    [ -n "$BASE" ] || { echo "no base backup${BACKUP:+ $BACKUP} in Blob before ${AT:-now}"; exit 1; }
    rclone copy -q "blob:$BLOB_PATH/base/$BASE" "$WORK/blob-base/$BASE"
    rclone copy -q "blob:$BLOB_PATH/wal" "$WORK/wal"
    BASEDIR="$WORK/blob-base/$BASE"
  else
    if [ "$MODE" = test ]; then
      # Close the current WAL segment so the test sees everything committed up to now, then let the archiver copy it.
      pgx extas-postgres psql -qtAX -U extas -d extas -c "SELECT pg_switch_wal()" >/dev/null 2>&1 || true
      sleep 5
    fi
    BASE="$(pick_base "$LOCAL/base")"
    [ -n "$BASE" ] || { result fail "no local base backup${BACKUP:+ $BACKUP} yet"; echo "no local base backup${BACKUP:+ $BACKUP} yet"; exit 1; }
    BASEDIR="$LOCAL/base/$BASE"
    # Only the WAL archived since this base backup (it carries the WAL before that itself): copying the whole archive
    # made the restore test slow and, with a full archive, too slow to finish (31 Oct 2026).
    find "$LOCAL/wal" -maxdepth 1 -type f -newermt "@$(( $(stat -c %Y "$BASEDIR/base.tar.gz") - 600 ))" \
      -exec cp -p {} "$WORK/wal/" \; 2>/dev/null || true
  fi
  RESTORED="$BASE"
  tar -xzf "$BASEDIR/base.tar.gz" -C "$WORK/pgdata"
  # -X fetch (since 31 Oct 2026): the WAL the base backup needs is in pg_wal.tar.gz beside it.
  [ -f "$BASEDIR/pg_wal.tar.gz" ] && tar -xzf "$BASEDIR/pg_wal.tar.gz" -C "$WORK/pgdata/pg_wal"
  # The temp tablespace on the NVMe (nvme_temp, /nvme/pgtemp) comes as <oid>.tar.gz; the restored copy gets a folder of
  # its own at the same path, so its tablespace_map points somewhere real.
  mkdir -p "$WORK/tblspc"
  for f in "$BASEDIR"/[0-9]*.tar.gz; do [ -e "$f" ] && tar -xzf "$f" -C "$WORK/tblspc"; done
  chown -R 999:999 "$WORK"
  touch "$WORK/pgdata/recovery.signal"
  {
    # Archived WAL is gzip-compressed since 31 Oct 2026 (09-stack.sh); older segments are plain.
    echo "restore_command = 'test -f /restore-wal/%f.gz && gunzip -c /restore-wal/%f.gz > %p || cp /restore-wal/%f %p'"
    [ -n "$AT" ] && echo "recovery_target_time = '$AT $EXTAS_TIMEZONE'"
    echo "recovery_target_action = 'promote'"
    echo "archive_mode = off"
  } >> "$WORK/pgdata/postgresql.auto.conf"
fi

trap cleanup EXIT
# A check copy left running by an earlier staging restore makes way (PR 396): it is a throw-away copy.
docker rm -f "$NAME" >/dev/null 2>&1 || true
if [ -n "$BASE" ]; then
  docker run -d --name "$NAME" --network extas -u 999:999 \
    -e PGDATA=/var/lib/postgresql/data/pgdata \
    -v "$WORK/pgdata:/var/lib/postgresql/data/pgdata" -v "$WORK/wal:/restore-wal:ro" -v "$WORK/tblspc:/nvme/pgtemp" \
    "$IMG_POSTGRES" postgres -c shared_buffers=256MB -c temp_tablespaces='' -c archive_mode=off \
    -c logging_collector=off -c shared_preload_libraries=pg_stat_statements >/dev/null
else
  docker run -d --name "$NAME" --network extas -e POSTGRES_USER=extas -e POSTGRES_DB=extas \
    -e POSTGRES_HOST_AUTH_METHOD=trust -v "$WORK/pgdata:/var/lib/postgresql/data" "$IMG_POSTGRES" >/dev/null
fi
# The WAL replay since the base backup must finish within RESTORE_TEST_WAIT_MIN.
for _ in $(seq 1 $(( ${RESTORE_TEST_WAIT_MIN:-30} * 30 ))); do
  if pgx "$NAME" psql -qtAX -U extas -d extas -c "SELECT NOT pg_is_in_recovery()" 2>/dev/null | grep -q t; then break; fi
  sleep 2
done
if [ -z "$BASE" ]; then
  docker cp "$WORK/extas.dump" "$NAME:/tmp/extas.dump"
  # PR 139: the dump grants rights to the app's own role, which lives outside the database; make it first (no login;
  # server setup and the deploy give it one) so every grant and the append-only guards come back as they were.
  pgx "$NAME" psql -qX -v ON_ERROR_STOP=1 -U extas -d extas \
    -c "DO \$\$ BEGIN IF NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname = 'extas_app') THEN CREATE ROLE extas_app NOLOGIN; END IF; END \$\$" >/dev/null
  pgx "$NAME" pg_restore -U extas -d extas --no-owner /tmp/extas.dump
fi

tables="$(pgx "$NAME" psql -qtAX -U extas -d extas -c "SELECT count(*) FROM information_schema.tables WHERE table_schema NOT IN ('pg_catalog','information_schema')" 2>/dev/null || echo x)"
live="$(pgx extas-postgres psql -qtAX -U extas -d extas -c "SELECT count(*) FROM information_schema.tables WHERE table_schema NOT IN ('pg_catalog','information_schema')" 2>/dev/null || echo x)"
if [ "$tables" = x ]; then
  result fail "restored database did not come up within ${RESTORE_TEST_WAIT_MIN:-30} min (base ${BASE:-drive dump})"
  echo "FAIL: restored database did not come up"; docker logs --tail 20 "$NAME" 2>&1 | sed 's/^/  postgres: /' >&2 || true
  exit 1
fi
detail="base ${BASE:-drive dump}, $tables tables restored (live has $live)"

if [ "$MODE" = test ]; then
  ok=yes
  [ "$tables" = "$live" ] || ok=no
  # The product photos: one sample back from the newest photo archives, checksum compared (PR 8).
  media_sample "$LOCAL/media" "$WORK" || ok=no
  # The docs bundle: back, complete, and its COMMIT matches (CN-011).
  docs_check "$LOCAL/docs" "$WORK" || ok=no
  detail="$detail; $MEDIA_DETAIL; $DOCS_DETAIL"
  if [ "$ok" = yes ]; then result ok "$detail"; echo "OK: $detail"; else result fail "$detail"; echo "FAIL: $detail"; exit 1; fi
  exit 0
fi

if [ "$TARGET" = staging ]; then
  trap - EXIT
  result ok "$detail — running as $NAME for checking"
  echo "OK: $detail. The restored copy runs as container $NAME (network extas). Remove it with: docker rm -f $NAME"
  exit 0
fi

# production
echo "This replaces the LIVE database with: $detail."
if [ "$CONFIRM" = RESTORE ]; then ok=RESTORE; else read -r -p "Type RESTORE to continue: " ok; fi
[ "$ok" = "RESTORE" ] || { echo "cancelled"; exit 1; }
# R1 ops review (M9): the restored copy goes onto the same volume as the live data folder (which stays beside it), so
# it must fit before anything stops; a half-done swap used to leave the shop down with the live data folder renamed.
if [ -n "$BASE" ]; then
  need_kb="$(du -sk "$WORK/pgdata" 2>/dev/null | cut -f1)"
  free_kb="$(df -Pk "$R/data/postgres" 2>/dev/null | awk 'NR==2{print $4}')"
  if [ -n "$need_kb" ] && [ -n "$free_kb" ] && [ "$free_kb" -lt $(( need_kb + need_kb / 20 )) ]; then
    result fail "not enough room on the database disk for the restored copy (needs $(( need_kb / 1024 )) MB, $(( free_kb / 1024 )) MB free); the live database was not touched"
    echo "FAIL: not enough room on the database disk for the restored copy; nothing was changed" >&2
    exit 1
  fi
fi
# The shop's own containers stop for the swap and start again after it (PR 396), PgBouncer with them.
mapfile -t stopped < <(docker ps --format '{{.Names}}' | grep -E '^extas-(app|worker|jobs|pgbouncer)' || true)
# R1 ops review (M9): if any step of the swap fails, the live data folder goes back, the database and the shop's
# containers start again, and the result says so (the half-copied folder is set aside, never deleted).
why="stopped half way"
swap_undo() {
  local rc=$?
  [ "$rc" -ne 0 ] || return 0
  # R2 ops review (M4): a second signal (the runner sends INT, then TERM) never cuts the undo itself short.
  trap '' INT TERM HUP
  echo "FAIL: the restore $why (exit $rc); putting the live database back" >&2
  if [ -n "$BASE" ] && [ -d "$R/data/postgres/pgdata.before-restore-$TS" ]; then
    docker stop -t 60 extas-postgres >/dev/null 2>&1 || true
    [ ! -e "$R/data/postgres/pgdata" ] || mv "$R/data/postgres/pgdata" "$R/data/postgres/pgdata.failed-restore-$TS"
    mv "$R/data/postgres/pgdata.before-restore-$TS" "$R/data/postgres/pgdata"
  elif [ -z "$BASE" ] && [ -n "${old:-}" ] \
    && pgx extas-postgres psql -qtAX -U extas -d postgres -c "SELECT 1 FROM pg_database WHERE datname = '$old'" 2>/dev/null | grep -q 1; then
    # R2 ops review (M3): a Drive dump already swapped in by name goes back the same way; the restored copy is kept
    # beside it as extas_failed_restore_<time>, never dropped.
    pgx extas-postgres psql -qX -v ON_ERROR_STOP=1 -U extas -d postgres -c \
      "SELECT pg_terminate_backend(pid) FROM pg_stat_activity WHERE datname = 'extas' AND pid <> pg_backend_pid(); ALTER DATABASE extas RENAME TO extas_failed_restore_${TS//-/_}; ALTER DATABASE $old RENAME TO extas;" >/dev/null 2>&1 \
      || echo "FAIL: could not rename $old back to extas" >&2
  fi
  docker start extas-postgres >/dev/null 2>&1 || true
  for c in "${stopped[@]}"; do docker start "$c" >/dev/null 2>&1 || true; done
  result fail "production restore $why (exit $rc); the live database was put back and the shop started again"
  cleanup
  return "$rc"
}
trap swap_undo EXIT
# R2 ops review (M4): a cancelled or timed-out run (the runner's INT then TERM, systemd's TERM at a reboot) used to skip
# the undo: the EXIT trap ran with $? = 0 on TERM and not at all on INT. Each signal now exits non-zero, so the EXIT trap
# undoes the swap.
trap 'why="was cancelled (INT)"; exit 130' INT
trap 'why="was stopped (TERM)"; exit 143' TERM
trap 'why="was stopped (HUP)"; exit 129' HUP
if [ -n "$BASE" ]; then
  docker stop "$NAME" >/dev/null
  for c in "${stopped[@]}"; do docker stop "$c" >/dev/null; done
  docker stop -t 60 extas-postgres >/dev/null
  mv "$R/data/postgres/pgdata" "$R/data/postgres/pgdata.before-restore-$TS"
  rsync -a "$WORK/pgdata/" "$R/data/postgres/pgdata/"
  sed -i '/^restore_command\|^recovery_target\|^archive_mode = off/d' "$R/data/postgres/pgdata/postgresql.auto.conf"
  docker start extas-postgres >/dev/null
  kept="the previous data folder is kept at $R/data/postgres/pgdata.before-restore-$TS"
else
  # A Drive dump: into the live server under a new name (its roles, passwords and access rules stay as they are),
  # then the names are swapped in one step; the old database stays beside it.
  new="extas_restore_${TS//-/_}"; old="extas_before_restore_${TS//-/_}"
  pgx extas-postgres psql -qX -v ON_ERROR_STOP=1 -U extas -d postgres -c "CREATE DATABASE $new" >/dev/null
  docker cp "$WORK/extas.dump" "extas-postgres:/tmp/$new.dump"
  pgx extas-postgres pg_restore -U extas -d "$new" --no-owner "/tmp/$new.dump"
  for c in "${stopped[@]}"; do docker stop "$c" >/dev/null; done
  pgx extas-postgres psql -qX -v ON_ERROR_STOP=1 -U extas -d postgres -c \
    "SELECT pg_terminate_backend(pid) FROM pg_stat_activity WHERE datname = 'extas' AND pid <> pg_backend_pid(); ALTER DATABASE extas RENAME TO $old; ALTER DATABASE $new RENAME TO extas;" >/dev/null
  docker exec extas-postgres rm -f "/tmp/$new.dump" >/dev/null 2>&1 || true
  kept="the previous database is kept as $old"
fi
for _ in $(seq 1 $(( ${RESTORE_TEST_WAIT_MIN:-30} * 30 ))); do
  pgx extas-postgres psql -qtAX -U extas -d extas -c "SELECT 1" >/dev/null 2>&1 && break
  sleep 2
done
# R2 ops review (M3): the live app is the newest deployed version; a backup from before its migrations would answer
# every query on a changed table with an error (P2022) until the next deploy. The restored database is migrated
# forward first with the live version's own migrate image, exactly as infra/deploy/deploy.sh migrate_db runs it (only
# DATABASE_DIRECT_URL, as DATABASE_URL too, through a root-only file; migrations only add, so forward is safe). A
# failed migration puts the live database back (swap_undo). No migrate image (no app deployed yet): nothing to match.
mig="$(jq -r '.migrate // empty' "$STATE/last-good-deploy.json" 2>/dev/null || true)"
if [ -n "$mig" ] && ! docker image inspect "$mig" >/dev/null 2>&1; then
  mig="$(docker images --format '{{.Repository}}:{{.Tag}}' extas-migrate 2>/dev/null | head -n 1 || true)"
fi
migrated="not migrated (no app deployed yet)"
if [ -n "$mig" ]; then
  why="could not bring the restored database to the live version's schema"
  envf="$(mktemp "$SEC/.restore-migrate.XXXXXX")"; chmod 600 "$envf"
  grep -E '^DATABASE_DIRECT_URL=' "$SEC/app.env" > "$envf" 2>/dev/null || true
  sed -n 's/^DATABASE_DIRECT_URL=/DATABASE_URL=/p' "$SEC/app.env" >> "$envf" 2>/dev/null || true
  grep -q '^DATABASE_DIRECT_URL=' "$envf" || { rm -f "$envf"; echo "FAIL: DATABASE_DIRECT_URL is not in app.env" >&2; exit 1; }
  echo "Bringing the restored database to the live version's schema ($mig)"
  mrc=0; docker run --rm --name "extas-restore-migrate-$$" --network extas --env-file "$envf" "$mig" || mrc=$?
  rm -f "$envf"
  [ "$mrc" -eq 0 ] || exit 1
  why="stopped half way"
  migrated="migrated to the live version's schema"
fi
trap cleanup EXIT
for c in "${stopped[@]}"; do docker start "$c" >/dev/null 2>&1 || true; done
echo "Done. $kept; $migrated; the shop's containers started again (${#stopped[@]})."
result ok "production restored: $detail; $migrated; $kept"

#!/usr/bin/env bash
# PR 8 — backups (A2.9.12). Run by systemd timers:
#   extas-backup daily   — base backup (for point-in-time restore) + logical dump + config + the product photos on
#                          the local disk + a dated bundle of the repository's docs, staged on NVMe, kept on the data
#                          disk, uploaded to Azure Blob and (encrypted) to Google Drive
#   extas-backup wal     — push archived WAL segments to Blob (every minute)
#   extas-backup prune   — retention from the admin's backup settings (PR 507), server.conf until they arrive
#   extas-backup schedule — the nightly time and the monthly restore drill from those settings onto the timers (PR 507)
#   extas-backup request <id> BACKUP|RESTORE_DRILL [all|local|blob|drive]
#                        — a backup or a drill asked for in the admin (PR 507), started by extas-vault-sync; writes
#                          state/requests/<id>.json for the vault sync to hand back
# The backup disk must never fill up (31 Oct 2026: /srv/extas/backups reached 100% and every daily backup failed):
#   - archived WAL is gzip-compressed by PostgreSQL's archive_command (09-stack.sh) and kept here only for
#     BACKUP_KEEP_LOCAL_WAL_DAYS; each base backup carries the WAL it needs itself (-X stream), so an older base backup
#     still restores without the archive;
#   - before each daily backup the disk is pruned until BACKUP_MIN_FREE_PCT is free (oldest first; the newest base
#     backup always stays), and retention runs again after it;
#   - a failed day leaves nothing half-written behind (it is staged on NVMe and moved in by one rename).
#   extas-backup lock-check — PR 385: proves the Blob copies are immutable (a delete from this server is refused);
#                          also run by every daily backup once BACKUP_IMMUTABLE=yes
# Blob and Drive are "not connected" until the owner enters their keys in the admin vault (PR 493); the backup then
# still runs locally and the status says so. Nothing here ever prints a secret.
set -euo pipefail
CONF="${EXTAS_CONFIG_FILE:-/etc/extas/server.conf}"
# shellcheck source=../../config/server.conf
. "$CONF"
R="$EXTAS_ROOT"
SEC="$R/config/secrets"
STATE="$R/state"
LOCAL="$R/backups"
STAGE="$EXTAS_NVME_MOUNT/backup-staging"
NOW="${EXTAS_BACKUP_STAMP:-$(date +%Y%m%d-%H%M)}"
# Product photos on the local disk: the PR 18 storage adapter's local-disk mode. app.yml mounts this folder into the
# app as /media (EXTAS_MEDIA_DIR=/media in app-connections.env, written by 09-stack.sh). Media normally lives on
# Azure Blob; until the owner connects it, the photos are only here.
MEDIA="$R/data/media"
# The repository's docs as the server has them: the copy deploy.yml makes on every deploy (PR 594, CN-011).
DOCS="$R/docs/current"
mkdir -p "$LOCAL/base" "$LOCAL/dump" "$LOCAL/config" "$LOCAL/media" "$LOCAL/docs" "$STATE"

# PR 507: the backup settings of Settings → System → Backups (the vault sync writes them); they win over server.conf.
# Only the known names, each checked, so a broken file can never set anything else.
load_backup_settings() {
  local f="$SEC/backup-settings.env" k v
  [ -f "$f" ] || return 0
  while IFS='=' read -r k v; do
    v="${v#\'}"; v="${v%\'}"
    case "$k" in
      BACKUP_TIME|BACKUP_DRILL_TIME) [[ "$v" =~ ^([01][0-9]|2[0-3]):[0-5][0-9]$ ]] || continue ;;
      BACKUP_KEEP_LOCAL_DAYS|BACKUP_KEEP_BLOB_DAYS|BACKUP_KEEP_DRIVE_DAYS|BACKUP_KEEP_LOCAL_WAL_DAYS|BACKUP_MIN_FREE_PCT|BACKUP_DRILL_DAY)
        [[ "$v" =~ ^[0-9]{1,4}$ ]] || continue ;;
      BACKUP_DRILL_ON|BACKUP_DRILL_BLOB|BACKUP_DRILL_DRIVE|BACKUP_TELEGRAM_FAIL|BACKUP_TELEGRAM_OK) [[ "$v" =~ ^(yes|no)$ ]] || continue ;;
      *) continue ;;
    esac
    printf -v "$k" '%s' "$v"
  done < "$f"
}
load_backup_settings
# A Telegram line to the owner (telegram.env from the vault sync, PR 392); without the bot it goes to the log only.
tg() {
  echo "$(date -Is) $1" >> "$R/logs/alerts.log" 2>/dev/null || true
  [ -f "$SEC/telegram.env" ] || return 0
  # shellcheck disable=SC1091
  ( . "$SEC/telegram.env"
    [ -n "${TELEGRAM_BOT_TOKEN:-}" ] && [ -n "${TELEGRAM_CHAT_ID:-}" ] || exit 0
    curl -fsS -m 10 "${TELEGRAM_API_BASE:-https://api.telegram.org}/bot${TELEGRAM_BOT_TOKEN}/sendMessage" \
      --data-urlencode "chat_id=${TELEGRAM_CHAT_ID}" --data-urlencode "text=$1" >/dev/null 2>&1 ) || true
}

# Remotes come from env written by the app's vault sync (PR 493/507): RCLONE_CONFIG_BLOB_* / RCLONE_CONFIG_DRIVE_*.
[ -f "$SEC/backup.env" ] && set -a && . "$SEC/backup.env" && set +a
blob_on()  { [ -n "${RCLONE_CONFIG_BLOB_TYPE:-}" ]; }
drive_on() { [ -n "${RCLONE_CONFIG_DRIVE_TYPE:-}" ]; }
# PR 385 (B6.1): immutable backups. With BACKUP_IMMUTABLE=yes the Blob container is locked by its own immutability
# policy and the server's Blob key may add and read but not delete, so an attacker who takes this server cannot wipe
# the off-server copies. The server then never deletes or overwrites in Blob (Azure's lifecycle rule removes copies
# after BACKUP_KEEP_BLOB_DAYS) and checks every day that a delete is refused (lock_check).
imm_on() { [ "${BACKUP_IMMUTABLE:-no}" = yes ]; }
IMM=(); if imm_on; then IMM=(--immutable); fi
BLOB_PATH="${BACKUP_BLOB_CONTAINER:-extas-backups}"
# PR 395 (CN-030): with the one-click Google sign-in the remote's root is the shop's own backup folder
# (RCLONE_CONFIG_DRIVE_ROOT_FOLDER_ID, from the vault sync) and BACKUP_DRIVE_FOLDER is empty: the dated folders go
# straight into "Extas E-commerce Backups". Unset, it keeps the old sub-folder.
DRIVE_PATH="${BACKUP_DRIVE_FOLDER-EXTAS-backups}"
dpath() { echo "drive:${DRIVE_PATH:+$DRIVE_PATH/}$1"; }   # dpath <stamp>[/<file>] → the remote path

# The Drive copy is encrypted with a key generated on this server. The owner keeps a copy of it in the vault.
key_file() {
  if [ ! -s "$SEC/backup.key" ]; then head -c 48 /dev/urandom | base64 > "$SEC/backup.key"; chmod 600 "$SEC/backup.key"; fi
  echo "$SEC/backup.key"
}
encrypt() { # encrypt <in> <out>: the Drive copy, with the same key for every file
  gpg --batch --yes --pinentry-mode loopback --passphrase-file "$(key_file)" --symmetric --cipher-algo AES256 -o "$2" "$1"
}

# The PostgreSQL tools inside the container (31 Oct 2026, GitHub #65): /usr/bin/pg_dump, psql and pg_basebackup there
# are Debian's pg_wrapper, which fails ("You must install at least one postgresql-client-<version> package") since the
# containerd move; the server's own tools are in /usr/lib/postgresql/<n>/bin, put first on PATH. Same as
# infra/deploy/pg-exec.sh `pg_exec`, for any container (the restore test's own one too).
PG_PATH='PATH="$(ls -d /usr/lib/postgresql/*/bin 2>/dev/null | sort -V | tail -1):$PATH"'
pgx() { # pgx [-i] [-u user] <container> <tool> <args…>
  local o=()
  while [ "${1:-}" = -i ] || [ "${1:-}" = -u ]; do
    if [ "$1" = -u ]; then o+=(-u "$2"); shift 2; else o+=(-i); shift; fi
  done
  local c="$1"; shift
  docker exec "${o[@]}" "$c" bash -c "$PG_PATH"'; exec "$@"' pgx "$@"
}

status() { # status <kind> <target> <ok|fail|off> <detail>
  local f="$STATE/backup-$1-$2.json"
  printf '{"kind":"%s","target":"%s","result":"%s","detail":"%s","at":"%s"}\n' "$1" "$2" "$3" "$4" "$(date -Is)" > "$f"
}

# ---- product photos (PR 8: "database, uploads and configuration") ------------------------------------------------
# One tar a day, without compression (the photos are AVIF/WebP/JPEG already), staged on NVMe like the database:
#   media-<stamp>-full.tar          every photo: at least every BACKUP_MEDIA_FULL_EVERY_DAYS days, and never less often
#                                   than the shortest BACKUP_KEEP_* (so the newest full archive is never pruned)
#   media-<stamp>-diff-<full>.tar   only what changed since that full archive (GNU tar listed-incremental, level 1)
#   media-<stamp>.sha256            the checksum of every photo in that day's archive, read back from the archive
# A restore takes the newest full archive and the newest diff on it (extas-restore media). The full archive's snapshot
# file (.snar) stays on the data disk only: it is what the next diff is measured against.
stamp_s() { date -d "${1:0:8} ${1:9:2}:${1:11:2}" +%s; }
media_full_days() {
  local d="$BACKUP_MEDIA_FULL_EVERY_DAYS" k
  for k in "$BACKUP_KEEP_LOCAL_DAYS" "$BACKUP_KEEP_BLOB_DAYS" "$BACKUP_KEEP_DRIVE_DAYS"; do [ "$k" -lt "$d" ] && d="$k"; done
  [ "$d" -ge 1 ] || d=1
  echo "$d"
}
newest_full() { # the stamp of the newest full photo archive on the data disk that has its snapshot file
  local f s best=""
  for f in "$LOCAL/media"/media-*-full.tar; do
    [ -e "$f" ] || continue
    s="${f##*/media-}"; s="${s%-full.tar}"
    [ -f "$LOCAL/media/media-$s-full.snar" ] && best="$s"
  done
  echo "$best"
}

# media_backup <work dir>: the day's photo archive onto the data disk. Sets MEDIA_NAME (empty when the photos are
# switched off or there is no photo folder) and MEDIA_NOTE; returns non-zero when it failed.
MEDIA_NAME=""; MEDIA_NOTE=""
media_backup() {
  local work="$1" full name rc=0 n
  if [ "${BACKUP_MEDIA:-yes}" != yes ]; then MEDIA_NOTE="photos switched off (BACKUP_MEDIA)"; return 0; fi
  if [ ! -d "$MEDIA" ]; then MEDIA_NOTE="no local photo folder"; return 0; fi
  full="$(newest_full)"
  if [ -n "$full" ] && [ $(( $(date +%s) - $(stamp_s "$full") )) -lt $(( $(media_full_days) * 86400 - 3600 )) ]; then
    name="media-$NOW-diff-$full"
    cp "$LOCAL/media/media-$full-full.snar" "$work/$name.snar"
  else
    full=""; name="media-$NOW-full"
  fi
  # tar: 0 = done, 1 = a photo changed while it was read (an upload at that moment) — the archive is still good
  tar -C "$MEDIA" --listed-incremental="$work/$name.snar" --no-check-device -cf "$work/$name.tar" . || rc=$?
  if [ "$rc" -gt 1 ]; then MEDIA_NOTE="photo archive failed"; return 1; fi
  # The checksums come from the archive, not from the folder: they are exactly what a restore must give back.
  # shellcheck disable=SC2016  # $TAR_FILENAME is expanded by the shell tar starts, once per photo
  tar -xf "$work/$name.tar" --to-command='printf "%s  %s\n" "$(sha256sum | cut -d" " -f1)" "$TAR_FILENAME"' \
    > "$work/media-$NOW.sha256" || { MEDIA_NOTE="photo archive did not read back"; return 1; }
  mv "$work/$name.tar" "$LOCAL/media/$name.tar"
  mv "$work/media-$NOW.sha256" "$LOCAL/media/media-$NOW.sha256"
  if [ -z "$full" ]; then mv "$work/$name.snar" "$LOCAL/media/$name.snar"; else rm -f "$work/$name.snar"; fi
  chmod 600 "$LOCAL/media/$name.tar" "$LOCAL/media/media-$NOW.sha256"
  n="$(wc -l < "$LOCAL/media/media-$NOW.sha256")"
  if [ -z "$full" ]; then MEDIA_NOTE="photos: all $n in a full archive"; else MEDIA_NOTE="photos: $n new or changed since the full archive of $full"; fi
  MEDIA_NAME="$name"
}

# ---- the docs bundle (CN-011, scope update on PR 8) -----------------------------------------------------------------
# docs_backup <work dir>: docs-<stamp>.tar.gz — README.md, docs/BLUEPRINT.md, docs/MASTER-REGISTER.md and all of
# docs/, with the COMMIT file of the copy — and docs-<stamp>.commit, the commit hash recorded at backup time (the
# restore test compares the two). Taken from the server's copy, not from Git, so it is what the admin showed that day.
# Sets DOCS_NAME (empty when no deploy has copied the docs yet) and DOCS_NOTE; non-zero when it failed.
DOCS_NAME=""; DOCS_NOTE=""
docs_backup() {
  local work="$1" sha f
  if [ ! -f "$DOCS/COMMIT" ]; then DOCS_NOTE="docs: none on the server yet (the first deploy copies them)"; return 0; fi
  sha="$(sed -n 's/^commit=//p' "$DOCS/COMMIT")"
  [ -n "$sha" ] || { DOCS_NOTE="docs: the server's copy has no commit in COMMIT"; return 1; }
  for f in README.md docs/BLUEPRINT.md docs/MASTER-REGISTER.md; do
    [ -f "$DOCS/$f" ] || { DOCS_NOTE="docs: $f is missing from the server's copy"; return 1; }
  done
  tar -C "$DOCS/" -czf "$work/docs-$NOW.tar.gz" . || { DOCS_NOTE="docs bundle failed"; return 1; }
  echo "$sha" > "$work/docs-$NOW.commit"
  mv "$work/docs-$NOW.tar.gz" "$work/docs-$NOW.commit" "$LOCAL/docs/"
  chmod 600 "$LOCAL/docs/docs-$NOW.tar.gz" "$LOCAL/docs/docs-$NOW.commit"
  DOCS_NAME="docs-$NOW"; DOCS_NOTE="docs of ${sha:0:12}"
}

# free_pct: how much of the backup disk is free, in whole per cent.
free_pct() { df -P "$LOCAL" | awk 'NR==2 { gsub("%", "", $5); print 100 - $5 }'; }

# lock_check: a small marker goes to lock-check/ in Blob and is then deleted with the server's own key. The delete must
# be refused and the marker still be there; when the delete works, anyone holding this server could wipe the backups,
# so the check fails and the monitor alerts. Off (and saying why) until Blob is connected and BACKUP_IMMUTABLE=yes.
lock_check() {
  local m
  if ! blob_on; then status lock blob off "not connected — add the key in Keys & connections"; return 0; fi
  if ! imm_on; then status lock blob off "the Blob copies are not locked yet (BACKUP_IMMUTABLE)"; return 0; fi
  mkdir -p "$STAGE"; m="$STAGE/lock-check-$NOW"
  printf 'EXTAS lock check %s\n' "$NOW" > "$m"
  if ! rclone copy -q "${IMM[@]}" "$m" "blob:$BLOB_PATH/lock-check/"; then rm -f "$m"; status lock blob fail "the check marker did not upload"; return 1; fi
  rm -f "$m"
  if rclone deletefile -q "blob:$BLOB_PATH/lock-check/lock-check-$NOW" 2>/dev/null; then
    status lock blob fail "a delete was NOT refused: the Blob copies can be deleted from this server"; return 1
  fi
  if [ -z "$(rclone lsf "blob:$BLOB_PATH/lock-check" --include "lock-check-$NOW" 2>/dev/null)" ]; then
    status lock blob fail "the check marker is gone although its delete was refused"; return 1
  fi
  status lock blob ok "a delete from this server was refused ($NOW)"
}

# make_room: prune by the retention settings, then — while less than BACKUP_MIN_FREE_PCT is free — the oldest archived
# WAL (older than an hour) and then the oldest base backup (never the newest), until there is room or nothing more may
# go. Sets ROOM_NOTE.
ROOM_NOTE=""
make_room() {
  local before f n
  before="$(free_pct)"
  [ "$before" -ge "$BACKUP_MIN_FREE_PCT" ] && return 0
  prune_files
  while [ "$(free_pct)" -lt "$BACKUP_MIN_FREE_PCT" ]; do
    f="$(find "$LOCAL/wal" -type f -mmin +60 -printf '%T@ %p\n' 2>/dev/null | sort -n | head -1 | cut -d' ' -f2-)"
    if [ -n "$f" ]; then rm -f "$f"; continue; fi
    n="$(find "$LOCAL/base" -mindepth 1 -maxdepth 1 -type d ! -name '.*' | wc -l)"
    [ "$n" -gt 1 ] || break
    rm -rf "$(find "$LOCAL/base" -mindepth 1 -maxdepth 1 -type d ! -name '.*' | sort | head -1)"
  done
  ROOM_NOTE="backup disk was ${before}% free, made room to $(free_pct)%; "
}

# fail_day <message>: the day's status, its work folder and anything half-moved removed, exit 1.
fail_day() {
  status daily local fail "$ROOM_NOTE$1"
  rm -rf "${STAGE:?}/$NOW" "${LOCAL:?}/base/.$NOW.part"
  exit 1
}

daily() {
  # R1 ops review (minor 3): one daily backup at a time. The timer, "Back up now" (extas-vault-sync) and server setup
  # can meet; in the same minute they shared $STAGE/$NOW and the second one's `rm -rf` wiped the first one's work. A
  # second run waits for the first (at most BACKUP_LOCK_WAIT_MIN), then takes its own stamp.
  exec 7>"$STATE/backup.lock"
  if ! flock -w $(( ${BACKUP_LOCK_WAIT_MIN:-120} * 60 )) 7; then
    status daily local fail "another backup was still running after ${BACKUP_LOCK_WAIT_MIN:-120} minutes; this one did not start"
    exit 1
  fi
  if [ -z "${EXTAS_BACKUP_STAMP:-}" ]; then
    NOW="$(date +%Y%m%d-%H%M)"
    while [ -e "$LOCAL/base/$NOW" ]; do sleep 5; NOW="$(date +%Y%m%d-%H%M)"; done
  fi
  local work="$STAGE/$NOW" rc=0 step=""
  make_room
  rm -rf "$work"; mkdir -p "$work"; chown 999:999 "$work"
  # 1. Physical base backup (tar, compressed) — the starting point for WAL replay to any minute. -X stream puts the
  #    WAL this backup needs into it (pg_wal.tar.gz), so it restores on its own, even after the archive is pruned.
  docker exec -u postgres extas-postgres bash -c "$PG_PATH; rm -rf /nvme/pgtemp/.bb-$NOW && mkdir -p /nvme/pgtemp/.bb-$NOW && \
    pg_basebackup -U extas -D /nvme/pgtemp/.bb-$NOW -Ft -z -X stream -c fast" \
    && mv "$EXTAS_NVME_MOUNT/pgtemp/.bb-$NOW" "$work/base" || { rc=1; step="base backup (pg_basebackup)"; }
  # 2. Logical dump — portable, restorable on any PostgreSQL 17+.
  pgx extas-postgres pg_dump -U extas -d extas -Fc -Z 6 > "$work/extas.dump" || { rc=1; step="${step:-database dump (pg_dump)}"; }
  # 3. Config (secrets included, so the Drive copy is encrypted; the local copy stays on the 700 config disk).
  tar -C "$R" -czf "$work/config.tgz" config || { rc=1; step="${step:-config archive}"; }
  if [ $rc -ne 0 ]; then fail_day "backup step failed: $step"; fi

  # Onto the data disk: the base backup under a hidden name first, then one rename, so a full disk never leaves a
  # half-copied base backup that a restore would pick.
  mkdir -p "$LOCAL/base/.$NOW.part"
  mv "$work/base"/* "$LOCAL/base/.$NOW.part"/ 2>/dev/null || fail_day "the base backup did not fit on the backup disk ($(free_pct)% free)"
  mv "$LOCAL/base/.$NOW.part" "$LOCAL/base/$NOW"
  mv "$work/extas.dump" "$LOCAL/dump/extas-$NOW.dump" 2>/dev/null || fail_day "the dump did not fit on the backup disk ($(free_pct)% free)"
  mv "$work/config.tgz" "$LOCAL/config/config-$NOW.tgz" 2>/dev/null || fail_day "the config archive did not fit on the backup disk"
  chmod 600 "$LOCAL/config/config-$NOW.tgz"
  # 4. The product photos on the local disk. If they fail, the day's backup fails (the database part above is kept).
  if ! media_backup "$work"; then fail_day "database backed up, but the $MEDIA_NOTE"; fi
  # 5. The docs bundle (CN-011). The same: a failed bundle fails the day's backup.
  if ! docs_backup "$work"; then fail_day "database and photos backed up, but $DOCS_NOTE"; fi
  status daily local ok "$ROOM_NOTE$(du -sh "$LOCAL/base/$NOW" | cut -f1) base + dump; $MEDIA_NOTE; $DOCS_NOTE; $(free_pct)% of the backup disk free"

  if blob_on; then
    if rclone copy -q "${IMM[@]}" "$LOCAL/base/$NOW" "blob:$BLOB_PATH/base/$NOW" && rclone copy -q "${IMM[@]}" "$LOCAL/dump/extas-$NOW.dump" "blob:$BLOB_PATH/dump/" \
      && { [ -z "$MEDIA_NAME" ] || { rclone copy -q "${IMM[@]}" "$LOCAL/media/$MEDIA_NAME.tar" "blob:$BLOB_PATH/media/" \
        && rclone copy -q "${IMM[@]}" "$LOCAL/media/media-$NOW.sha256" "blob:$BLOB_PATH/media/"; }; } \
      && { [ -z "$DOCS_NAME" ] || { rclone copy -q "${IMM[@]}" "$LOCAL/docs/$DOCS_NAME.tar.gz" "blob:$BLOB_PATH/docs/" \
        && rclone copy -q "${IMM[@]}" "$LOCAL/docs/$DOCS_NAME.commit" "blob:$BLOB_PATH/docs/"; }; }; then
      status daily blob ok "$NOW"
      # PR 385: the lock is proved with every backup once it is switched on
      lock_check || rc=1
    else status daily blob fail "upload failed"; rc=1; fi
  else status daily blob off "not connected — add the key in Keys & connections"; fi

  if drive_on; then
    # R1 ops review (minor 2): a failed encryption (the NVMe full, say) used to end the script under `set -e` with no
    # Drive status, so yesterday's "ok" stayed, and the work folder and the retention were left. Now it is a Drive fail.
    if ! { encrypt "$LOCAL/dump/extas-$NOW.dump" "$work/extas-$NOW.dump.gpg" \
        && encrypt "$LOCAL/config/config-$NOW.tgz" "$work/config-$NOW.tgz.gpg" \
        && { [ -z "$MEDIA_NAME" ] || { encrypt "$LOCAL/media/$MEDIA_NAME.tar" "$work/$MEDIA_NAME.tar.gpg" \
          && encrypt "$LOCAL/media/media-$NOW.sha256" "$work/media-$NOW.sha256.gpg"; }; } \
        && { [ -z "$DOCS_NAME" ] || { encrypt "$LOCAL/docs/$DOCS_NAME.tar.gz" "$work/$DOCS_NAME.tar.gz.gpg" \
          && encrypt "$LOCAL/docs/$DOCS_NAME.commit" "$work/$DOCS_NAME.commit.gpg"; }; }; }; then
      status daily drive fail "encrypting the Drive copy failed ($(free_pct)% of the backup disk free)"; rc=1
    # The photos and the docs go with the same key, into the same dated folder as the database. Uploaded, then every
    # file checked against Drive's own checksum; only then the CHECKED marker, so retention (prune) counts only
    # backups that are whole in Drive (CN-030: Drive keeps the newest BACKUP_DRIVE_KEEP checked).
    elif ! rclone copy -q "$work" "$(dpath "$NOW")" --include '*.gpg'; then status daily drive fail "upload failed"; rc=1
    elif ! rclone check -q --one-way "$work" "$(dpath "$NOW")" --include '*.gpg'; then status daily drive fail "uploaded, but the check against Drive failed"; rc=1
    elif ! rclone touch -q "$(dpath "$NOW/CHECKED")"; then status daily drive fail "uploaded and checked, but the CHECKED mark could not be written"; rc=1
    else status daily drive ok "$NOW, every file checked in Drive"; fi
  else status daily drive off "not connected — add the key in Keys & connections"; fi
  rm -rf "$work"
  prune_files
  # PR 507: a good night on Telegram only when the owner asked for it (a failure always comes from extas-monitor).
  if [ $rc -eq 0 ] && [ "${BACKUP_TELEGRAM_OK:-no}" = yes ]; then tg "${BACKUP_TELEGRAM_OK_TEXT:-backup ok}"; fi
  exit $rc
}

wal() {
  blob_on || { status wal blob off "not connected"; exit 0; }
  # Upload each archived segment once; the local copy stays until prune (local point-in-time restore too).
  if rclone copy -q --ignore-existing "${IMM[@]}" "$LOCAL/wal" "blob:$BLOB_PATH/wal/" --min-age 5s 2>/dev/null; then
    status wal blob ok "pushed"
  else status wal blob fail "push failed"; exit 1; fi
}

# prune_files: the local retention (the remote copies are pruned by `prune`).
prune_files() {
  # Leftovers of a day that failed half-way are never a backup.
  find "$LOCAL/base" -mindepth 1 -maxdepth 1 -type d -name '.*.part' -mmin +240 -exec rm -rf {} +
  find "$LOCAL/dump" -name '*.dump' -mtime +"$BACKUP_KEEP_LOCAL_DAYS" -delete
  find "$LOCAL/config" -name '*.tgz' -mtime +"$BACKUP_KEEP_LOCAL_DAYS" -delete
  find "$LOCAL/docs" -name 'docs-*' -mtime +"$BACKUP_KEEP_LOCAL_DAYS" -delete
  find "$LOCAL/base" -mindepth 1 -maxdepth 1 -type d ! -name '.*' -mtime +"$BACKUP_KEEP_LOCAL_DAYS" -exec rm -rf {} +
  # Photo archives: the same days as the database. The newest set (the newest full archive with its snapshot file and
  # the newest diff on it) always stays, even when it is older than that (a full archive is made at least as often as
  # the shortest retention, so this only matters when the backups stopped). A diff whose full archive is gone is
  # removed too: it cannot be restored on its own.
  local full diff="" f s
  full="$(newest_full)"
  if [ -n "$full" ]; then
    for f in "$LOCAL/media"/media-*-diff-"$full".tar; do [ -e "$f" ] && diff="$(basename "$f" | cut -c7-19)"; done
  fi
  for f in "$LOCAL/media"/media-*.tar "$LOCAL/media"/media-*.snar "$LOCAL/media"/media-*.sha256; do
    [ -e "$f" ] || continue
    s="$(basename "$f" | cut -c7-19)"
    { [ "$s" = "$full" ] || [ "$s" = "$diff" ]; } && continue
    [ -n "$(find "$f" -mtime +"$BACKUP_KEEP_LOCAL_DAYS")" ] && rm -f "$f"
  done
  for f in "$LOCAL/media"/media-*-diff-*.tar; do
    [ -e "$f" ] || continue
    s="${f##*-diff-}"; s="${s%.tar}"
    [ -e "$LOCAL/media/media-$s-full.tar" ] || rm -f "$f" "$LOCAL/media/media-$(basename "$f" | cut -c7-19).sha256"
  done
  # WAL: kept here for BACKUP_KEEP_LOCAL_WAL_DAYS (every base backup carries its own), and never older than the
  # oldest kept base backup. With no base backup at all (the first ones failed) the window alone bounds it — before
  # 31 Oct 2026 it was kept for ever then, and it filled the backup disk.
  local oldest
  find "$LOCAL/wal" -type f -mmin +"$(( BACKUP_KEEP_LOCAL_WAL_DAYS * 1440 ))" -delete
  oldest="$(find "$LOCAL/base" -mindepth 1 -maxdepth 1 -type d ! -name '.*' -printf '%T@\n' | sort -n | head -1 | cut -d. -f1)"
  [ -n "$oldest" ] && find "$LOCAL/wal" -type f ! -newermt "@$oldest" -delete
  return 0
}

# drive_prune: with BACKUP_DRIVE_KEEP > 0 (the one-click Drive, PR 395/507) Drive keeps the newest that many backups
# that were checked whole (CHECKED marker); an unchecked one older than the oldest kept goes too (a newer unchecked one
# stays until a later checked one passes it). A removed folder goes to the Drive's bin, as Drive does. With 0, by age
# (BACKUP_KEEP_DRIVE_DAYS) as before.
drive_prune() {
  local keep="${BACKUP_DRIVE_KEEP:-0}" d n=0 oldest_kept="" all
  if [ "$keep" -le 0 ]; then rclone delete -q --min-age "${BACKUP_KEEP_DRIVE_DAYS}d" "$(dpath "")" || true; return 0; fi
  all="$(rclone lsf --dirs-only "$(dpath "")" 2>/dev/null | tr -d / | grep -E '^[0-9]{8}-[0-9]{4}$' | sort -r || true)"
  for d in $all; do
    if [ -n "$(rclone lsf "$(dpath "$d")" --include CHECKED 2>/dev/null)" ]; then
      n=$((n + 1))
      if [ "$n" -le "$keep" ]; then oldest_kept="$d"; continue; fi
      rclone purge -q "$(dpath "$d")" || true
    elif [ -n "$oldest_kept" ] && [ "$n" -ge "$keep" ] && [[ "$d" < "$oldest_kept" ]]; then
      rclone purge -q "$(dpath "$d")" || true
    fi
  done
}

prune() {
  prune_files
  # Remote copies (database, config, photo archives and docs bundles alike) by their age.
  # PR 385: locked Blob copies are never deleted from here; the container's lifecycle rule removes them after
  # BACKUP_KEEP_BLOB_DAYS (an attempt would be refused anyway, and a key that could delete is exactly what the lock stops)
  if ! imm_on; then blob_on && rclone delete -q --min-age "${BACKUP_KEEP_BLOB_DAYS}d" "blob:$BLOB_PATH" || true; fi
  drive_on && drive_prune
  return 0
  status prune local ok "kept ${BACKUP_KEEP_LOCAL_DAYS} days locally"
}

# schedule: the nightly time and the monthly drill from the settings onto the systemd timers (a drop-in each, so
# 10-backup.sh's own units stay as they are). Drill off: its timer is stopped. Run by extas-vault-sync when the
# settings file changed, and by server setup.
schedule() {
  local dir="${EXTAS_SYSTEMD_DIR:-/etc/systemd/system}" day
  day="$(printf '%02d' "$((10#${BACKUP_DRILL_DAY:-1}))")"
  mkdir -p "$dir/extas-backup-daily.timer.d" "$dir/extas-restore-test.timer.d"
  printf '[Timer]\nOnCalendar=\nOnCalendar=*-*-* %s:00\n' "$BACKUP_TIME" > "$dir/extas-backup-daily.timer.d/schedule.conf"
  printf '[Timer]\nOnCalendar=\nOnCalendar=*-*-%s %s:00\n' "$day" "${BACKUP_DRILL_TIME:-03:30}" > "$dir/extas-restore-test.timer.d/schedule.conf"
  systemctl daemon-reload >/dev/null 2>&1 || true
  systemctl restart extas-backup-daily.timer >/dev/null 2>&1 || true
  if [ "${BACKUP_DRILL_ON:-yes}" = yes ]; then
    systemctl enable --now extas-restore-test.timer >/dev/null 2>&1 || true
    systemctl restart extas-restore-test.timer >/dev/null 2>&1 || true
  else
    systemctl disable --now extas-restore-test.timer >/dev/null 2>&1 || true
  fi
  echo "nightly backup $BACKUP_TIME; restore drill $([ "${BACKUP_DRILL_ON:-yes}" = yes ] && echo "day $day at ${BACKUP_DRILL_TIME:-03:30}" || echo off)"
}

# request <id> <kind> [source]: one request from the admin, run now; its outcome for the vault sync to hand back.
request() {
  local id="${1:-}" kind="${2:-}" src="${3:-all}" out rc=0 detail
  [[ "$id" =~ ^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$ ]] || { echo "request: not an id" >&2; exit 2; }
  mkdir -p "$STATE/requests"
  out="$STATE/requests/$id.json"
  case "$kind" in
    BACKUP)
      bash "$0" daily >/dev/null 2>&1 || rc=$?
      detail="$(for t in local blob drive; do jq -r --arg t "$t" '"\($t): \(.result) — \(.detail)"' "$STATE/backup-daily-$t.json" 2>/dev/null; done | paste -sd ';' -)" ;;
    RESTORE_DRILL)
      [[ "$src" =~ ^(all|local|blob|drive)$ ]] || { echo "request: source all, local, blob or drive" >&2; exit 2; }
      bash "$(dirname "$0")/extas-restore" drill --only "$src" >/dev/null 2>&1 || rc=$?
      detail="$(jq -r '.detail' "$STATE/restore-drill.json" 2>/dev/null || echo 'the drill wrote no result')" ;;
    *) echo "request: BACKUP or RESTORE_DRILL" >&2; exit 2 ;;
  esac
  jq -n --arg id "$id" --argjson ok "$([ $rc -eq 0 ] && echo true || echo false)" --arg detail "${detail:-exit $rc}" \
    '{id:$id,ok:$ok,detail:$detail}' > "$out.tmp"
  mv "$out.tmp" "$out"
  exit $rc
}

case "${1:-}" in
  daily) daily ;;
  wal) wal ;;
  prune) prune ;;
  schedule) schedule ;;
  request) shift; request "$@" ;;
  lock-check) lock_check ;;
  *) echo "usage: extas-backup daily|wal|prune|schedule|request <id> <kind> [source]|lock-check" >&2; exit 2 ;;
esac

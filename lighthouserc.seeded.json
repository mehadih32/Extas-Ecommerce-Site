{
  "$comment": "Follow-up 23 (PR 82): the storefront Lighthouse budget again on the sample data (CI device-gate job: the sample catalogue, rules and combos on a throwaway database; never the owner's data). lighthouserc.json runs without a database, where the pages carry no products; with products the fonts and the fits cost more, so the same budget is checked here. The server is already running; first visits only (no Bengali-font cookie). PR 49: the product page (a polo with five colours) in both languages. PR 50/51: the T2 and T3 templates (the sample polos that carry them); PR 88: T3 in Bengali too (follow-up 156). PR 73: the search results for polo (the category page's filters and cards). PR 91–103: the combo page (a polo + chino set) in both languages and the sets landing page.",
  "ci": {
    "collect": {
      "url": [
        "http://127.0.0.1:3000/",
        "http://127.0.0.1:3000/bn",
        "http://127.0.0.1:3000/collections/new-in",
        "http://127.0.0.1:3000/bn/collections/new-in",
        "http://127.0.0.1:3000/collections/polos",
        "http://127.0.0.1:3000/bn/collections/polos",
        "http://127.0.0.1:3000/p/essential-pique-polo",
        "http://127.0.0.1:3000/bn/p/essential-pique-polo",
        "http://127.0.0.1:3000/p/textured-knit-polo",
        "http://127.0.0.1:3000/p/contrast-collar-polo",
        "http://127.0.0.1:3000/bn/p/contrast-collar-polo",
        "http://127.0.0.1:3000/account/wishlist",
        "http://127.0.0.1:3000/bn/account/wishlist",
        "http://127.0.0.1:3000/help/faq",
        "http://127.0.0.1:3000/bn/help/exchange",
        "http://127.0.0.1:3000/search?q=polo",
        "http://127.0.0.1:3000/bn/search?q=polo",
        "http://127.0.0.1:3000/account/login",
        "http://127.0.0.1:3000/bn/account/login",
        "http://127.0.0.1:3000/account",
        "http://127.0.0.1:3000/bn/account",
        "http://127.0.0.1:3000/account/profile",
        "http://127.0.0.1:3000/account/orders/0",
        "http://127.0.0.1:3000/bn/account/orders/0",
        "http://127.0.0.1:3000/combo/sample-polo-chino-set",
        "http://127.0.0.1:3000/bn/combo/sample-polo-chino-set",
        "http://127.0.0.1:3000/combos",
        "http://127.0.0.1:3000/bn/combos"
      ],
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--no-sandbox --headless=new",
        "throttlingMethod": "devtools"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.9,
            "aggregationMethod": "median-run"
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.9,
            "aggregationMethod": "median-run"
          }
        ],
        "largest-contentful-paint": [
          "error",
          {
            "maxNumericValue": 2500,
            "aggregationMethod": "median-run"
          }
        ],
        "cumulative-layout-shift": [
          "error",
          {
            "maxNumericValue": 0.1,
            "aggregationMethod": "median-run"
          }
        ],
        "total-blocking-time": [
          "error",
          {
            "maxNumericValue": 200,
            "aggregationMethod": "median-run"
          }
        ],
        "server-response-time": [
          "error",
          {
            "maxNumericValue": 600,
            "aggregationMethod": "median-run"
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci-seeded"
    }
  }
}

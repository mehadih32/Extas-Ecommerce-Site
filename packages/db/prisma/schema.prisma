  store     Store?   @relation(fields: [storeId], references: [id])
  agentKey  String
  month     String
  level     Int
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@unique([storeId, agentKey, month, level])
}

/// @stage S15 · PR 313, 316 — a cost estimate from the calculator (dashboard or Telegram), optionally saved as a plan and
/// compared with the actual later.
/// @scope store-optional — an estimate may be for the whole business.
model AiCostPlan {
  id             String   @id @default(uuid(7)) @db.Uuid
  storeId        Int?
  store          Store?   @relation(fields: [storeId], references: [id])
  description    String
  jobTypeKey     String?
  inputs         Json
  estimateMicros BigInt
  alternatives   Json?
  savedAsPlan    Boolean  @default(false)
  actualMicros   BigInt?
  createdVia     String
  createdById    String?  @db.Uuid
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)
}

/// @stage S15 · PR 317, 540, 583 — the single approval queue: everything waiting on the owner (money, refunds, COD,
/// prices, discounts, ad budget increases, blocks, deletions, skills, fixes).
/// @scope store-optional — most requests belong to a store; skill and fix approvals are installation-wide.
model AiApprovalRequest {
  id           String         @id @default(uuid(7)) @db.Uuid
  storeId      Int?
  store        Store?         @relation(fields: [storeId], references: [id])
  agentKey     String?
  kind         String
  title        String
  summary      String?
  payload      Json
  status       ApprovalStatus @default(PENDING)
  channel      String?
  refType      String?
  refId        String?
  decidedById  String?        @db.Uuid
  decisionNote String?
  decidedAt    DateTime?      @db.Timestamptz(3)
  expiresAt    DateTime?      @db.Timestamptz(3)
  createdAt    DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime       @updatedAt @db.Timestamptz(3)

  @@index([status, createdAt])
  @@index([storeId, status])
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
  CANCELLED
}

/// @stage S15 · PR 319 — the AI diary: what an agent did today, why, what it changed, in plain Bengali.

  updatedAt       DateTime       @updatedAt @db.Timestamptz(3)

  items        ComboItem[]
  popularPairs PopularPair[]

  @@unique([storeId, slug])
  @@index([storeId, status, sortRank])
}

enum ComboType {
  FIXED_SET
  COLOUR_PAIR
  TOP_BOTTOM
  MIXED_SET
  FIXED_COLOUR_PACK
  BUILD_YOUR_OWN
}

enum ComboStatus {
  DRAFT
  RUNNING
  PAUSED
  SOLD_OUT
  ENDED
}


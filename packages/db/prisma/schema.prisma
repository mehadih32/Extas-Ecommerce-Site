/// @stage S02 · PR 602 — every cache purge (price, stock, setting, new product, "Clear all cache").
/// @scope store-optional — "Clear all cache" can cover every store.
/// @append-only
model CachePurgeLog {
  id        String   @id @default(uuid(7)) @db.Uuid
  storeId   Int?
  store     Store?   @relation(fields: [storeId], references: [id])
  reason    String
  targets   Json
  layers    String[]
  actorId   String?  @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([storeId, createdAt])

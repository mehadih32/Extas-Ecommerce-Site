  @@unique([storeId, entityType, entityId, version])
}

enum RevisionStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
  SUPERSEDED
  DISCARDED
}

/// @stage S02 · PR 74, 598 — a menu (header, mega, phone, bottom bar, footer column).
model Menu {
  id         String    @id @default(uuid(7)) @db.Uuid
  storeId    Int
  store      Store     @relation(fields: [storeId], references: [id])
  location   String
  key        String

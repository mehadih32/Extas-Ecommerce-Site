// =====================================================================================================================
// S15 · AI 360 Control Room — PR 304–341, 506, 577–585. The control room is shared by all stores with per-store switches
// and cost attribution (A4.3). AI is additive: every agent has a non-AI fallback (C1.4).
// =====================================================================================================================

/// @stage S15 · PR 305, 577, 581, 583, 593 — an agent (the seven fixed agents, the five blog authors, engine agents such
/// as Photoshoot). Owner-editable profile; keep-on works with the master switch off (C1.3).
/// @scope installation — the shared AI 360 control room (A4.3).
model AiAgent {
  id                  String    @id @default(uuid(7)) @db.Uuid
  key                 String    @unique
  /// Employee code, e.g. A360-02.
  code                String    @unique
  nameEn              String
  nameBn              String?
  role                String
  emoji               String?
  photoAssetRef       String?
  bio                 String?
  joinedOn            DateTime? @db.Date
  isChief             Boolean   @default(false)
  reportsToId         String?   @db.Uuid
  reportsTo           AiAgent?  @relation("AgentChain", fields: [reportsToId], references: [id])
  reports             AiAgent[] @relation("AgentChain")
  enabled             Boolean   @default(false)
  keepOnWhenMasterOff Boolean   @default(false)
  verified            Boolean   @default(false)
  monthlyCapMinor     Int?
  schedule            Json?
  archivedAt          DateTime? @db.Timestamptz(3)
  createdAt           DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime  @updatedAt @db.Timestamptz(3)

  storeSettings AiAgentStoreSetting[]
  permissions   AgentPermission[]
  skills        AiSkill[]
  usage         AiUsageLedger[]
  diary         AiDiaryEntry[]
  assignments   AiAgentAssignment[]
  workLogs      AiWorkLog[]
  memories      AiMemory[]
  appraisals    AiAppraisal[]
  curriculum    AiCurriculumLevel[]
}

/// @stage S15 · PR 369 — an agent's switch, schedule and cap in one store.
model AiAgentStoreSetting {
  id              String   @id @default(uuid(7)) @db.Uuid
  storeId         Int
  store           Store    @relation(fields: [storeId], references: [id])
  agentId         String   @db.Uuid
  agent           AiAgent  @relation(fields: [agentId], references: [id])
  enabled         Boolean  @default(false)
  monthlyCapMinor Int?
  schedule        Json?
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)

  @@unique([storeId, agentId])
}

/// @stage S15 · PR 306 — an AI provider behind the adapter (Anthropic, OpenAI, Google, OpenRouter, FASHN, video vendors).
/// @scope installation — the shared AI 360 control room.
model AiProvider {
  id            String    @id @default(uuid(7)) @db.Uuid
  key           String    @unique
  name          String
  kinds         String[]
  integrationId String?   @db.Uuid
  enabled       Boolean   @default(false)
  archivedAt    DateTime? @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(3)

  models AiModel[]
}

/// @stage S15 · PR 306, 312, 580 — a model with its editable price table (millionths of a USD per million units).
/// @scope installation — the shared AI 360 control room.
model AiModel {
  id                     String     @id @default(uuid(7)) @db.Uuid
  providerId             String     @db.Uuid
  provider               AiProvider @relation(fields: [providerId], references: [id])
  modelKey               String
  displayName            String
  kind                   String
  priceCurrency          String
  inputPerMillionMicros  BigInt?
  outputPerMillionMicros BigInt?
  perImageMicros         BigInt?
  perVideoSecondMicros   BigInt?
  isFree                 Boolean    @default(false)
  enabled                Boolean    @default(false)
  priceCheckedAt         DateTime?  @db.Timestamptz(3)
  archivedAt             DateTime?  @db.Timestamptz(3)
  createdAt              DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime   @updatedAt @db.Timestamptz(3)

  @@unique([providerId, modelKey])
}

/// @stage S15 · PR 312, 313 — a row of the AI Cost Book: one job type with its chosen model, estimate and actual.

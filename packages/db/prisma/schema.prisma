/// @stage S12 · PR 239–245, 591 — a blog post through brief → draft → proofread → fact check → SEO → publish.
model BlogPost {
  id               String         @id @default(uuid(7)) @db.Uuid
  storeId          Int
  store            Store          @relation(fields: [storeId], references: [id])
  categoryId       String?        @db.Uuid
  category         BlogCategory?  @relation(fields: [categoryId], references: [id])
  authorId         String?        @db.Uuid
  author           BlogAuthor?    @relation(fields: [authorId], references: [id])
  clusterId        String?        @db.Uuid
  topicId          String?        @db.Uuid
  /// The Bengali twin (PR 588) or the English original.
  twinPostId       String?        @db.Uuid
  locale           String
  slug             String
  title            String
  excerpt          String?
  body             String?
  status           BlogPostStatus @default(IDEA)
  featured         Boolean        @default(false)
  wordCount        Int?
  readingMinutes   Int?
  similarityScore  Float?
  aiAssisted       Boolean        @default(false)
  sourceUrls       String[]
  factSources      Json?
  scheduledAt      DateTime?      @db.Timestamptz(3)
  publishedAt      DateTime?      @db.Timestamptz(3)
  contentUpdatedAt DateTime?      @db.Timestamptz(3)
  archivedAt       DateTime?      @db.Timestamptz(3)
  createdAt        DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime       @updatedAt @db.Timestamptz(3)

  reviews BlogPostReview[]
  tags    BlogPostTag[]

  @@unique([storeId, locale, slug])
  @@index([storeId, status, publishedAt])
}

enum BlogPostStatus {
  IDEA
  BRIEFED
  DRAFT
  PROOFREAD
  FACT_CHECKED
  SEO_CHECKED
  SCHEDULED
  PUBLISHED
  UNPUBLISHED
  ARCHIVED
}


/// @stage S14 · PR 302 — a manual erasure request (owner's written OK; the record is anonymised, never silently dropped).
model CustomerErasureRequest {
  id                String    @id @default(uuid(7)) @db.Uuid
  storeId           Int
  store             Store     @relation(fields: [storeId], references: [id])
  customerId        String    @db.Uuid
  reason            String?
  status            String
  requestedById     String?   @db.Uuid
  approvalRequestId String?   @db.Uuid
  executedAt        DateTime? @db.Timestamptz(3)

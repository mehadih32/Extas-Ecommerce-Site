/// @stage S15 · PR 582 — long-term agent memory; never deleted silently, viewable and correctable by the owner.
/// @scope store-optional — a memory may be about one store.
model AiMemory {
  id            String    @id @default(uuid(7)) @db.Uuid
  storeId       Int?
  store         Store?    @relation(fields: [storeId], references: [id])
  agentId       String    @db.Uuid
  agent         AiAgent   @relation(fields: [agentId], references: [id])

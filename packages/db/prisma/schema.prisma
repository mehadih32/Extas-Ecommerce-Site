  segment    Segment  @relation(fields: [segmentId], references: [id])
  customerId String   @db.Uuid
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  @@unique([segmentId, customerId])
}

/// @stage S14 · PR 288 — one touch in a customer's journey (visit, ad click, chat, order, review, exchange).
/// @append-only
model CustomerTouchpoint {
  id          String   @id @default(uuid(7)) @db.Uuid
  storeId     Int
  store       Store    @relation(fields: [storeId], references: [id])
  customerId  String?  @db.Uuid
  visitorId   String?
  kind        String
  source      String?
  campaignRef String?
  refType     String?
  refId       String?
  occurredAt  DateTime @db.Timestamptz(3)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  @@index([storeId, customerId, occurredAt])
}

/// @stage S14 · PR 289, 300 — a journey: trigger, waits, conditions, messages (win-back included).
model Journey {
  id         String    @id @default(uuid(7)) @db.Uuid
  storeId    Int
  store      Store     @relation(fields: [storeId], references: [id])
  name       String
  trigger    Json
  steps      Json
  enabled    Boolean   @default(false)
  archivedAt DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @db.Timestamptz(3)

  enrollments JourneyEnrollment[]
}

/// @stage S14 · PR 289 — a customer moving through a journey.
model JourneyEnrollment {
  id          String    @id @default(uuid(7)) @db.Uuid
  storeId     Int

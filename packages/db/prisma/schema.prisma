// =====================================================================================================================
// S14 · CRM & customers — PR 284–303, 505, 533–535. One customer record per store, keyed by phone (B5.5). Customers are
// never auto-deleted; only IP and GPS expire (PR 302).
// =====================================================================================================================

/// @stage S14 · PR 284, 534; S06 · PR 163 — a customer (website, Messenger, WhatsApp and phone orders share it).
model Customer {
  id                       String         @id @default(uuid(7)) @db.Uuid
  storeId                  Int
  store                    Store          @relation(fields: [storeId], references: [id])
  /// Normalised E.164; null only for a walk-in at the counter (A6.2).
  phone                    String?
  name                     String?
  email                    String?
  whatsappNumber           String?
  gender                   String?
  /// An inferred gender is shown as a guess, never a fact (B5.2).
  genderInferred           Boolean        @default(false)
  birthday                 DateTime?      @db.Date
  firstSource              String?
  firstCampaignRef         String?
  gradeId                  String?        @db.Uuid
  grade                    CustomerGrade? @relation(fields: [gradeId], references: [id])
  verifiedAt               DateTime?      @db.Timestamptz(3)
  /// PR 163: COD policy a human set for a repeat refuser (reversible by hand).
  codPolicy                String?
  codPolicySetById         String?        @db.Uuid
  codPolicyReason          String?
  smsMarketingConsent      Boolean?
  whatsappMarketingConsent Boolean?
  /// Denormalised counters for the list and the approval screen (PR 533).
  orderCount               Int            @default(0)
  deliveredCount           Int            @default(0)
  returnedCount            Int            @default(0)
  refusedCount             Int            @default(0)
  lifetimeValueMinor       Int            @default(0)
  lastOrderAt              DateTime?      @db.Timestamptz(3)
  legacyImportId           String?        @db.Uuid
  erasedAt                 DateTime?      @db.Timestamptz(3)
  archivedAt               DateTime?      @db.Timestamptz(3)
  /// PR 284: a person merged this profile into another one (the survivor). The survivor's single view shows both; nothing
  /// moves and nothing is deleted, and a split (CustomerMerge.undoneAt) makes it its own profile again.
  mergedIntoId             String?        @db.Uuid
  mergedAt                 DateTime?      @db.Timestamptz(3)
  createdAt                DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt                DateTime       @updatedAt @db.Timestamptz(3)

  credential CustomerCredential?
  sessions   CustomerSession[]
  addresses  CustomerAddress[]
  carts      Cart[]
  orders     Order[]
  wallet     WalletAccount?
  notes      CustomerNote[]
  tagLinks   CustomerTagLink[]

  @@unique([storeId, phone])
  @@index([storeId, lastOrderAt])
  @@index([storeId, mergedIntoId])
  // PR 603: fuzzy name matching for the identity graph (PR 519).
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "idx_customer_name_trgm")
}

/// @stage S14 · PR 534 — a grade / badge level earned from real delivery history.
model CustomerGrade {
  id         String    @id @default(uuid(7)) @db.Uuid
  storeId    Int
  store      Store     @relation(fields: [storeId], references: [id])
  key        String
  nameEn     String
  nameBn     String?
  criteria   Json
  icon       String?
  sortOrder  Int       @default(0)
  archivedAt DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @db.Timestamptz(3)

  customers Customer[]

  @@unique([storeId, key])
}

/// @stage S14 · PR 297 — an internal note on a customer.
model CustomerNote {
  id         String    @id @default(uuid(7)) @db.Uuid
  storeId    Int
  store      Store     @relation(fields: [storeId], references: [id])
  customerId String    @db.Uuid
  customer   Customer  @relation(fields: [customerId], references: [id])
  body       String
  pinned     Boolean   @default(false)
  authorId   String?   @db.Uuid
  archivedAt DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @db.Timestamptz(3)
}

/// @stage S14 · PR 297 — a customer tag.
model CustomerTag {
  id         String    @id @default(uuid(7)) @db.Uuid
  storeId    Int
  store      Store     @relation(fields: [storeId], references: [id])
  name       String
  color      String?
  archivedAt DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @db.Timestamptz(3)

  links CustomerTagLink[]

  @@unique([storeId, name])
}

/// @stage S14 · PR 297 — a tag on a customer.
model CustomerTagLink {
  id         String      @id @default(uuid(7)) @db.Uuid
  storeId    Int
  store      Store       @relation(fields: [storeId], references: [id])
  customerId String      @db.Uuid
  customer   Customer    @relation(fields: [customerId], references: [id])
  tagId      String      @db.Uuid
  tag        CustomerTag @relation(fields: [tagId], references: [id])
  createdAt  DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime    @updatedAt @db.Timestamptz(3)

  @@unique([customerId, tagId])
}

/// @stage S14 · B5.1 — "Who looked at this customer": every profile open, number copy and export.
/// @append-only
model CustomerAccessLog {
  id          String   @id @default(uuid(7)) @db.Uuid
  storeId     Int
  store       Store    @relation(fields: [storeId], references: [id])
  customerId  String   @db.Uuid
  staffUserId String?  @db.Uuid
  action      String
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  @@index([customerId, createdAt])
}

/// @stage S14 · PR 284 — a person's decision on two customer profiles: MERGED (the second into the first, the survivor;
/// undone by a split, which keeps this row with who split it and why) or NOT_SAME (the pair is never suggested again).
/// Nothing is deleted: the profiles, their orders, wallets and notes stay where they are.
model CustomerMerge {
  id             String                @id @default(uuid(7)) @db.Uuid
  storeId        Int
  store          Store                 @relation(fields: [storeId], references: [id])
  decision       CustomerMergeDecision
  survivorId     String                @db.Uuid
  mergedId       String                @db.Uuid
  /// The merge rules that matched when it was decided (email, whatsapp, nameAddress, identity) or `manual`.
  signals        String[]
  note           String?
  decidedById    String?               @db.Uuid
  idempotencyKey String?
  undoneAt       DateTime?             @db.Timestamptz(3)
  undoneById     String?               @db.Uuid
  undoNote       String?
  createdAt      DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime              @updatedAt @db.Timestamptz(3)

  @@unique([storeId, idempotencyKey])
  @@index([storeId, survivorId])
  @@index([storeId, mergedId])
  @@index([storeId, decision, createdAt])
}

enum CustomerMergeDecision {
  MERGED
  NOT_SAME
}

/// @stage S14 · PR 123, 298 — a consent change per channel, with where and when (SMS and WhatsApp stored separately).
/// @append-only
model ConsentRecord {
  id           String              @id @default(uuid(7)) @db.Uuid
  storeId      Int
  store        Store               @relation(fields: [storeId], references: [id])
  customerId   String?             @db.Uuid
  orderId      String?             @db.Uuid
  phone        String?
  channel      NotificationChannel
  granted      Boolean
  source       String
  ip           String?
  createdAt    DateTime            @default(now()) @db.Timestamptz(3)
  /// PR 298 — what the answer is about: MARKETING (offers; the checkout and account ticks) or ALL (every message on the
  /// channel, order updates too: the customer's STOP, or his request through the team). The newest row per phone (or
  /// customer), channel and scope is the answer the message engine honours before every send.
  scope        String              @default("MARKETING")
  /// PR 298 — the staff member who recorded it at the customer's request (null for the customer's own answer).
  recordedById String?             @db.Uuid

  @@index([storeId, customerId, channel, createdAt])
  @@index([storeId, phone, channel, createdAt])
}

/// @stage S14 · PR 287, 294 — a saved segment from real behaviour.
model Segment {

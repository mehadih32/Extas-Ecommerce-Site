// =====================================================================================================================
// EXTAS e-commerce — the full Prisma schema in one pass (register PR 13) with the database performance pack (PR 603).
//
// Shared file, single owner (Blueprint A1.4): Prohori (A360-02, S00 owner). Every other agent asks Prohori for a change;
// nobody else edits this file. A change here is a new migration under prisma/migrations/, never an edit of an old one.
//
// CONVENTIONS
// - IDs: `Store.id` is an Int so the mother store is `storeId = 1` (Blueprint A4.5). Every other table has a UUIDv7
//   primary key (`@default(uuid(7)) @db.Uuid`): time-ordered, so B-tree inserts stay local.
// - Store scoping (A4.1): every store-scoped table carries `storeId Int` with a foreign key to Store, and the data layer
//   adds `storeId` to every query so one store can never read another store's rows. The exceptions are listed below and
//   checked by `test/schema-guard.test.ts`, which fails the build if a model lacks `storeId` without being listed here.
// - Money: integer minor units — poisha for BDT — in fields ending `Minor` (Int, or BigInt for running totals), with a
//   `currency` column wherever it can differ from the store currency (ad spend in USD). Per-token AI prices use fields
//   ending `Micros` (millionths of the currency unit, BigInt). Never Float for money; rates and percentages are Decimal
//   or basis points (`…Bps`).
// - Nothing is deleted (CLAUDE.md rule 3): `archivedAt` is the soft delete; no relation cascades on delete; history
//   tables are append-only (`/// @append-only`, no `updatedAt`).
// - Nothing hardcoded (rule 1): charges, windows, limits, wording and thresholds live in settings rows
//   (SettingDefinition / InstallationSettingValue / StoreSettingValue, PR 491–496) or in owner-edited rule rows.
//   Schema defaults are neutral technical ones only (initial status, false, 0, now()).
// - Owner's own data (PR 509): `SettingDefinition.isOwnerData` and `OwnerDataEntry` mark what never ships to a new
//   installation. The repository holds sample data only.
// - Secrets (PR 493): only ciphertext + iv + auth tag + key version + who/when (InstallationSecret, StoreSecret). The
//   master key is outside the database. Passwords, tokens and codes are stored as hashes (`…Hash`).
// - Actor columns named `…ById` are soft references to StaffUser (no FK), so audit rows outlive any account change.
// - Time: every DateTime is `timestamptz(3)`; date-only columns are `@db.Date`. The store's day boundary comes from
//   `Store.timezone`, never from code.
// - Model annotations read by the guard test: `/// @stage Sxx · PR …` (the owning register stage),
//   `/// @scope installation — reason` or `/// @scope store-optional — reason`, and `/// @append-only`.
//
// STORE-SCOPE EXCEPTIONS — installation-level tables, no storeId (each model also carries `/// @scope installation`):
// @installation-level-begin
//   Installation, Store                                                         — the installation and the store registry
//   SettingDefinition, InstallationSettingValue, SettingsMigration, OwnerDataEntry — installation settings (PR 491–496, 509)
//   VaultKey, InstallationSecret                                                — the vault's installation scope (PR 493)
//   StaffUser, StaffSession, StaffLoginEvent, StaffPushSubscription             — staff span stores (A4.3)
//   Role, Permission, RolePermission                                            — roles are shared (A4.3, PR 495)
//   AdminIpAllowlistEntry                                                       — admin access (B6.5)
//   IdempotencyKey, ScheduledJob                                                — system jobs
//   GeoArea                                                                     — the national gazetteer, shared reference data (PR 549)
//   Warehouse, InventoryLocation, StockLevel, LowStockAlert, StockAudit, StockAuditLine, LocalStockIntake
//                                                                               — one shared stock pool for all stores (A4.4)
//   AiAgent, AiProvider, AiModel, AiJobType, AiModelPreset, DataClassRoute, AgentPermission, AiSkill, AiSkillVersion,
//   AiSkillExport, AiTrainingExample, AiSandboxRun, AiModelQualification, AiAppraisal, AiCurriculumLevel,
//   AiLearningSource, AiLearningTip, AiPracticeTask, TelegramChat, TelegramMessage, RecommendationNote
//                                                                               — the shared AI 360 control room (A4.3, C1, C10)
//   ManualArticle, ChecklistPoint, PrRegisterEntry, PrRegisterUpdate, RegisterDocument, ChangeRequest
//                                                                               — system content: manual, QA checklist, PR register
//   ServiceHealthSample, SlowQuery, CacheStatSample, BackupRun, RestoreTest, RestoreRequest, DeployRecord, GoLiveCheck
//                                                                               — the one server (S19, S21)
//   InstallationSetupRun, UpdateRelease                                         — installation pack (S26, parked)
// @installation-level-end
//
// STORE-OPTIONAL — `storeId Int?`, where null means installation-wide (each model carries `/// @scope store-optional`):
// @store-optional-begin
//   SettingChange, SecretAccessLog, StaffRoleAssignment, Integration, IntegrationTestRun, DefaultPackApplication,
//   JobRun, OutboxEvent, WebhookEvent, StockMovement, CachePurgeLog, AuditLog, SecurityEvent, StaffBadge,
//   AiUsageLedger, AiCapEvent, AiApprovalRequest, AiDiaryEntry, AiBugReport, AiWorkLog, AiMemory, AiInvestigation,
//   AiAgentAssignment, AiCostPlan, ReportDigest
// @store-optional-end
// =====================================================================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  // Migrations go straight to PostgreSQL; the app goes through PgBouncer (transaction mode) on DATABASE_URL.
  directUrl  = env("DATABASE_DIRECT_URL")
  extensions = [pg_trgm]
}

// =====================================================================================================================
// S00 · Foundation — installation, stores, settings framework (PR 491, 492, 496, 508–510), vault (PR 493), staff,
// roles (PR 16, 495), customer authentication (PR 15), integrations and adapters (PR 18, 500), system jobs.
// =====================================================================================================================

/// @stage S00 · PR 13, 496 — one row: this installation, its schema and settings versions.
/// @scope installation — describes the installation itself.
model Installation {
  id               String    @id @default(uuid(7)) @db.Uuid
  /// Version of the settings registry the installation has been migrated to (PR 496).
  settingsVersion  Int       @default(0)
  /// Application release the database was last migrated by.
  appVersion       String?
  installedAt      DateTime  @default(now()) @db.Timestamptz(3)
  /// Set once the setup wizard (S26) or the first-run seed has finished.
  setupCompletedAt DateTime? @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @db.Timestamptz(3)
}

/// @stage S00 · PR 13, 356 — a store. The mother store is id 1 with isPrimary = true (A4.5); it is never deleted or moved.

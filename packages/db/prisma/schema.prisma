model ExchangeRate {
  id            String   @id @default(uuid(7)) @db.Uuid
  storeId       Int
  store         Store    @relation(fields: [storeId], references: [id])
  baseCurrency  String
  quoteCurrency String
  rate          Decimal  @db.Decimal(18, 6)

/// @stage S00 · PR 491 — the typed settings registry. A definition exists once per installation; values sit at
/// installation level and/or store level (PR 492). `defaultValue` is what "Reset to default" restores (PR 510).
/// @scope installation — the registry of setting keys.
model SettingDefinition {
  id              String           @id @default(uuid(7)) @db.Uuid
  /// Dotted key, e.g. `delivery.band.hours`, `pdp.payLineWithFree`.
  key             String           @unique
  group           String
  valueType       SettingValueType
  scope           SettingScope
  /// Default value as JSON; seeded from the general default pack (PR 508). Null only for owner data with no default.
  defaultValue    Json?
  /// Validation: min, max, options, pattern, unit (B7.2 #2 — publish is blocked on an invalid value).
  constraints     Json?
  labelEn         String
  labelBn         String
  helpEn          String?
  helpBn          String?
  /// PR 509: the value is the owner's own data (store name, logo, phone, address, bank details, social links …) and is
  /// never exported to a new installation.
  isOwnerData     Boolean          @default(false)
  /// Sent to the storefront bundle (only non-sensitive values).
  isPublic        Boolean          @default(false)
  /// Changing it needs the owner's written OK (CLAUDE.md rule 6: prices, COD, discounts, budgets).
  requiresOwnerOk Boolean          @default(false)
  /// Settings version that introduced the key (PR 496); the migration adds it everywhere with its default.
  sinceVersion    Int
  sortOrder       Int              @default(0)
  deprecatedAt    DateTime?        @db.Timestamptz(3)
  archivedAt      DateTime?        @db.Timestamptz(3)
  createdAt       DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @db.Timestamptz(3)

  installationValue InstallationSettingValue?
  storeValues       StoreSettingValue[]

  @@index([group, sortOrder])
}

enum SettingValueType {
  STRING
  TEXT
  INT
  DECIMAL
  BOOLEAN
  ENUM
  JSON
  MONEY_MINOR
  DURATION_SECONDS
  COLOR
  URL
  EMAIL
  PHONE
  MEDIA_REF
  SECRET_REF
  LOCALIZED_TEXT
}

enum SettingScope {
  /// One value for the whole installation.
  INSTALLATION
  /// One value per store, no installation value.
  STORE
  /// Installation value inherited by every store unless the store overrides it (PR 492).
  INHERITED
}

/// @stage S00 · PR 491, 492 — the installation-level value of a setting (tier 1).
/// @scope installation — tier 1 of the two-tier resolver.
model InstallationSettingValue {
  id          String            @id @default(uuid(7)) @db.Uuid
  key         String            @unique
  definition  SettingDefinition @relation(fields: [key], references: [key])
  value       Json
  /// Optimistic lock: a save must name the version it read.
  version     Int               @default(1)
  updatedById String?           @db.Uuid
  createdAt   DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime          @updatedAt @db.Timestamptz(3)
}

/// @stage S00 · PR 492 — the store-level value of a setting (tier 2); missing row = inherit the installation value.
model StoreSettingValue {
  id          String            @id @default(uuid(7)) @db.Uuid
  storeId     Int
  store       Store             @relation(fields: [storeId], references: [id])
  key         String
  definition  SettingDefinition @relation(fields: [key], references: [key])
  value       Json
  version     Int               @default(1)
  updatedById String?           @db.Uuid
  createdAt   DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime          @updatedAt @db.Timestamptz(3)

  @@unique([storeId, key])
  @@index([key])
}

/// @stage S00 · PR 491, 510 — every change to a setting value, including resets and migrations.
/// @scope store-optional — null storeId = an installation-level value changed.
/// @append-only
model SettingChange {
  id        String              @id @default(uuid(7)) @db.Uuid
  storeId   Int?
  store     Store?              @relation(fields: [storeId], references: [id])
  key       String
  action    SettingChangeAction
  oldValue  Json?
  newValue  Json?
  reason    String?
  actorId   String?             @db.Uuid
  createdAt DateTime            @default(now()) @db.Timestamptz(3)

  @@index([key, createdAt])
  @@index([storeId, createdAt])
}

enum SettingChangeAction {
  SET
  RESET_TO_DEFAULT
  MIGRATION_ADDED
  COPIED_FROM_STORE
  IMPORTED
}

/// @stage S00 · PR 496 — the settings migration marker: which registry versions this installation has applied.
/// @scope installation — one log per installation.
/// @append-only
model SettingsMigration {
  id          String   @id @default(uuid(7)) @db.Uuid
  version     Int      @unique
  name        String
  addedKeys   String[]
  changedKeys String[]
  appliedAt   DateTime @default(now()) @db.Timestamptz(3)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
}

/// @stage S00 · PR 509 — the "My own data" register: tables, setting groups or media that never ship to a new
/// installation (store name, logo, keys, phone, address, Dhaka area list, bank and payment details, social links).
/// @scope installation — the export rule for the whole installation.
model OwnerDataEntry {
  id         String        @id @default(uuid(7)) @db.Uuid
  kind       OwnerDataKind
  /// Table name, setting key or key prefix, or media folder.
  target     String
  reasonEn   String
  reasonBn   String
  archivedAt DateTime?     @db.Timestamptz(3)
  createdAt  DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime      @updatedAt @db.Timestamptz(3)

  @@unique([kind, target])
}

enum OwnerDataKind {
  TABLE
  SETTING_KEY
  SETTING_PREFIX
  MEDIA_FOLDER
}

/// @stage S00 · PR 508 — which default pack (policy shapes, charge structures, templates, roles, theme) was seeded where.
/// @scope store-optional — packs apply to the installation or to one store.
/// @append-only
model DefaultPackApplication {
  id          String   @id @default(uuid(7)) @db.Uuid
  storeId     Int?
  store       Store?   @relation(fields: [storeId], references: [id])
  packKey     String
  version     Int
  summary     Json?
  appliedById String?  @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  @@unique([storeId, packKey, version])
}

// ---------------------------------------------------------------------------------------------------------------------
// Credential vault (PR 493). Envelope encryption: each secret is AES-GCM ciphertext under a data key; the data key is
// stored wrapped by the master key, which lives outside the database (Azure Key Vault or a root-only key file on the VM).
// A stolen database alone is useless ciphertext. No plaintext column exists anywhere.
// ---------------------------------------------------------------------------------------------------------------------

/// @stage S00 · PR 493 — one row per data-key version. `wrappedDataKey` is the data key encrypted by the master key.
/// @scope installation — the vault's key ring.
model VaultKey {
  id             String    @id @default(uuid(7)) @db.Uuid
  version        Int       @unique
  algorithm      String
  /// Where the master key that wraps this data key lives (a reference such as a key-vault key name), never the key.
  masterKeyRef   String
  wrappedDataKey Bytes
  activatedAt    DateTime? @db.Timestamptz(3)
  retiredAt      DateTime? @db.Timestamptz(3)
  createdById    String?   @db.Uuid
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(3)

  installationSecrets InstallationSecret[]
  storeSecrets        StoreSecret[]
}

/// @stage S00 · PR 493 — an installation-wide secret (server, GitHub, Telegram bot, AI provider, backup targets).
/// @scope installation — the vault's installation scope.
model InstallationSecret {
  id          String    @id @default(uuid(7)) @db.Uuid
  /// Stable name the adapters ask for, e.g. `telegram.botToken`.
  name        String    @unique
  ciphertext  Bytes
  iv          Bytes
  authTag     Bytes
  keyVersion  Int
  key         VaultKey  @relation(fields: [keyVersion], references: [version])
  createdById String?   @db.Uuid
  updatedById String?   @db.Uuid
  rotatedAt   DateTime? @db.Timestamptz(3)
  revokedAt   DateTime? @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)
}

/// @stage S00 · PR 493, 365 — a store's own secret (its payment, courier, SMS, WhatsApp, ad-account and ERP keys).
model StoreSecret {
  id          String    @id @default(uuid(7)) @db.Uuid
  storeId     Int
  store       Store     @relation(fields: [storeId], references: [id])
  name        String
  ciphertext  Bytes
  iv          Bytes
  authTag     Bytes
  keyVersion  Int
  key         VaultKey  @relation(fields: [keyVersion], references: [version])
  createdById String?   @db.Uuid
  updatedById String?   @db.Uuid
  rotatedAt   DateTime? @db.Timestamptz(3)
  revokedAt   DateTime? @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)

  @@unique([storeId, name])
}

/// @stage S00 · PR 493 — every decrypt or change of a secret: which service, why, when — never the value.
/// @scope store-optional — null storeId = an installation secret.
/// @append-only
model SecretAccessLog {
  id         String             @id @default(uuid(7)) @db.Uuid
  storeId    Int?
  store      Store?             @relation(fields: [storeId], references: [id])
  secretName String
  action     SecretAccessAction
  service    String
  purpose    String?
  actorId    String?            @db.Uuid
  createdAt  DateTime           @default(now()) @db.Timestamptz(3)

  @@index([secretName, createdAt])
}

enum SecretAccessAction {
  CREATE
  REPLACE
  ROTATE
  REVOKE
  DECRYPT
  TEST
}

// ---------------------------------------------------------------------------------------------------------------------
// Staff, roles and sessions (PR 15, 16, 495; B6.5)
// ---------------------------------------------------------------------------------------------------------------------

/// @stage S00 · PR 15 — a staff account. One login spans every store; access per store comes from role assignments.
/// @scope installation — staff span stores (A4.3).
model StaffUser {
  id               String          @id @default(uuid(7)) @db.Uuid
  email            String          @unique
  phone            String?
  displayName      String
  passwordHash     String
  passwordSetAt    DateTime?       @db.Timestamptz(3)
  /// TOTP seed, encrypted like any vault secret (PR 493); null when 2FA is off.
  totpCiphertext   Bytes?
  totpIv           Bytes?
  totpAuthTag      Bytes?
  totpKeyVersion   Int?
  twoFactorEnabled Boolean         @default(false)
  /// Admin language (D11): `en` by default from settings, Bengali on switch.
  adminLocale      String?
  /// PR 12 (CN-025, CN-026 (b)): the person's own admin choices — the design per admin page (`look`, page id →
  /// design key) and where the guide opens (`guide`). Read only when `admin.look` / `admin.guideOpens` allow it.
  adminPrefs       Json?
  status           StaffUserStatus @default(ACTIVE)
  lastLoginAt      DateTime?       @db.Timestamptz(3)
  archivedAt       DateTime?       @db.Timestamptz(3)
  createdAt        DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime        @updatedAt @db.Timestamptz(3)

  sessions          StaffSession[]
  roleAssignments   StaffRoleAssignment[]
  pushSubscriptions StaffPushSubscription[]

  // ---- CN-028 · PR 616 (migration 0055_books_pin): the owner's PIN for the books (`books.adjust`, `books.close`) ----
  /// The owner's books PIN as a scrypt hash (never the PIN itself; set again with his password).
  booksPinHash      String?
  booksPinSetAt     DateTime? @db.Timestamptz(3)
  /// Wrong PIN tries typed by this person since the last right one, and the lock they earned (`books.pin.*`).
  booksPinFailures  Int       @default(0)
  booksPinLockedTil DateTime? @db.Timestamptz(3)
}

enum StaffUserStatus {
  INVITED
  ACTIVE
  SUSPENDED
  ARCHIVED
}

/// @stage S00 · PR 15; B6.5 — a staff session / device ("log out everywhere" revokes them all).
/// @scope installation — a staff session spans stores; the active store is a pointer, not a scope.
model StaffSession {
  id            String    @id @default(uuid(7)) @db.Uuid
  staffUserId   String    @db.Uuid
  staffUser     StaffUser @relation(fields: [staffUserId], references: [id])
  tokenHash     String    @unique
  deviceLabel   String?
  userAgent     String?
  ip            String?
  /// The store chosen in the store switcher (A4.6).
  activeStoreId Int?
  lastSeenAt    DateTime? @db.Timestamptz(3)
  expiresAt     DateTime  @db.Timestamptz(3)
  revokedAt     DateTime? @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(3)

  @@index([staffUserId, revokedAt])
}

/// @stage S00 · PR 15; B6.5 — every staff login attempt (login alerts, new-admin-login alert).
/// @scope installation — staff logins are installation-wide.
/// @append-only
model StaffLoginEvent {
  id          String   @id @default(uuid(7)) @db.Uuid
  staffUserId String?  @db.Uuid
  email       String
  success     Boolean
  reason      String?
  ip          String?
  userAgent   String?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  @@index([email, createdAt])
}

/// @stage S00 · PR 16, 495 — a role from the role builder (owner, manager, support, auditor are seeded defaults).
/// @scope installation — roles are shared by all stores (A4.3).
model Role {
  id            String    @id @default(uuid(7)) @db.Uuid
  key           String    @unique
  nameEn        String
  nameBn        String
  descriptionEn String?
  descriptionBn String?
  /// Seeded by the default pack; editable, never deletable.
  isSystem      Boolean   @default(false)
  archivedAt    DateTime? @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(3)

  permissions RolePermission[]
  assignments StaffRoleAssignment[]
}

/// @stage S00 · PR 16, 495 — the registry of permission keys checked on every action (B6.5).
/// @scope installation — the permission registry.
model Permission {
  id        String   @id @default(uuid(7)) @db.Uuid
  key       String   @unique
  group     String
  labelEn   String
  labelBn   String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  roles RolePermission[]
}

/// @stage S00 · PR 495 — which permissions a role grants.
/// @scope installation — roles are shared.
model RolePermission {
  roleId       String     @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id])
  permissionId String     @db.Uuid
  permission   Permission @relation(fields: [permissionId], references: [id])
  createdAt    DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @db.Timestamptz(3)

  @@id([roleId, permissionId])
}

/// @stage S00 · PR 16, 495 — a staff member's role, in one store or (storeId null) in every store.
/// @scope store-optional — null storeId = the role applies in all stores.
model StaffRoleAssignment {
  id          String    @id @default(uuid(7)) @db.Uuid
  staffUserId String    @db.Uuid
  staffUser   StaffUser @relation(fields: [staffUserId], references: [id])
  roleId      String    @db.Uuid
  role        Role      @relation(fields: [roleId], references: [id])
  storeId     Int?
  store       Store?    @relation(fields: [storeId], references: [id])
  grantedById String?   @db.Uuid
  revokedAt   DateTime? @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)

  @@unique([staffUserId, roleId, storeId])
}

/// @stage S18 · B6.5 — optional admin IP allow-list (a setting decides whether it is enforced).
/// @scope installation — admin access is installation-wide.
model AdminIpAllowlistEntry {
  id          String    @id @default(uuid(7)) @db.Uuid
  cidr        String    @unique
  label       String?
  enabled     Boolean   @default(false)
  createdById String?   @db.Uuid
  archivedAt  DateTime? @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)
}

// ---------------------------------------------------------------------------------------------------------------------
// Customer authentication (PR 15, 129, 130)
// ---------------------------------------------------------------------------------------------------------------------

/// @stage S00 · PR 15, 129 — a customer's password (accounts are auto-created on first order; credentials shown once).
model CustomerCredential {
  id            String    @id @default(uuid(7)) @db.Uuid
  storeId       Int
  store         Store     @relation(fields: [storeId], references: [id])
  customerId    String    @unique @db.Uuid
  customer      Customer  @relation(fields: [customerId], references: [id])
  passwordHash  String
  passwordSetAt DateTime? @db.Timestamptz(3)
  mustChange    Boolean   @default(false)
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(3)
}

/// @stage S00 · PR 15, 130 — a customer session on one device.
model CustomerSession {
  id          String    @id @default(uuid(7)) @db.Uuid
  storeId     Int
  store       Store     @relation(fields: [storeId], references: [id])
  customerId  String    @db.Uuid
  customer    Customer  @relation(fields: [customerId], references: [id])
  tokenHash   String    @unique
  deviceLabel String?
  userAgent   String?
  ip          String?
  lastSeenAt  DateTime? @db.Timestamptz(3)
  expiresAt   DateTime  @db.Timestamptz(3)
  revokedAt   DateTime? @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)

  @@index([storeId, customerId])
}

/// @stage S00 · PR 130, 555 — a one-time SMS code (new device login, address reveal at checkout). Only the hash is kept.
model OtpChallenge {
  id         String     @id @default(uuid(7)) @db.Uuid
  storeId    Int
  store      Store      @relation(fields: [storeId], references: [id])
  phone      String
  purpose    OtpPurpose
  codeHash   String
  attempts   Int        @default(0)
  ip         String?
  expiresAt  DateTime   @db.Timestamptz(3)
  consumedAt DateTime?  @db.Timestamptz(3)
  createdAt  DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime   @updatedAt @db.Timestamptz(3)

  @@index([storeId, phone, createdAt])
}

enum OtpPurpose {
  LOGIN
  NEW_DEVICE
  ADDRESS_REVEAL
  PASSWORD_RESET
}

// ---------------------------------------------------------------------------------------------------------------------
// Integrations and the adapter framework (PR 18, 500): every integration runs mock → sandbox → live (A1.3).
// ---------------------------------------------------------------------------------------------------------------------

/// @stage S00 · PR 18, 500 — one connection (courier, SMS, payment, AI provider, Meta, Google, WhatsApp, Telegram, Drive,
/// Blob, Cloudflare, ERP …). Non-secret config only; keys are vault secrets named in `secretNames`.
/// @scope store-optional — null storeId = an installation-wide connection (Telegram bot, AI providers, backups, storage).
model Integration {
  id              String          @id @default(uuid(7)) @db.Uuid
  storeId         Int?
  store           Store?          @relation(fields: [storeId], references: [id])
  kind            IntegrationKind
  /// Adapter key, e.g. `steadfast`, `pathao`, `bkash`, `anthropic`, `azure-blob`.
  provider        String
  name            String
  mode            AdapterMode     @default(MOCK)
  enabled         Boolean         @default(false)
  config          Json?
  /// Names of the InstallationSecret / StoreSecret rows this adapter reads.
  secretNames     String[]
  lastTestAt      DateTime?       @db.Timestamptz(3)
  lastTestOk      Boolean?
  lastTestMessage String?
  archivedAt      DateTime?       @db.Timestamptz(3)
  createdAt       DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime        @updatedAt @db.Timestamptz(3)

  testRuns IntegrationTestRun[]

  @@unique([storeId, kind, provider, name])
}

enum IntegrationKind {
  COURIER
  SMS
  EMAIL
  PAYMENT
  AI_PROVIDER
  META
  GOOGLE
  YOUTUBE
  TIKTOK
  WHATSAPP
  MESSENGER
  TELEGRAM
  GOOGLE_DRIVE
  STORAGE
  CDN
  ERP
  FRAUD_CHECK
  MAPS
  SEARCH_CONSOLE
  OTHER
  /// S19 · PR 397: a certificate the server shows (the Cloudflare Origin certificate), its own kind so it never stands
  /// in for the CDN (cache purge) or any other one-per-kind connection.
  CERTIFICATE
}

enum AdapterMode {
  MOCK
  SANDBOX
  LIVE
}

/// @stage S00 · PR 18, 500 — each press of the Test button.
/// @scope store-optional — follows its integration.
/// @append-only
model IntegrationTestRun {
  id            String      @id @default(uuid(7)) @db.Uuid
  storeId       Int?
  store         Store?      @relation(fields: [storeId], references: [id])
  integrationId String      @db.Uuid
  integration   Integration @relation(fields: [integrationId], references: [id])
  ok            Boolean
  latencyMs     Int?
  message       String?
  actorId       String?     @db.Uuid
  createdAt     DateTime    @default(now()) @db.Timestamptz(3)

  @@index([integrationId, createdAt])
}

// ---------------------------------------------------------------------------------------------------------------------
// System: idempotency, scheduled jobs, the outbox and inbound webhooks (B1.1: idempotency keys on every webhook,
// payment callback and ERP push).
// ---------------------------------------------------------------------------------------------------------------------

/// @stage S00 · PR 125, 170, 200 — idempotency records for order placement, payment callbacks and ERP pushes.
/// @scope installation — a system table; `scope` carries the context (store, route).
model IdempotencyKey {
  id             String    @id @default(uuid(7)) @db.Uuid
  scope          String
  key            String
  requestHash    String
  responseStatus Int?
  responseBody   Json?
  lockedUntil    DateTime? @db.Timestamptz(3)
  completedAt    DateTime? @db.Timestamptz(3)
  expiresAt      DateTime  @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(3)

  @@unique([scope, key])
  @@index([expiresAt])
}

/// @stage S00 · PR 6 — a scheduled job (courier sync, report refresh, retention, backups' app-side jobs). The schedule
/// itself is read from settings; this row records state.
/// @scope installation — system jobs.
model ScheduledJob {
  id                 String    @id @default(uuid(7)) @db.Uuid
  key                String    @unique
  queue              String
  /// Setting key holding the cron expression or interval.
  scheduleSettingKey String?
  enabled            Boolean   @default(false)
  lastRunAt          DateTime? @db.Timestamptz(3)
  nextRunAt          DateTime? @db.Timestamptz(3)
  createdAt          DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @db.Timestamptz(3)

  runs JobRun[]
}

/// @stage S00 · PR 6 — one attempt of a job, including dead-lettered ones (CN-022). The worker writes the row when the
/// attempt starts (RUNNING) and closes it once: SUCCEEDED, FAILED with the reason and the next attempt, DEAD_LETTERED
/// after the last try, or SKIPPED when the same idempotency key already succeeded (a retry never repeats a side effect).
/// Rows are never deleted.
/// @scope store-optional — per-store runs carry the store.
model JobRun {
  id             String       @id @default(uuid(7)) @db.Uuid
  storeId        Int?
  store          Store?       @relation(fields: [storeId], references: [id])
  jobKey         String
  job            ScheduledJob @relation(fields: [jobKey], references: [key])
  queue          String
  status         JobRunStatus
  attempt        Int          @default(1)
  /// The run's identity (job, store, time slot or event): every attempt of one run carries the same key.
  idempotencyKey String
  /// The queue's own job id, and the job's small JSON payload.
  queueJobId     String?
  payload        Json?
  maxAttempts    Int          @default(1)
  /// When a FAILED attempt is tried again; null once it succeeded or was dead-lettered.
  nextAttemptAt  DateTime?    @db.Timestamptz(3)
  /// The worker process that ran this attempt (WorkerHeartbeat.workerKey).
  workerKey      String?
  startedAt      DateTime     @default(now()) @db.Timestamptz(3)
  finishedAt     DateTime?    @db.Timestamptz(3)
  stats          Json?
  error          String?
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(3)

  @@index([jobKey, startedAt])
  @@index([status, startedAt])
  @@index([idempotencyKey, startedAt])
}

enum JobRunStatus {
  RUNNING
  SUCCEEDED
  FAILED
  DEAD_LETTERED
  CANCELLED
  SKIPPED
}

/// @stage S00 · PR 6 — one background worker process (CN-022): its heartbeat, whether it holds the scheduler lock and
/// how many jobs it runs. The Server page says "stale" when the newest beat is older than `jobs.heartbeatStaleSeconds`.
/// A stopped worker keeps its row (stoppedAt), so the page can tell "stopped" from "lost".
/// @scope installation — the worker serves every store.
model WorkerHeartbeat {
  id         String    @id @default(uuid(7)) @db.Uuid
  /// hostname:pid:random, unique per process start.
  workerKey  String    @unique
  hostname   String
  /// The commit the worker runs (GIT_SHA) and its blue/green colour.
  version    String?
  color      String?
  queues     String[]
  isLeader   Boolean   @default(false)
  activeJobs Int       @default(0)
  startedAt  DateTime  @db.Timestamptz(3)
  beatAt     DateTime  @db.Timestamptz(3)
  stoppedAt  DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @db.Timestamptz(3)

  @@index([beatAt])
}

/// @stage S00 · PR 6 — transactional outbox: events written with the change, delivered to BullMQ by a relay.
/// @scope store-optional — most events belong to a store.
model OutboxEvent {
  id          String       @id @default(uuid(7)) @db.Uuid
  storeId     Int?
  store       Store?       @relation(fields: [storeId], references: [id])
  topic       String
  payload     Json
  status      OutboxStatus @default(PENDING)
  attempts    Int          @default(0)
  availableAt DateTime     @default(now()) @db.Timestamptz(3)
  processedAt DateTime?    @db.Timestamptz(3)
  lastError   String?
  createdAt   DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @db.Timestamptz(3)

  @@index([status, availableAt])
}

enum OutboxStatus {
  PENDING
  DELIVERED
  FAILED
  DEAD
}

/// @stage S00 · PR 170, 184, 194 — every inbound webhook (payment, courier, ERP, Meta, WhatsApp, TikTok), verified and
/// de-duplicated before processing (ERP contract: signature + timestamp + idempotency).
/// @scope store-optional — resolved to a store when the integration is known.
model WebhookEvent {
  id             String        @id @default(uuid(7)) @db.Uuid
  storeId        Int?
  store          Store?        @relation(fields: [storeId], references: [id])
  source         String
  eventType      String
  idempotencyKey String
  signatureValid Boolean
  payload        Json
  status         WebhookStatus @default(RECEIVED)
  error          String?
  receivedAt     DateTime      @default(now()) @db.Timestamptz(3)
  processedAt    DateTime?     @db.Timestamptz(3)
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @db.Timestamptz(3)

  @@unique([source, idempotencyKey])
  @@index([status, receivedAt])
}

enum WebhookStatus {
  RECEIVED
  PROCESSED
  IGNORED
  FAILED
}

// =====================================================================================================================
// S01 · Catalog, media & images — PR 19–39, 590. The ERP is the master for style → colour/size → variant, SKU, retail
// price and cost (A3.2); the shop adds presentation, media, size charts, SEO and publishing.
// =====================================================================================================================

/// @stage S01 · PR 590 — a brand (EXTAS for own-label; other brands are named honestly).
model Brand {
  id          String    @id @default(uuid(7)) @db.Uuid
  storeId     Int
  store       Store     @relation(fields: [storeId], references: [id])
  slug        String
  name        String
  isOwnLabel  Boolean   @default(false)
  logoAssetId String?   @db.Uuid
  archivedAt  DateTime? @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)

  products Product[]

  @@unique([storeId, slug])
}

/// @stage S01 · PR 20, 27 — a garment type (polo, tee, panjabi, trouser, footwear …) with its measurement fields.
model GarmentType {
  id                String    @id @default(uuid(7)) @db.Uuid
  storeId           Int
  store             Store     @relation(fields: [storeId], references: [id])
  key               String
  nameEn            String
  nameBn            String
  /// Measurement columns for size charts (chest, length, sleeve …).
  measurementFields Json
  archivedAt        DateTime? @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @db.Timestamptz(3)

  categories Category[]
  sizeCharts SizeChart[]

  @@unique([storeId, key])
}

/// @stage S01 · PR 20, 598 — the category tree with sub-categories (per store: A4.2).
model Category {
  id             String          @id @default(uuid(7)) @db.Uuid
  storeId        Int
  store          Store           @relation(fields: [storeId], references: [id])
  parentId       String?         @db.Uuid
  parent         Category?       @relation("CategoryTree", fields: [parentId], references: [id])
  children       Category[]      @relation("CategoryTree")
  garmentTypeId  String?         @db.Uuid
  garmentType    GarmentType?    @relation(fields: [garmentTypeId], references: [id])
  slug           String
  nameEn         String
  nameBn         String?
  introEn        String?
  introBn        String?
  imageAssetId   String?         @db.Uuid
  /// Product page template for this category (T1/T2/T3, PR 52); null = inherit.
  templateKey    String?
  wasPriceSource WasPriceSource?
  sortOrder      Int             @default(0)
  isVisible      Boolean         @default(false)
  archivedAt     DateTime?       @db.Timestamptz(3)
  createdAt      DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime        @updatedAt @db.Timestamptz(3)

  products Product[]
  listings CategoryProduct[]

  @@unique([storeId, slug])
  @@index([storeId, parentId, sortOrder])
}

enum WasPriceSource {
  NONE
  MRP
  PRICE_HISTORY
  COMBO
  LAUNCH_PRICE
}

/// @stage S01 · PR 19, 536, 603 — the style hierarchy used for profit (Polo → brand polo → solid polo). `ancestorIds`
/// holds every ancestor so "everything under Polo" is one GIN lookup.
model StyleGroup {
  id           String       @id @default(uuid(7)) @db.Uuid
  storeId      Int
  store        Store        @relation(fields: [storeId], references: [id])
  parentId     String?      @db.Uuid
  parent       StyleGroup?  @relation("StyleTree", fields: [parentId], references: [id])
  children     StyleGroup[] @relation("StyleTree")
  /// 1 = top (e.g. Polo).
  level        Int
  /// Human-readable path, e.g. "Polo / Ralph Lauren polo / Solid polo".
  path         String
  ancestorIds  String[]     @db.Uuid
  name         String
  /// ERP style code where the node is an ERP style.
  erpStyleCode String?
  archivedAt   DateTime?    @db.Timestamptz(3)
  createdAt    DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime     @updatedAt @db.Timestamptz(3)

  products Product[]

  @@index([storeId, parentId], map: "idx_style_group_parent")
  @@index([ancestorIds], type: Gin, map: "idx_style_group_ancestors")
}

/// @stage S01 · PR 19, 21, 35, 36, 590 — a product (an ERP style made sellable). `inStock` and `minPriceMinor` are
/// denormalised from variants for listings.
model Product {
  id               String          @id @default(uuid(7)) @db.Uuid
  storeId          Int
  store            Store           @relation(fields: [storeId], references: [id])
  brandId          String?         @db.Uuid
  brand            Brand?          @relation(fields: [brandId], references: [id])
  categoryId       String?         @db.Uuid
  category         Category?       @relation(fields: [categoryId], references: [id])
  styleGroupId     String?         @db.Uuid
  styleGroup       StyleGroup?     @relation(fields: [styleGroupId], references: [id])
  fabricId         String?         @db.Uuid
  fabric           Fabric?         @relation(fields: [fabricId], references: [id])
  erpStyleCode     String?
  /// PR 609 (CN-028): the ERP grade this listing sells. A style's B-grade SKUs are a listing of their own.
  erpGrade         ErpGrade        @default(A)
  slug             String
  /// Name on the site (PR 590); the feed/ad title and SEO title are separate.
  nameEn           String
  nameBn           String?
  feedTitle        String?
  descriptionEn    String?
  descriptionBn    String?
  careEn           String?
  careBn           String?
  status           ProductStatus   @default(DRAFT)
  /// PDP template (T1/T2/T3) and first-screen style (A/B), chosen at upload (D4.2).
  templateKey      String?
  firstScreenStyle String?
  /// Which optional PDP blocks this product shows (colour note, true-colour link, rule rows …).
  pdpBlocks        Json?
  freeDelivery     Boolean?
  wasPriceSource   WasPriceSource?
  /// Health score and what is missing before it may go live (PR 29, 39).
  healthScore      Int             @default(0)
  healthIssues     Json?
  inStock          Boolean         @default(false)
  minPriceMinor    Int?
  sortRank         Int             @default(0)
  /// "Some images show the garment digitally placed on a model" disclosure (C7.15).
  hasAiImagery     Boolean         @default(false)
  /// S03 · PR 571 — the "Use in combos" tick at upload: an auto combo rule takes the product in only when it is on.
  inCombos         Boolean         @default(true)
  publishedAt      DateTime?       @db.Timestamptz(3)
  unpublishedAt    DateTime?       @db.Timestamptz(3)
  archivedAt       DateTime?       @db.Timestamptz(3)
  createdAt        DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime        @updatedAt @db.Timestamptz(3)

  variants ProductVariant[]
  colours  ProductColour[]
  media    ProductMedia[]
  listings CategoryProduct[]

  @@unique([storeId, slug])
  @@index([storeId, styleGroupId], map: "idx_product_style")
  @@index([storeId, status, publishedAt])
  @@index([storeId, erpStyleCode])
}

enum ProductStatus {
  DRAFT
  READY_TO_PUBLISH
  PUBLISHED
  /// Ghost archive (PR 36, 527): page stays live as out of stock.
  UNPUBLISHED
  ARCHIVED
}

/// @stage S01 · PR 30 — the colour library with real hex values and the colour name dictionary.
model Colour {
  id                String    @id @default(uuid(7)) @db.Uuid
  storeId           Int
  store             Store     @relation(fields: [storeId], references: [id])
  key               String
  nameEn            String
  nameBn            String?
  hex               String
  family            String?
  synonyms          String[]
  trueColourAssetId String?   @db.Uuid
  erpColorCode      String?
  archivedAt        DateTime? @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @db.Timestamptz(3)

  variants       ProductVariant[]
  productColours ProductColour[]

  @@unique([storeId, key])
}

/// @stage S01 · PR 19, 56 — a size (S … 5XL; footwear sizes; free size).
model Size {
  id          String    @id @default(uuid(7)) @db.Uuid
  storeId     Int
  store       Store     @relation(fields: [storeId], references: [id])
  key         String
  label       String
  sortOrder   Int       @default(0)
  erpSizeCode String?
  archivedAt  DateTime? @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)

  variants ProductVariant[]

  @@unique([storeId, key])
}

/// @stage S01 · PR 19, 603 — a variant: one SKU at one colour and size. SKU, barcode, retail price and cost mirror the
/// ERP's ProductVariant (A3.4). Stock lives in the shared pool (StockLevel).
model ProductVariant {
  id                  String    @id @default(uuid(7)) @db.Uuid
  storeId             Int
  store               Store     @relation(fields: [storeId], references: [id])
  productId           String    @db.Uuid
  product             Product   @relation(fields: [productId], references: [id])
  colourId            String?   @db.Uuid
  colour              Colour?   @relation(fields: [colourId], references: [id])
  sizeId              String?   @db.Uuid
  size                Size?     @relation(fields: [sizeId], references: [id])
  sku                 String
  barcode             String?
  erpVariantId        String?
  /// ERP mirror (owned by the ERP, B3.7).
  erpRetailPriceMinor Int?
  avgCostMinor        Int?
  bGradeAvgCostMinor  Int?
  /// PR 609 (CN-028): the SKU's ERP grade (B = the factory's own B-grade line: its own SKU, shop price and stock).
  grade               ErpGrade  @default(A)
  /// PR 609: what Retail pays the ERP for one piece ("bought from ERP at"), minor units. Never shown to customers.
  shopPriceMinor      Int?
  /// PR 609: the buying price before the last change, when it changed, and when the admin saw the change.
  shopPricePrevMinor  Int?
  shopPriceChangedAt  DateTime? @db.Timestamptz(3)
  shopPriceSeenAt     DateTime? @db.Timestamptz(3)
  /// PR 610: the ERP refused an order because this SKU has no shop price yet (409 NO_SHOP_PRICE): it is not sold until
  /// a shop price arrives (then this is cleared).
  shopPriceMissingAt  DateTime? @db.Timestamptz(3)
  /// Shop-owned sale price and compare-at price (B3.7).
  priceMinor          Int?
  compareAtMinor      Int?
  weightGrams         Int?
  active              Boolean   @default(false)
  inStock             Boolean   @default(false)
  sortOrder           Int       @default(0)
  erpUpdatedAt        DateTime? @db.Timestamptz(3)
  archivedAt          DateTime? @db.Timestamptz(3)
  createdAt           DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime  @updatedAt @db.Timestamptz(3)

  stockLevels StockLevel[]

  @@unique([storeId, sku], map: "uq_variant_sku")
  @@index([productId, colourId, sizeId], map: "idx_variant_colour_size")
  @@index([barcode])
  @@index([storeId, shopPriceChangedAt])
}

/// PR 609 (CN-028): the ERP grade of a SKU and of a listing.
enum ErpGrade {
  A
  B
}

/// @stage S01 · PR 38, 213 — price history behind every "was" price (the honesty rule).
/// @append-only
model PriceHistory {
  id             String   @id @default(uuid(7)) @db.Uuid
  storeId        Int
  store          Store    @relation(fields: [storeId], references: [id])
  variantId      String   @db.Uuid
  priceMinor     Int
  compareAtMinor Int?
  source         String
  actorId        String?  @db.Uuid
  effectiveFrom  DateTime @db.Timestamptz(3)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  @@index([storeId, variantId, effectiveFrom])
}

/// @stage S01 · PR 55 — a colour of a product, with its own note, true-colour photo and order.
model ProductColour {
  id                String    @id @default(uuid(7)) @db.Uuid
  storeId           Int
  store             Store     @relation(fields: [storeId], references: [id])
  productId         String    @db.Uuid
  product           Product   @relation(fields: [productId], references: [id])
  colourId          String    @db.Uuid
  colour            Colour    @relation(fields: [colourId], references: [id])
  noteEn            String?
  noteBn            String?
  trueColourAssetId String?   @db.Uuid
  sortOrder         Int       @default(0)
  archivedAt        DateTime? @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @db.Timestamptz(3)

  @@unique([productId, colourId])
}

/// @stage S01 · PR 22, 37, 444 — any stored file: product photos, video, banners, logos, generated PDFs, invoice JPGs,
/// chat media, studio assets. Originals are immutable; derived and AI-generated files point at their source.
model MediaAsset {
  id                  String          @id @default(uuid(7)) @db.Uuid
  storeId             Int
  store               Store           @relation(fields: [storeId], references: [id])
  kind                MediaKind
  storage             StorageProvider
  storageKey          String
  originalFileName    String?
  mimeType            String
  bytes               BigInt
  width               Int?
  height              Int?
  durationMs          Int?
  dominantColor       String?
  checksumSha256      String
  isOriginal          Boolean         @default(true)
  sourceAssetId       String?         @db.Uuid
  source              MediaAsset?     @relation("MediaDerivation", fields: [sourceAssetId], references: [id])
  derived             MediaAsset[]    @relation("MediaDerivation")
  /// S24 role taxonomy: primary_garment, front_reference, back_reference, detail_reference … (C7.6).
  role                String?
  isAiGenerated       Boolean         @default(false)
  /// Studio libraries may be shared with every store or kept private (A4.3).
  sharedWithAllStores Boolean         @default(false)
  altEn               String?
  altBn               String?
  folder              String?
  tags                String[]
  uploadedById        String?         @db.Uuid
  archivedAt          DateTime?       @db.Timestamptz(3)
  createdAt           DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime        @updatedAt @db.Timestamptz(3)

  renditions   MediaRendition[]
  productMedia ProductMedia[]

  @@index([storeId, kind, createdAt])
  @@index([checksumSha256])
}

enum MediaKind {
  IMAGE
  VIDEO
  AUDIO
  PDF
  DOCUMENT
  OTHER
}

enum StorageProvider {
  LOCAL_DISK
  AZURE_BLOB
  S3_COMPATIBLE
  GOOGLE_DRIVE
}

/// @stage S01 · PR 22, 24 — the responsive sizes (thumb, card, card2x, main, zoom) in AVIF, WebP and JPEG. The preset
/// widths and quality are settings.
model MediaRendition {
  id         String     @id @default(uuid(7)) @db.Uuid
  storeId    Int
  store      Store      @relation(fields: [storeId], references: [id])
  assetId    String     @db.Uuid
  asset      MediaAsset @relation(fields: [assetId], references: [id])
  preset     String
  format     String
  width      Int
  height     Int
  bytes      Int
  quality    Int?
  storageKey String
  createdAt  DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime   @updatedAt @db.Timestamptz(3)

  @@unique([assetId, preset, format])
}

/// @stage S01 · PR 25, 54 — a photo or video on a product's gallery, per colour (minimum four photos: front, back,
/// detail, on-model).
model ProductMedia {
  id         String           @id @default(uuid(7)) @db.Uuid
  storeId    Int
  store      Store            @relation(fields: [storeId], references: [id])
  productId  String           @db.Uuid
  product    Product          @relation(fields: [productId], references: [id])
  assetId    String           @db.Uuid
  asset      MediaAsset       @relation(fields: [assetId], references: [id])
  colourId   String?          @db.Uuid
  role       ProductMediaRole
  sortOrder  Int              @default(0)
  isPrimary  Boolean          @default(false)
  archivedAt DateTime?        @db.Timestamptz(3)
  createdAt  DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime         @updatedAt @db.Timestamptz(3)

  @@index([productId, colourId, sortOrder])
}

enum ProductMediaRole {
  FRONT
  BACK
  DETAIL
  ON_MODEL
  FLAT_LAY
  FABRIC
  TRUE_COLOUR
  SET
  VIDEO
  OTHER
}

/// @stage S01 · PR 27, 28 — a size chart per garment type and fit, with the measurement rows.
model SizeChart {
  id            String      @id @default(uuid(7)) @db.Uuid
  storeId       Int
  store         Store       @relation(fields: [storeId], references: [id])
  garmentTypeId String      @db.Uuid
  garmentType   GarmentType @relation(fields: [garmentTypeId], references: [id])
  name          String
  fitKey        String?
  columns       Json
  rows          Json
  archivedAt    DateTime?   @db.Timestamptz(3)
  createdAt     DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime    @updatedAt @db.Timestamptz(3)

  assignments SizeChartAssignment[]
}

/// @stage S01 · PR 27, 28 — a size chart assigned to a category or a single product. "Back to auto" archives the link
/// (archivedAt); setting a chart again brings the same row back. Reads ignore archived links (hard rule 3).
model SizeChartAssignment {
  id          String    @id @default(uuid(7)) @db.Uuid
  storeId     Int
  store       Store     @relation(fields: [storeId], references: [id])
  sizeChartId String    @db.Uuid
  sizeChart   SizeChart @relation(fields: [sizeChartId], references: [id])
  categoryId  String?   @db.Uuid
  productId   String?   @db.Uuid
  archivedAt  DateTime? @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)

  @@index([storeId, categoryId])
  @@index([storeId, productId])
}

/// @stage S01 · PR 31 — fabric and care content, structured for the page and the AI answers.
model Fabric {
  id          String    @id @default(uuid(7)) @db.Uuid
  storeId     Int
  store       Store     @relation(fields: [storeId], references: [id])
  nameEn      String
  nameBn      String?
  composition Json?
  gsm         Int?
  careEn      String?
  careBn      String?
  archivedAt  DateTime? @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)

  products Product[]
}

/// @stage S01 · PR 32 — a collection (manual, seasonal or rule-based).
model Collection {
  id         String         @id @default(uuid(7)) @db.Uuid
  storeId    Int
  store      Store          @relation(fields: [storeId], references: [id])
  slug       String
  nameEn     String
  nameBn     String?
  kind       CollectionKind
  rules      Json?
  startsAt   DateTime?      @db.Timestamptz(3)
  endsAt     DateTime?      @db.Timestamptz(3)
  archivedAt DateTime?      @db.Timestamptz(3)
  createdAt  DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime       @updatedAt @db.Timestamptz(3)

  products CollectionProduct[]

  @@unique([storeId, slug])
}

enum CollectionKind {
  MANUAL
  SEASONAL
  RULE
}

/// @stage S01 · PR 32 — a product in a collection. Taking it out archives the link (archivedAt); putting it back
/// brings the same row back (one row per collection and product). Reads ignore archived links (hard rule 3).
model CollectionProduct {
  id           String     @id @default(uuid(7)) @db.Uuid
  storeId      Int
  store        Store      @relation(fields: [storeId], references: [id])
  collectionId String     @db.Uuid
  collection   Collection @relation(fields: [collectionId], references: [id])
  productId    String     @db.Uuid
  position     Int        @default(0)
  archivedAt   DateTime?  @db.Timestamptz(3)
  createdAt    DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @db.Timestamptz(3)

  @@unique([collectionId, productId])
}

/// @stage S01 · PR 32 — a tag.
model Tag {
  id         String    @id @default(uuid(7)) @db.Uuid
  storeId    Int
  store      Store     @relation(fields: [storeId], references: [id])
  slug       String
  name       String
  archivedAt DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @db.Timestamptz(3)

  products ProductTag[]

  @@unique([storeId, slug])
}

/// @stage S01 · PR 32 — a tag on a product. Taking the tag off archives the link (archivedAt); tagging again brings
/// the same row back (one row per tag and product). Reads ignore archived links (hard rule 3).
model ProductTag {
  id         String    @id @default(uuid(7)) @db.Uuid
  storeId    Int
  store      Store     @relation(fields: [storeId], references: [id])
  tagId      String    @db.Uuid
  tag        Tag       @relation(fields: [tagId], references: [id])
  productId  String    @db.Uuid
  archivedAt DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @db.Timestamptz(3)

  @@unique([tagId, productId])
  @@index([productId])
}

/// @stage S01 · PR 33, 34 — a catalogue import (from a link, or a bulk CSV) or export job.
model CatalogImportJob {
  id          String           @id @default(uuid(7)) @db.Uuid
  storeId     Int
  store       Store            @relation(fields: [storeId], references: [id])
  kind        CatalogJobKind
  sourceUrl   String?
  fileAssetId String?          @db.Uuid
  status      BackgroundStatus @default(QUEUED)
  rowsTotal   Int              @default(0)
  rowsOk      Int              @default(0)
  rowsFailed  Int              @default(0)
  result      Json?
  createdById String?          @db.Uuid
  finishedAt  DateTime?        @db.Timestamptz(3)
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @db.Timestamptz(3)
}

enum CatalogJobKind {
  IMPORT_FROM_LINK
  CSV_IMPORT
  CSV_EXPORT
}

enum BackgroundStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

/// @stage S01 · PR 35, 204 — the "Ready to publish" queue (new ERP styles, failing checklists).
model PublishQueueItem {
  id           String      @id @default(uuid(7)) @db.Uuid
  storeId      Int
  store        Store       @relation(fields: [storeId], references: [id])
  productId    String      @db.Uuid
  reason       String
  status       QueueStatus @default(OPEN)
  checklist    Json?
  resolvedById String?     @db.Uuid
  resolvedAt   DateTime?   @db.Timestamptz(3)
  createdAt    DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime    @updatedAt @db.Timestamptz(3)

  @@index([storeId, status, createdAt])
}

enum QueueStatus {
  OPEN
  IN_PROGRESS
  DONE
  DISMISSED
}

/// @stage S01 · PR 36, 71 — back-in-stock interest on an out-of-stock product or variant.
model BackInStockRequest {
  id         String    @id @default(uuid(7)) @db.Uuid
  storeId    Int
  store      Store     @relation(fields: [storeId], references: [id])
  productId  String    @db.Uuid
  variantId  String?   @db.Uuid
  customerId String?   @db.Uuid
  phone      String?
  email      String?
  notifiedAt DateTime? @db.Timestamptz(3)
  archivedAt DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @db.Timestamptz(3)

  @@index([storeId, productId, notifiedAt])
}

/// @stage S01 · PR 590 — every rename or slug change (feeds the automatic 301 and the before/after SEO report).
/// @append-only
model ProductRename {
  id        String   @id @default(uuid(7)) @db.Uuid
  storeId   Int
  store     Store    @relation(fields: [storeId], references: [id])
  productId String   @db.Uuid
  oldName   String?
  newName   String?
  oldSlug   String?
  newSlug   String?
  actorId   String?  @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([storeId, productId, createdAt])
}

// =====================================================================================================================
// S02 · Storefront — PR 40–88, 501, 503, 595–600, 602: category listing, pages and the page builder, menus, themes,
// the label dictionary, reviews, Q&A, wishlist, Find My Size, A/B tests, snapshots and the site builder's versions.
// =====================================================================================================================

/// @stage S02 · PR 45, 603 — a product listed in a category of this store (a product of the mother store can be listed
/// in another store's category, A4.4). `inStock`, `sortRank` and `priceMinor` are denormalised so the category page is
/// one index range scan.
model CategoryProduct {
  id         String   @id @default(uuid(7)) @db.Uuid
  storeId    Int
  store      Store    @relation(fields: [storeId], references: [id])
  categoryId String   @db.Uuid
  category   Category @relation(fields: [categoryId], references: [id])
  productId  String   @db.Uuid
  product    Product  @relation(fields: [productId], references: [id])
  isVisible  Boolean  @default(false)
  inStock    Boolean  @default(false)
  /// Default sort (owner order / best sellers), higher first.
  sortRank   Int      @default(0)
  priceMinor Int?
  pinned     Boolean  @default(false)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  @@unique([categoryId, productId])
  // PR 603: the category page — category + store + in-stock + sort in one index.
  @@index([categoryId, storeId, inStock, sortRank(sort: Desc)], map: "idx_category_page")
  @@index([categoryId, storeId, inStock, priceMinor], map: "idx_category_page_price")
}

/// @stage S02 · PR 75, 76, 246, 254, 530, 588 — a page: home, content (FAQ, delivery, policies), landing, seasonal.
model Page {
  id          String        @id @default(uuid(7)) @db.Uuid
  storeId     Int
  store       Store         @relation(fields: [storeId], references: [id])
  kind        PageKind
  slug        String
  titleEn     String
  titleBn     String?
  bodyEn      String?
  bodyBn      String?
  templateKey String?
  campaignId  String?       @db.Uuid
  status      PublishStatus @default(DRAFT)
  /// Translation gate (PR 588): the /bn page publishes only when this is set.
  bnReadyAt   DateTime?     @db.Timestamptz(3)
  /// Seasonal lifecycle (PR 530): when the occasion returns, the page goes live again.
  recurrence  Json?
  publishedAt DateTime?     @db.Timestamptz(3)
  archivedAt  DateTime?     @db.Timestamptz(3)
  createdAt   DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @db.Timestamptz(3)

  sections PageSection[]

  @@unique([storeId, kind, slug])
}

enum PageKind {
  HOME
  CONTENT
  LANDING
  SEASONAL
  HELP
  BLOG_HOME
  SETS_LANDING
}

enum PublishStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  UNPUBLISHED
  ARCHIVED
}

/// @stage S02 · PR 76, 77, 595 — a section on a page or on a category layout (all categories, or one category's
/// override). Hidden, never deleted; defaults reproduce today's pages.
model PageSection {
  id          String       @id @default(uuid(7)) @db.Uuid
  storeId     Int
  store       Store        @relation(fields: [storeId], references: [id])
  pageId      String?      @db.Uuid
  page        Page?        @relation(fields: [pageId], references: [id])
  layoutScope LayoutScope
  categoryId  String?      @db.Uuid
  type        String
  position    Int
  isVisible   Boolean      @default(false)
  device      DeviceTarget @default(BOTH)
  isBuiltIn   Boolean      @default(false)
  config      Json?
  startsAt    DateTime?    @db.Timestamptz(3)
  endsAt      DateTime?    @db.Timestamptz(3)
  archivedAt  DateTime?    @db.Timestamptz(3)
  createdAt   DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @db.Timestamptz(3)

  @@index([storeId, layoutScope, categoryId, position])
  @@index([pageId, position])
}

enum LayoutScope {
  PAGE
  HOME
  ALL_CATEGORIES
  CATEGORY
  PRODUCT_PAGE
  CHECKOUT
  ACCOUNT
}

enum DeviceTarget {
  BOTH
  PHONE
  DESKTOP
}

/// @stage S02 · PR 596 — a side-canvas zone in the desktop gutters (master switch off by default).
model SideCanvasZone {
  id         String    @id @default(uuid(7)) @db.Uuid
  storeId    Int
  store      Store     @relation(fields: [storeId], references: [id])
  side       String
  pageScope  Json
  type       String
  placement  Json
  config     Json?
  enabled    Boolean   @default(false)
  startsAt   DateTime? @db.Timestamptz(3)
  endsAt     DateTime? @db.Timestamptz(3)
  archivedAt DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @db.Timestamptz(3)

  @@index([storeId, enabled])
}

/// @stage S02 · PR 597 — a saved look: the launch default or a named snapshot (layouts, side canvas, house ads, banners).
model LayoutSnapshot {
  id              String    @id @default(uuid(7)) @db.Uuid
  storeId         Int
  store           Store     @relation(fields: [storeId], references: [id])
  name            String
  isLaunchDefault Boolean   @default(false)
  payload         Json
  createdById     String?   @db.Uuid
  archivedAt      DateTime? @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(3)

  restores LayoutRestore[]
}

/// @stage S02 · PR 597 — every restore of a snapshot, itself undoable.
/// @append-only
model LayoutRestore {
  id              String         @id @default(uuid(7)) @db.Uuid
  storeId         Int
  store           Store          @relation(fields: [storeId], references: [id])
  snapshotId      String         @db.Uuid
  snapshot        LayoutSnapshot @relation(fields: [snapshotId], references: [id])
  previousPayload Json
  undoOfId        String?        @db.Uuid
  actorId         String?        @db.Uuid
  createdAt       DateTime       @default(now()) @db.Timestamptz(3)
}

/// @stage S02 · PR 598, 600 — draft → preview → publish versions of any site-builder edit, with undo and the AI
/// checker's report.
model ContentRevision {
  id          String         @id @default(uuid(7)) @db.Uuid
  storeId     Int
  store       Store          @relation(fields: [storeId], references: [id])
  entityType  String
  entityId    String
  version     Int
  status      RevisionStatus @default(DRAFT)
  payload     Json
  checks      Json?
  authorId    String?        @db.Uuid
  publishedAt DateTime?      @db.Timestamptz(3)

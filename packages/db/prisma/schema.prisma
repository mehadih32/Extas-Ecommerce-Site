/// @stage S13 · PR 265, 268, 531 — a campaign on an ad platform, mirrored from its API.
model AdCampaign {
  id                  String    @id @default(uuid(7)) @db.Uuid
  storeId             Int
  store               Store     @relation(fields: [storeId], references: [id])
  adAccountId         String    @db.Uuid
  adAccount           AdAccount @relation(fields: [adAccountId], references: [id])
  campaignId          String?   @db.Uuid
  campaign            Campaign? @relation(fields: [campaignId], references: [id])
  externalId          String
  name                String
  status              String
  objective           String?
  dailyBudgetMinor    Int?
  lifetimeBudgetMinor Int?
  currency            String
  lastSyncedAt        DateTime? @db.Timestamptz(3)
  archivedAt          DateTime? @db.Timestamptz(3)
  createdAt           DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime  @updatedAt @db.Timestamptz(3)

  adSets AdSet[]

  @@unique([adAccountId, externalId])
}

/// @stage S13 · PR 259–261 — an ad set / ad group with its targeting.
model AdSet {
  id               String     @id @default(uuid(7)) @db.Uuid
  storeId          Int
  store            Store      @relation(fields: [storeId], references: [id])
  adCampaignId     String     @db.Uuid
  adCampaign       AdCampaign @relation(fields: [adCampaignId], references: [id])
  externalId       String
  name             String
  status           String
  targeting        Json?
  dailyBudgetMinor Int?
  archivedAt       DateTime?  @db.Timestamptz(3)
  createdAt        DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime   @updatedAt @db.Timestamptz(3)

  ads Ad[]

  @@unique([adCampaignId, externalId])
}

/// @stage S13 · PR 259–261, 270 — an ad and its creative.
model Ad {
  id         String    @id @default(uuid(7)) @db.Uuid
  storeId    Int
  store      Store     @relation(fields: [storeId], references: [id])
  adSetId    String    @db.Uuid
  adSet      AdSet     @relation(fields: [adSetId], references: [id])
  externalId String
  name       String
  status     String
  creativeId String?   @db.Uuid
  archivedAt DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @db.Timestamptz(3)

  @@unique([adSetId, externalId])
}

/// @stage S13 · PR 265, 266 — daily spend and results per account and campaign (pushed to the ERP as AdSpend).
model AdSpendDaily {
  id                 String     @id @default(uuid(7)) @db.Uuid
  storeId            Int
  store              Store      @relation(fields: [storeId], references: [id])
  adAccountId        String     @db.Uuid
  adAccount          AdAccount  @relation(fields: [adAccountId], references: [id])
  adCampaignId       String?    @db.Uuid
  date               DateTime   @db.Date
  platform           AdPlatform
  spendMinor         Int
  currency           String
  /// Spend converted with the owner's USD rate (PR 266) into the store currency.
  spendStoreMinor    Int?
  exchangeRateId     String?    @db.Uuid
  impressions        Int        @default(0)
  clicks             Int        @default(0)
  purchases          Int        @default(0)
  deliveredPurchases Int        @default(0)
  erpPushedAt        DateTime?  @db.Timestamptz(3)
  createdAt          DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime   @updatedAt @db.Timestamptz(3)

  @@unique([adAccountId, adCampaignId, date])
  @@index([storeId, date])
}

/// @stage S13 · PR 266 — the USD (or other) rate the owner types, applied to every cost figure from its date.
model ExchangeRate {
  id            String   @id @default(uuid(7)) @db.Uuid
  storeId       Int
  store         Store    @relation(fields: [storeId], references: [id])
  baseCurrency  String
  quoteCurrency String
  rate          Decimal  @db.Decimal(18, 6)
  effectiveFrom DateTime @db.Timestamptz(3)
  setById       String?  @db.Uuid
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)

  @@index([storeId, baseCurrency, quoteCurrency, effectiveFrom])
}

/// @stage S13 · PR 267 — an alert threshold the owner sets (cost per order, per delivered order …).
model AdAlertRule {
  id             String    @id @default(uuid(7)) @db.Uuid
  storeId        Int
  store          Store     @relation(fields: [storeId], references: [id])
  metric         String
  scope          Json?
  thresholdMinor Int?
  thresholdValue Decimal?  @db.Decimal(18, 4)
  enabled        Boolean   @default(false)
  archivedAt     DateTime? @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(3)
}

/// @stage S13 · PR 581 — guardrails enforced by code: target sales, max cost per purchase, budget ceilings, kill switch.
model AdGuardrail {
  id                  String   @id @default(uuid(7)) @db.Uuid
  storeId             Int
  store               Store    @relation(fields: [storeId], references: [id])
  adAccountId         String?  @db.Uuid
  targetSalesMinor    Int?
  maxCpaMinor         Int?
  dailyCeilingMinor   Int?
  monthlyCeilingMinor Int?
  allowAutoDecrease   Boolean  @default(false)
  killSwitch          Boolean  @default(false)
  createdAt           DateTime @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime @updatedAt @db.Timestamptz(3)
}

/// @stage S13 · PR 268, 531, 581 — a requested campaign change (pause, budget, create, duplicate, schedule). Budget
/// increases wait for the owner's approval.
model AdChangeRequest {
  id                String    @id @default(uuid(7)) @db.Uuid
  storeId           Int
  store             Store     @relation(fields: [storeId], references: [id])
  adCampaignId      String?   @db.Uuid
  action            String
  payload           Json
  reason            String?
  requestedByAgent  String?
  requestedById     String?   @db.Uuid
  status            String
  approvalRequestId String?   @db.Uuid
  appliedAt         DateTime? @db.Timestamptz(3)
  error             String?
  createdAt         DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @db.Timestamptz(3)
}

/// @stage S13 · PR 257, 258, 532 — a server-side conversion event (view → delivered), de-duplicated by event id.
model ServerEvent {
  id            String    @id @default(uuid(7)) @db.Uuid
  storeId       Int
  store         Store     @relation(fields: [storeId], references: [id])
  eventName     String
  eventId       String
  orderId       String?   @db.Uuid
  visitorId     String?
  valueMinor    Int?
  payload       Json
  platformsSent Json?
  status        String
  sentAt        DateTime? @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(3)

  @@unique([storeId, eventId])
  @@index([storeId, status, createdAt])
}

/// @stage S13 · PR 262–264 — an audience: segment-based, value-based lookalike, or the refused-parcel exclusion list.
model Audience {
  id          String    @id @default(uuid(7)) @db.Uuid
  storeId     Int
  store       Store     @relation(fields: [storeId], references: [id])
  name        String
  kind        String
  definition  Json
  segmentId   String?   @db.Uuid
  size        Int?
  lastBuiltAt DateTime? @db.Timestamptz(3)
  archivedAt  DateTime? @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)

  syncs AudienceSync[]
}

/// @stage S13 · PR 263, 264 — an audience pushed to one ad account.
model AudienceSync {
  id                 String    @id @default(uuid(7)) @db.Uuid
  storeId            Int
  store              Store     @relation(fields: [storeId], references: [id])
  audienceId         String    @db.Uuid
  audience           Audience  @relation(fields: [audienceId], references: [id])
  adAccountId        String    @db.Uuid
  externalAudienceId String?
  status             String
  memberCount        Int?
  syncedAt           DateTime? @db.Timestamptz(3)
  createdAt          DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @db.Timestamptz(3)

  @@unique([audienceId, adAccountId])
}

/// @stage S13 · PR 271, 272 — a coupon of any shape (percentage, fixed, free delivery, BOGO, shapes added later as data).
model Coupon {
  id               String    @id @default(uuid(7)) @db.Uuid
  storeId          Int
  store            Store     @relation(fields: [storeId], references: [id])
  code             String
  kind             String
  value            Json
  minOrderMinor    Int?
  maxDiscountMinor Int?
  usageLimit       Int?
  perCustomerLimit Int?
  usedCount        Int       @default(0)
  campaignId       String?   @db.Uuid
  ruleId           String?   @db.Uuid
  enabled          Boolean   @default(false)
  startsAt         DateTime? @db.Timestamptz(3)
  endsAt           DateTime? @db.Timestamptz(3)
  archivedAt       DateTime? @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @db.Timestamptz(3)

  redemptions CouponRedemption[]

  @@unique([storeId, code])
}

/// @stage S13 · PR 272 — one use of a coupon.
/// @append-only
model CouponRedemption {
  id            String   @id @default(uuid(7)) @db.Uuid
  storeId       Int
  store         Store    @relation(fields: [storeId], references: [id])
  couponId      String   @db.Uuid
  coupon        Coupon   @relation(fields: [couponId], references: [id])
  orderId       String   @db.Uuid
  customerId    String?  @db.Uuid
  phone         String?
  discountMinor Int
  createdAt     DateTime @default(now()) @db.Timestamptz(3)

  @@unique([couponId, orderId])
  @@index([couponId, phone])
}

/// @stage S13 · PR 273 — a referral.
model Referral {
  id                 String    @id @default(uuid(7)) @db.Uuid
  storeId            Int
  store              Store     @relation(fields: [storeId], references: [id])
  referrerCustomerId String    @db.Uuid
  code               String
  refereeCustomerId  String?   @db.Uuid
  orderId            String?   @db.Uuid
  rewardMinor        Int?
  status             String
  rewardedAt         DateTime? @db.Timestamptz(3)
  createdAt          DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @db.Timestamptz(3)

  @@unique([storeId, code])
}

/// @stage S13 · PR 275, 276 — a follow-up on an incomplete order or abandoned bag (capped by settings).
model RecoveryMessage {
  id                String              @id @default(uuid(7)) @db.Uuid
  storeId           Int
  store             Store               @relation(fields: [storeId], references: [id])
  kind              String
  checkoutDraftId   String?             @db.Uuid
  cartId            String?             @db.Uuid
  attempt           Int
  channel           NotificationChannel
  offerCouponId     String?             @db.Uuid
  notificationLogId String?             @db.Uuid
  recoveredOrderId  String?             @db.Uuid
  sentAt            DateTime?           @db.Timestamptz(3)
  createdAt         DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime            @updatedAt @db.Timestamptz(3)

  @@index([storeId, kind, createdAt])
}

/// @stage S13 · PR 277 — a campaign blast with its audience and throttle (consent respected, B5.7).
model Broadcast {
  id                String              @id @default(uuid(7)) @db.Uuid
  storeId           Int
  store             Store               @relation(fields: [storeId], references: [id])
  name              String
  channel           NotificationChannel
  audienceId        String?             @db.Uuid
  templateId        String?             @db.Uuid
  throttlePerMinute Int?
  scheduledAt       DateTime?           @db.Timestamptz(3)
  status            String
  sentCount         Int                 @default(0)
  failedCount       Int                 @default(0)
  costMinor         Int?
  createdById       String?             @db.Uuid
  createdAt         DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime            @updatedAt @db.Timestamptz(3)
}

/// @stage S13 · PR 278 — a YouTube channel connected to the store.
model YoutubeChannel {
  id            String    @id @default(uuid(7)) @db.Uuid
  storeId       Int
  store         Store     @relation(fields: [storeId], references: [id])
  externalId    String
  name          String
  integrationId String?   @db.Uuid
  archivedAt    DateTime? @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(3)

  videos YoutubeVideo[]

  @@unique([storeId, externalId])
}

/// @stage S13 · PR 278 — a video with the products it features and the orders it is credited with.
model YoutubeVideo {
  id               String         @id @default(uuid(7)) @db.Uuid
  storeId          Int
  store            Store          @relation(fields: [storeId], references: [id])
  channelId        String         @db.Uuid
  channel          YoutubeChannel @relation(fields: [channelId], references: [id])
  externalId       String
  title            String

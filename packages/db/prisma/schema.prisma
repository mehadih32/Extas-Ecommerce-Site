  costPerApprovedMinor Int?
  metrics              Json
  createdAt            DateTime @default(now()) @db.Timestamptz(3)
}

/// @stage S24 · PR 460; C1.5 — a recommendation note shown when the owner changes a setting away from the default.
/// @scope installation — system content shared by every screen.
model RecommendationNote {
  id         String   @id @default(uuid(7)) @db.Uuid
  key        String   @unique
  contextKey String
  conditions Json?
  noteEn     String
  noteBn     String?
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)
}

// =====================================================================================================================
// S25 · Video & Campaign Creative Studio — PR 481–490. Image-to-video from an approved still only (C8.1).
// =====================================================================================================================

/// @stage S25 · PR 481 — an action in the motion library (per category).
model MotionAction {
  id                  String    @id @default(uuid(7)) @db.Uuid
  storeId             Int
  store               Store     @relation(fields: [storeId], references: [id])
  key                 String
  name                String
  categoryId          String?   @db.Uuid
  spec                Json
  sharedWithAllStores Boolean   @default(false)
  archivedAt          DateTime? @db.Timestamptz(3)
  createdAt           DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime  @updatedAt @db.Timestamptz(3)

  @@unique([storeId, key])
}

/// @stage S25 · PR 482–484 — an image-to-video clip job (best-of-2), off by default per product.
model VideoJob {
  id             String          @id @default(uuid(7)) @db.Uuid
  storeId        Int
  store          Store           @relation(fields: [storeId], references: [id])
  productId      String?         @db.Uuid
  sourceAssetId  String          @db.Uuid
  actionId       String?         @db.Uuid
  provider       String?
  providerJobId  String?
  idempotencyKey String
  status         StudioJobStatus @default(DRAFT)
  durationSec    Int?
  aspect         String?
  attempt        Int             @default(1)
  estimateMinor  Int?
  actualMinor    Int?
  outputAssetId  String?         @db.Uuid
  requestedById  String?         @db.Uuid
  createdAt      DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime        @updatedAt @db.Timestamptz(3)

  @@unique([storeId, idempotencyKey])
}

/// @stage S25 · PR 485, 486 — a reel assembled from clips with music, text, logo and aspect variants.
model Reel {
  id             String    @id @default(uuid(7)) @db.Uuid
  storeId        Int
  store          Store     @relation(fields: [storeId], references: [id])
  title          String
  clipJobIds     String[]  @db.Uuid
  musicAssetId   String?   @db.Uuid
  overlays       Json?
  aspects        String[]
  status         String
  outputAssetIds String[]  @db.Uuid
  archivedAt     DateTime? @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(3)
}

/// @stage S25 · PR 489 — a campaign overlay drawn at display time (never burned into the product photo).
model CampaignOverlay {
  id          String    @id @default(uuid(7)) @db.Uuid
  storeId     Int
  store       Store     @relation(fields: [storeId], references: [id])
  campaignId  String?   @db.Uuid
  templateKey String
  design      Json
  appliesTo   Json
  enabled     Boolean   @default(false)
  startsAt    DateTime? @db.Timestamptz(3)
  endsAt      DateTime? @db.Timestamptz(3)
  archivedAt  DateTime? @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)
}

/// @stage S25 · PR 490 — the creative brief and the three directions the AI proposes before anything is produced.
model CreativeBrief {
  id              String   @id @default(uuid(7)) @db.Uuid
  storeId         Int
  store           Store    @relation(fields: [storeId], references: [id])
  campaignId      String?  @db.Uuid
  answers         Json
  directions      Json?
  chosenDirection Int?
  status          String
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)
}

/// @stage S25 · PR 487, 488 — a campaign creative export in every platform size, sent to an ad account or downloaded.
model CreativeExport {
  id                String   @id @default(uuid(7)) @db.Uuid
  storeId           Int
  store             Store    @relation(fields: [storeId], references: [id])
  campaignId        String?  @db.Uuid
  briefId           String?  @db.Uuid
  selection         Json
  sizes             String[]
  withOverlay       Boolean  @default(false)
  landingUrl        String?
  outputAssetIds    String[] @db.Uuid
  sentToAdAccountId String?  @db.Uuid
  status            String
  createdAt         DateTime @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @db.Timestamptz(3)
}


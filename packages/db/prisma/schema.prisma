// =====================================================================================================================
// S03 · Combo & bundles — PR 89–104, 571–576. Nothing is deleted and no combo URL dies (PR 571).
// =====================================================================================================================

/// @stage S03 · PR 89, 90, 571, 572, 573 — a combo / set listing (fixed set, colour pair, pack, or build-your-own).
model Combo {
  id              String         @id @default(uuid(7)) @db.Uuid
  storeId         Int
  store           Store          @relation(fields: [storeId], references: [id])
  autoRuleId      String?        @db.Uuid
  autoRule        ComboAutoRule? @relation(fields: [autoRuleId], references: [id])
  slug            String
  nameEn          String
  nameBn          String?
  type            ComboType
  pieceCount      Int
  /// Category page template (L1–L5) and product page template (C1/C2, P1–P5).
  listTemplateKey String?
  pageTemplateKey String?
  bagTemplateKey  String?
  setPriceMinor   Int?
  compareAtMinor  Int?
  status          ComboStatus    @default(DRAFT)
  startsAt        DateTime?      @db.Timestamptz(3)
  endsAt          DateTime?      @db.Timestamptz(3)
  /// Featured pairs are indexed; others are noindex,follow (PR 571 combo SEO).
  isFeatured      Boolean        @default(false)
  indexable       Boolean        @default(false)
  /// Canonical colour-order key for pair slugs (the reverse order 301s).
  colourOrderKey  String?
  setPhotoAssetId String?        @db.Uuid
  sortRank        Int            @default(0)
  endedAt         DateTime?      @db.Timestamptz(3)
  archivedAt      DateTime?      @db.Timestamptz(3)
  createdAt       DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @db.Timestamptz(3)
  /// S03 · PR 89, 90 — the short line under the name on the admin card and the combo page.
  descriptionEn   String?
  descriptionBn   String?
  /// PR 90 — when the bag holds every piece of this running fixed combo, the set price applies by itself (PR 97).
  autoApply       Boolean        @default(false)
  /// K11 — a one-product combo (a colour pair): may two of the same colour take the combo price?
  sameColour      Boolean        @default(false)
  /// PR 571 — a generated pair: its pieces as `productId.colourId` joined in the product's colour order (with
  /// `autoRuleId`, one row per pair for ever, so its link never dies).
  pieceKey        String?
  /// Optimistic lock for the admin editor, and who made and last changed it.
  version         Int            @default(1)
  createdById     String?        @db.Uuid
  updatedById     String?        @db.Uuid

  items        ComboItem[]
  popularPairs PopularPair[]
  dailyStats   ComboDailyStat[]

  @@unique([storeId, slug])
  @@unique([autoRuleId, pieceKey])
  @@index([storeId, status, sortRank])
}

enum ComboType {
  FIXED_SET
  COLOUR_PAIR
  TOP_BOTTOM
  MIXED_SET
  FIXED_COLOUR_PACK
  BUILD_YOUR_OWN
}

enum ComboStatus {
  DRAFT
  RUNNING
  PAUSED
  SOLD_OUT
  ENDED
}

/// @stage S03 · PR 89, 95 — one slot of a combo, with its allowed colours and sizes.
model ComboItem {
  id               String    @id @default(uuid(7)) @db.Uuid
  storeId          Int
  store            Store     @relation(fields: [storeId], references: [id])
  comboId          String    @db.Uuid
  combo            Combo     @relation(fields: [comboId], references: [id])
  position         Int
  productId        String?   @db.Uuid
  categoryId       String?   @db.Uuid
  fixedVariantId   String?   @db.Uuid
  allowedColourIds String[]  @db.Uuid
  allowedSizeIds   String[]  @db.Uuid
  quantity         Int       @default(1)
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @db.Timestamptz(3)
  /// S03 · PR 89 — a slot taken out of a fixed combo is archived, never deleted (CLAUDE.md rule 3).
  archivedAt       DateTime? @db.Timestamptz(3)
  /// The slot's own label on the combo page ("Top", "Bottom"); empty = the product's name.
  labelEn          String?
  labelBn          String?

  @@index([comboId, position])
}

/// @stage S03 · PR 571 — the auto colour-pair rule: bind a category or products, 2- or 3-piece, every pair becomes a combo.
model ComboAutoRule {
  id               String         @id @default(uuid(7)) @db.Uuid
  storeId          Int
  store            Store          @relation(fields: [storeId], references: [id])
  name             String
  sourceType       String
  sourceIds        String[]       @db.Uuid
  pieces           Int
  priceMinor       Int?
  compareAtMinor   Int?
  noSinglePiece    Boolean        @default(false)
  addOneMore       Boolean        @default(false)
  status           ComboStatus    @default(DRAFT)
  startsAt         DateTime?      @db.Timestamptz(3)
  endsAt           DateTime?      @db.Timestamptz(3)
  archivedAt       DateTime?      @db.Timestamptz(3)
  createdAt        DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime       @updatedAt @db.Timestamptz(3)
  // ---- S03 · PR 571 (the owner's model): `sourceIds` holds the bound categories, `productIds` the hand-picked
  // products; `priceMinor` is the fixed price of a pack (FIXED) and `percentOff` the share off the regular total
  // (PERCENT). `compareAtMinor` is never written: the struck price is always the sum of the pieces' own prices
  // (CN-009), worked out when it is shown.
  /// The rule's link (`/combos/<key>`); fixed once made, so a shared link keeps working.
  key              String
  nameBn           String?
  /// The style name on the cards ("Solid Polo"); empty = from the products.
  titleEn          String?
  titleBn          String?
  productIds       String[]       @db.Uuid
  pairing          ComboPairing   @default(STYLE)
  /// K11 — two pieces of the same colour may form a pair.
  sameColour       Boolean        @default(false)
  excludeColourIds String[]       @db.Uuid
  priceMode        ComboPriceMode @default(FIXED)
  percentOff       Int?
  sortMode         ComboSortMode  @default(BESTSELLERS)
  /// Pairs the owner pinned to the top (their `pieceKey`).
  pinnedKeys       String[]
  /// Season tab on the combo hub, a key of the `combos.seasons` setting.
  season           String?
  listTemplateKey  String?
  pageTemplateKey  String?
  bagTemplateKey   String?
  /// "Add 1 more → 3 pcs": the 3-piece rule a 2-piece pair grows into.
  upsellRuleId     String?        @db.Uuid
  lastGeneratedAt  DateTime?      @db.Timestamptz(3)
  version          Int            @default(1)
  createdById      String?        @db.Uuid
  updatedById      String?        @db.Uuid

  combos Combo[]

  @@unique([storeId, key])
  @@index([storeId, status])
}

/// @stage S03 · PR 571 — how an auto rule pairs its pieces: colours of the same style, one piece from each of different
/// styles, or any piece with any other.
enum ComboPairing {
  STYLE
  ACROSS
  ANY
}

/// @stage S03 · PR 571 — a pack price as a fixed amount or as a share off the regular total.
enum ComboPriceMode {
  FIXED
  PERCENT
}

/// @stage S03 · PR 571 — the order of the generated pairs: best sellers first, or the owner's colour order.
enum ComboSortMode {
  BESTSELLERS
  COLOUR
}

/// @stage S03 · PR 98, 99, 109, 212 — a "build your own set" tier rule (any 2 for X, any 3 for Y); also drives the bag
/// tier box. The prices are owner data entered in the admin.
/// Superseded by the Smart Rules `setTier` action (S10 · PR 212; S03 · PR 99 reads the set tiers from there): kept, not
/// written, so nothing is deleted.
model SetTierRule {
  id         String      @id @default(uuid(7)) @db.Uuid
  storeId    Int
  store      Store       @relation(fields: [storeId], references: [id])
  name       String
  scope      Json
  status     ComboStatus @default(DRAFT)
  showInBag  Boolean     @default(false)
  startsAt   DateTime?   @db.Timestamptz(3)
  endsAt     DateTime?   @db.Timestamptz(3)
  archivedAt DateTime?   @db.Timestamptz(3)
  createdAt  DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime    @updatedAt @db.Timestamptz(3)

  tiers SetTier[]
}

/// @stage S03 · PR 98 — one tier of a set rule.
model SetTier {
  id         String      @id @default(uuid(7)) @db.Uuid
  storeId    Int
  store      Store       @relation(fields: [storeId], references: [id])
  ruleId     String      @db.Uuid
  rule       SetTierRule @relation(fields: [ruleId], references: [id])
  quantity   Int
  priceMinor Int
  createdAt  DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime    @updatedAt @db.Timestamptz(3)

  @@unique([ruleId, quantity])
}

/// @stage S03 · PR 94, 104 — a popular colour pair on a combo (curated or learned from picks).
model PopularPair {
  id        String   @id @default(uuid(7)) @db.Uuid
  storeId   Int
  store     Store    @relation(fields: [storeId], references: [id])
  comboId   String   @db.Uuid
  combo     Combo    @relation(fields: [comboId], references: [id])
  colourIds String[] @db.Uuid
  rank      Int      @default(0)
  pickCount Int      @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  /// S03 · PR 104 — the picked colours as one sorted key, so a pick counts on the same row.
  colourKey String?

  @@unique([comboId, colourKey])
}

/// @stage S03 · PR 104 — one combo's day: page views, sets added to bags and colour picks, counted as they happen.
/// Orders, sets sold, revenue and the customers' saving are read from the order lines (OrderItem.comboId) when the
/// report is made.
model ComboDailyStat {
  id        String   @id @default(uuid(7)) @db.Uuid
  storeId   Int
  store     Store    @relation(fields: [storeId], references: [id])
  comboId   String   @db.Uuid
  combo     Combo    @relation(fields: [comboId], references: [id])
  /// The day in the store's time zone.
  day       DateTime @db.Date
  views     Int      @default(0)
  adds      Int      @default(0)
  picks     Int      @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@unique([comboId, day])
  @@index([storeId, day])
}

/// @stage S03 · PR 98, 100 — one "Build your own set" put into a bag: the tap's key (the same tap again is the same add),
/// the set tier rule it was built in and its pieces. The pieces go into the bag as ordinary lines, priced there by the
/// same Smart Rules set tiers; the amounts here are only what the builder showed at that moment (for the report).
/// @append-only
model SetBuilderAdd {
  id           String   @id @default(uuid(7)) @db.Uuid
  storeId      Int
  store        Store    @relation(fields: [storeId], references: [id])
  cartId       String   @db.Uuid
  addKey       String
  ruleId       String   @db.Uuid
  ruleKey      String
  variantIds   String[] @db.Uuid
  pieces       Int
  regularMinor Int
  payMinor     Int
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  @@unique([cartId, addKey])
  @@index([storeId, createdAt])
}

/// @stage S03 · PR 576 — the 100-point score of a combo template in the test matrix.
/// @append-only
model ComboTemplateScore {
  id          String   @id @default(uuid(7)) @db.Uuid
  storeId     Int
  store       Store    @relation(fields: [storeId], references: [id])
  templateKey String
  matrixKey   String
  score       Int
  details     Json
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  @@index([storeId, templateKey, createdAt])
}

// =====================================================================================================================
// S04 · Cart, checkout, accounts — PR 105–137, 558, 560, 561, 563, 565, 566.
// =====================================================================================================================

/// @stage S04 · PR 105 — a bag, kept across sessions.
model Cart {
  id               String     @id @default(uuid(7)) @db.Uuid
  storeId          Int
  store            Store      @relation(fields: [storeId], references: [id])
  customerId       String?    @db.Uuid
  customer         Customer?  @relation(fields: [customerId], references: [id])
  visitorId        String
  status           CartStatus @default(ACTIVE)
  couponCode       String?
  /// PR 110 — the customer's answers to the "same product in two sizes" card, by size group ("other", "keep", "help").
  sizeAnswers      Json?
  lastActivityAt   DateTime   @default(now()) @db.Timestamptz(3)
  convertedOrderId String?    @db.Uuid
  mergedIntoId     String?    @db.Uuid
  createdAt        DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime   @updatedAt @db.Timestamptz(3)

  items CartItem[]

  @@index([storeId, visitorId, status])
  @@index([storeId, customerId, status])
  @@index([storeId, status, lastActivityAt])
}

enum CartStatus {
  ACTIVE
  CONVERTED
  ABANDONED
  MERGED
}

/// @stage S04 · PR 105, 108, 97 — a bag line. A set is several lines sharing `comboGroupKey`, with the set price locked.
model CartItem {
  id             String    @id @default(uuid(7)) @db.Uuid
  storeId        Int
  store          Store     @relation(fields: [storeId], references: [id])
  cartId         String    @db.Uuid
  cart           Cart      @relation(fields: [cartId], references: [id])
  variantId      String    @db.Uuid
  quantity       Int
  unitPriceMinor Int
  comboId        String?   @db.Uuid
  comboGroupKey  String?
  setPriceMinor  Int?
  savedForLater  Boolean   @default(false)
  /// Where the add came from: offer, combo, set, upsell, order-now (PR 338 events).
  source         String?
  /// PR 105 — taken out of the bag (archived, never deleted: "Undo" brings the same line back).
  removedAt      DateTime? @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(3)

  @@index([cartId])
}

/// @stage S04 · PR 116, 117, 561 — a saved customer address, resolved against the gazetteer.
model CustomerAddress {
  id          String    @id @default(uuid(7)) @db.Uuid
  storeId     Int
  store       Store     @relation(fields: [storeId], references: [id])
  customerId  String    @db.Uuid
  customer    Customer  @relation(fields: [customerId], references: [id])
  label       String?
  name        String
  phone       String
  addressLine String
  areaId      String?   @db.Uuid
  area        GeoArea?  @relation(fields: [areaId], references: [id])
  postcode    String?
  isDefault   Boolean   @default(false)
  archivedAt  DateTime? @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)

  @@index([storeId, customerId])
  // PR 603: fuzzy address matching for the duplicate/fraud engine (PR 519).
  @@index([addressLine(ops: raw("gin_trgm_ops"))], type: Gin, map: "idx_address_line_trgm")
}

/// @stage S04 · PR 137, 274 — a started checkout, remembered field by field (autofill, incomplete-order capture).
model CheckoutDraft {
  id               String   @id @default(uuid(7)) @db.Uuid
  storeId          Int
  store            Store    @relation(fields: [storeId], references: [id])
  cartId           String?  @db.Uuid
  customerId       String?  @db.Uuid
  visitorId        String
  phone            String?
  name             String?
  email            String?
  addressText      String?
  areaId           String?  @db.Uuid
  data             Json?
  lastStep         String?
  lastActivityAt   DateTime @default(now()) @db.Timestamptz(3)
  convertedOrderId String?  @db.Uuid
  followUpCount    Int      @default(0)
  createdAt        DateTime @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @db.Timestamptz(3)

  flagEvents CheckoutFlagEvent[]

  @@index([storeId, phone])
  @@index([storeId, convertedOrderId, lastActivityAt])
}

/// @stage S04 · PR 558, 560 — the Parameter for Checkout: what counts as a flag, the layers, and what each asks for.
model CheckoutParameterLayer {
  id          String             @id @default(uuid(7)) @db.Uuid
  storeId     Int
  store       Store              @relation(fields: [storeId], references: [id])
  name        String
  position    Int
  conditions  Json
  requirement AdvanceRequirement
  /// PR 558: PART_AMOUNT only — the percentage of what is due asked ahead (1–99).
  partPercent Int?
  enabled     Boolean            @default(false)
  archivedAt  DateTime?          @db.Timestamptz(3)
  createdAt   DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime           @updatedAt @db.Timestamptz(3)

  events CheckoutFlagEvent[]

  @@index([storeId, archivedAt, position])
}

enum AdvanceRequirement {
  NONE
  DELIVERY_CHARGE
  FULL_AMOUNT
  PART_AMOUNT
}

/// @stage S06 · PR 562, 566 — a flagged checkout and its outcome (paid the advance or walked away): the number that tunes
/// the parameter, and the explanation support reads out.
/// @append-only
model CheckoutFlagEvent {
  id              String                  @id @default(uuid(7)) @db.Uuid
  storeId         Int
  store           Store                   @relation(fields: [storeId], references: [id])
  layerId         String?                 @db.Uuid
  layer           CheckoutParameterLayer? @relation(fields: [layerId], references: [id])
  checkoutDraftId String?                 @db.Uuid
  checkoutDraft   CheckoutDraft?          @relation(fields: [checkoutDraftId], references: [id])
  orderId         String?                 @db.Uuid
  customerId      String?                 @db.Uuid
  requirement     AdvanceRequirement
  outcome         String
  explanation     Json?
  createdAt       DateTime                @default(now()) @db.Timestamptz(3)

  @@index([storeId, createdAt])
}

/// @stage S04 · PR 606 — a bulk / corporate order enquiry (Blueprint B8.5 item 4; CN-017 SIM-F-023): from the bag, the
/// menu or its own page, with what he wants (the bag's lines or his own words), how many, a logo or not, and by when.
/// The team calls back and quotes it; the quote, its advance and the order it becomes are the Orders screen's (ORD-09).
/// `refNo` is the store's running enquiry number (shown with the setting's prefix). Nothing here prices or moves money.
model BulkEnquiry {
  id         String    @id @default(uuid(7)) @db.Uuid
  storeId    Int
  store      Store     @relation(fields: [storeId], references: [id])
  refNo      Int
  /// NEW · CONTACTED · QUOTED · WON · LOST — the team's own stage (the quote flow adds its own steps later).
  status     String    @default("NEW")
  name       String
  /// The mobile number in E.164 (phoneNormalizeBD), as every phone box stores it.
  phone      String
  email      String?
  company    String?
  /// The bag's lines when he came from the bag ([{ productId, variantId, name, colour, size, quantity }]); else empty.
  items      Json?
  /// What he wants, in his own words.
  itemsText  String?
  quantity   Int
  logo       Boolean   @default(false)
  neededBy   DateTime? @db.Date
  note       String?
  /// Where he came from: bag · menu · page.
  source     String
  lang       String
  visitorId  String?
  customerId String?   @db.Uuid
  ip         String?
  /// The order it became, once the quote is accepted (ORD-09).
  orderId    String?   @db.Uuid
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @db.Timestamptz(3)

  @@unique([storeId, refNo])
  @@index([storeId, status, createdAt])
  @@index([storeId, phone, createdAt])
  @@index([storeId, visitorId, createdAt])
}

// =====================================================================================================================
// S05 · Order management — PR 138–155, 541, 546. POS-ready from day one (A6.2): fulfilment type, optional customer,
// optional address and shipment, source SHOWROOM, CASH and split payments.
// =====================================================================================================================

/// @stage S05 · PR 138, 125, 140, 541, 563, 605; A6.2 — an order. Amounts are snapshots in minor units; IP and GPS expire after
/// the retention setting (PR 159, 302) via `piiExpiresAt`.
model Order {
  id                       String             @id @default(uuid(7)) @db.Uuid
  storeId                  Int
  store                    Store              @relation(fields: [storeId], references: [id])
  /// Human order number, unique per store.
  number                   String
  customerId               String?            @db.Uuid
  customer                 Customer?          @relation(fields: [customerId], references: [id])
  status                   OrderStatus        @default(PLACED)
  fulfillmentType          FulfillmentType    @default(DELIVERY)
  source                   OrderSource
  currency                 String
  placedAt                 DateTime           @default(now()) @db.Timestamptz(3)
  /// Contact and delivery snapshot as typed (PR 561: what he typed stays as he typed it).
  phone                    String?
  customerName             String?
  email                    String?
  shippingAddressText      String?
  /// The stored full address attached silently for packing (PR 561).
  backfilledAddress        String?
  areaId                   String?            @db.Uuid
  area                     GeoArea?           @relation(fields: [areaId], references: [id])
  deliveryBandId           String?            @db.Uuid
  deliveryBand             DeliveryBand?      @relation(fields: [deliveryBandId], references: [id])
  addressResolution        Json?
  /// PR 563: unresolved address still confirms, flagged "address unclear, charge not fixed".
  addressUnclear           Boolean            @default(false)
  chargeFixed              Boolean            @default(false)
  subtotalMinor            Int
  discountMinor            Int                @default(0)
  deliveryChargeMinor      Int                @default(0)
  walletAppliedMinor       Int                @default(0)
  totalMinor               Int
  codAmountMinor           Int                @default(0)
  paidMinor                Int                @default(0)
  advanceRequirement       AdvanceRequirement @default(NONE)
  paymentMethod            PaymentMethod?
  couponCode               String?
  /// Risk score and section, set the moment the order lands (PR 156, 541); never shown to the customer.
  riskScore                Int?
  riskBand                 String?
  riskSection              String?
  holdReason               String?
  onHoldSince              DateTime?          @db.Timestamptz(3)
  cancelReasonCode         String?
  confirmedAt              DateTime?          @db.Timestamptz(3)
  packedAt                 DateTime?          @db.Timestamptz(3)
  handedOverAt             DateTime?          @db.Timestamptz(3)
  deliveredAt              DateTime?          @db.Timestamptz(3)
  cancelledAt              DateTime?          @db.Timestamptz(3)
  returnedAt               DateTime?          @db.Timestamptz(3)
  /// Courier of the current shipment, denormalised for the order list filter (PR 140, 603).
  courierAccountId         String?            @db.Uuid
  orderGroupId             String?            @db.Uuid
  orderGroup               OrderGroup?        @relation(fields: [orderGroupId], references: [id])
  twoSizeStatus            String?
  customerEditCount        Int                @default(0)
  /// Marketing consent on this order, stored separately per channel (B5.7).
  smsMarketingConsent      Boolean?
  whatsappMarketingConsent Boolean?
  /// Attribution (PR 257, 532, 569) and the support r= reference (B4.6).
  utmSource                String?
  utmMedium                String?
  utmCampaign              String?
  adPlatform               String?
  adCampaignId             String?            @db.Uuid
  landingPageId            String?            @db.Uuid
  supportRefCode           String?
  referrer                 String?
  visitorId                String?
  ip                       String?
  deviceId                 String?
  gpsLat                   Decimal?           @db.Decimal(9, 6)
  gpsLng                   Decimal?           @db.Decimal(9, 6)
  piiExpiresAt             DateTime?          @db.Timestamptz(3)
  idempotencyKey           String
  erpOrderId               String?
  erpSyncStatus            String?
  shipAfter                DateTime?          @db.Timestamptz(3)
  note                     String?
  flags                    String[]
  archivedAt               DateTime?          @db.Timestamptz(3)
  createdAt                DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt                DateTime           @updatedAt @db.Timestamptz(3)
  /// PR 138 (§7.1 [ver], §6.6 S10) — optimistic locking: every order command adds one; a command sent with an older
  /// version is refused with STALE. The status itself is written only by @extas/orders (one order service).
  version                  Int                @default(0)
  /// PR 153 — the state the order was held from (release goes back to it) and the hold's reason code
  /// (`orders.hold.reasons`); `holdReason` keeps the note support reads.
  holdFromStatus           OrderStatus?
  holdReasonCode           String?
  /// PR 144 — the staff's note on a cancel (required for the reason OTHER); the code is `cancelReasonCode`.
  cancelNote               String?
  /// PR 144 (CN-020 (5)) — the customer asked to cancel after the one-tap cut-off, until booking; staff decide it.
  cancelRequestedAt        DateTime?          @db.Timestamptz(3)
  cancelRequestReason      String?
  /// PR 144 (§6.5.7, D5) — cancel after booking asked and waiting for the courier's answer; "courier could not cancel".
  cancelPending            Boolean            @default(false)
  customerWantsChange      Boolean            @default(false)
  /// PR 138 (§6.5.1, §6.6 S9; F-043) — AWAITING_ADVANCE: the amount the advance needs and when it is due (null: no
  /// deadline). Past it a person is asked to call; the order is never cancelled by itself.
  advanceRequiredMinor     Int?
  advanceDueAt             DateTime?          @db.Timestamptz(3)
  /// PR 147 — the staff's internal flags on the order (keys of `orders.flags.list`); never shown to the customer.
  internalFlags            String[]           @default([])
  /// PR 605 (CN-014 h, CN-020 (2), SIM-F-007) — a gift: the order's own name, phone and address are the RECEIVER's (the
  /// sticker, the booking and the courier's calls use them: @extas/orders deliveryTarget); the sender who pays is here,
  /// his contact (a phone of any country or an e-mail) used only for the order's updates. The gift note goes with the
  /// parcel; "deliver on or after" is a date in the store's time zone; prices are hidden on the receiver's invoice.
  isGift                   Boolean            @default(false)
  giftSenderName           String?
  giftSenderContact        String?
  giftNote                 String?
  giftDeliverAfter         DateTime?          @db.Date
  giftHidePrices           Boolean            @default(false)

  items     OrderItem[]
  events    OrderEvent[]
  notes     OrderNote[]
  payments  Payment[]
  shipments Shipment[]
  /// PR 407: the order's issued documents (its invoice, one row per version).
  documents GeneratedDocument[]

  @@unique([storeId, number])
  @@unique([storeId, idempotencyKey])
  // PR 603: order by phone — runs on every order for the fraud engine.
  @@index([storeId, phone, placedAt(sort: Desc)], map: "idx_order_phone")
  // PR 603: customer order history.
  @@index([storeId, customerId, placedAt(sort: Desc)], map: "idx_order_customer_history")
  // PR 603: order list filters — date, status, courier, store.
  @@index([storeId, placedAt(sort: Desc)], map: "idx_order_list_date")
  @@index([storeId, status, placedAt(sort: Desc)], map: "idx_order_list_status")
  @@index([storeId, courierAccountId, status, placedAt(sort: Desc)], map: "idx_order_list_courier")
  // PR 155 (follow-up 93, migration 0012): Sales = DELIVERED orders on the delivered day (@extas/metrics).
  @@index([storeId, status, deliveredAt], map: "idx_order_sales_delivered")
  // PR 603: fuzzy name and address with pg_trgm (duplicate/fraud engine, PR 519).
  @@index([customerName(ops: raw("gin_trgm_ops"))], type: Gin, map: "idx_order_name_trgm")
  @@index([shippingAddressText(ops: raw("gin_trgm_ops"))], type: Gin, map: "idx_order_address_trgm")
  @@index([piiExpiresAt])
  // PR 407: the invoice job finds orders changed since their invoice was last compared.
  @@index([storeId, updatedAt], map: "idx_order_updated")
}

enum OrderStatus {
  DRAFT
  PLACED
  /// PR 138 (§6.5.1, F-043): the risk level or a gift needs an advance first.
  AWAITING_ADVANCE
  CONFIRMED
  ON_HOLD
  PROCESSING
  PACKED
  HANDED_OVER
  IN_TRANSIT
  DELIVERED
  PARTIALLY_DELIVERED
  RETURNED
  CANCELLED
}

enum FulfillmentType {
  DELIVERY
  PICKUP
  COUNTER
}

enum OrderSource {
  WEBSITE
  LANDING_PAGE
  MESSENGER
  WHATSAPP
  LIVE_CHAT
  PHONE
  TELEGRAM
  ADMIN
  SHOWROOM
  IMPORT
}

/// @stage S05 · PR 138, 127 — an order line. Name, colour, size and price are snapshots; `isAddOn` marks "add to this
/// parcel" lines (PR 127).
model OrderItem {
  id             String          @id @default(uuid(7)) @db.Uuid
  storeId        Int
  store          Store           @relation(fields: [storeId], references: [id])
  orderId        String          @db.Uuid
  order          Order           @relation(fields: [orderId], references: [id])
  variantId      String?         @db.Uuid
  productId      String?         @db.Uuid
  sku            String
  productName    String
  colourName     String?
  sizeLabel      String?
  quantity       Int
  unitPriceMinor Int
  compareAtMinor Int?
  discountMinor  Int             @default(0)
  lineTotalMinor Int
  /// Cost snapshot from the ERP for per-order profit (A3.6).
  unitCostMinor  Int?
  comboId        String?         @db.Uuid
  comboGroupKey  String?
  isAddOn        Boolean         @default(false)
  status         OrderItemStatus @default(ACTIVE)
  addedVia       String?
  createdAt      DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime        @updatedAt @db.Timestamptz(3)

  @@index([orderId])
  @@index([storeId, productId, createdAt])
  @@index([storeId, variantId])
}

enum OrderItemStatus {
  ACTIVE
  REMOVED
  HELD_DAMAGED
  HELD_NOT_FOUND
  CANCELLED
  EXCHANGED
}

/// @stage S05 · PR 138, 139, 142 — the order timeline and its append-only audit: every change, from where, by whom.
/// @append-only
model OrderEvent {
  id         String       @id @default(uuid(7)) @db.Uuid
  storeId    Int
  store      Store        @relation(fields: [storeId], references: [id])
  orderId    String       @db.Uuid
  order      Order        @relation(fields: [orderId], references: [id])
  type       String
  fromStatus OrderStatus?
  toStatus   OrderStatus?
  message    String?
  data       Json?
  actorType  ActorType
  actorId    String?
  /// customer dashboard / admin / Telegram / support / system (B1.10).
  source     String
  /// PR 138 — the reason code of the change (cancel, hold, decision), when it has one; the note is `message`.
  reasonCode String?
  createdAt  DateTime     @default(now()) @db.Timestamptz(3)

  @@index([orderId, createdAt])
}

enum ActorType {
  STAFF
  CUSTOMER
  AI_AGENT
  SYSTEM
  COURIER
  ERP
}

/// @stage S05 · PR 147 — a note on an order (internal by default).
model OrderNote {
  id         String    @id @default(uuid(7)) @db.Uuid
  storeId    Int
  store      Store     @relation(fields: [storeId], references: [id])
  orderId    String    @db.Uuid
  order      Order     @relation(fields: [orderId], references: [id])
  body       String
  isInternal Boolean   @default(true)
  authorId   String?   @db.Uuid
  archivedAt DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @db.Timestamptz(3)

  // PR 147: an order's notes, newest first.
  @@index([orderId, createdAt])
}

/// @stage S06 · PR 522; B1.12 — several orders from one identity grouped into one parcel.
model OrderGroup {
  id          String   @id @default(uuid(7)) @db.Uuid
  storeId     Int
  store       Store    @relation(fields: [storeId], references: [id])
  reason      String
  note        String?
  createdById String?  @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  orders Order[]
}

/// @stage S05 · PR 545, 563, 146 — the call queue for the AI or an employee: unclear address, new-customer verification,
/// confirmation call, advance request, two-size check.
model CallTask {
  id           String      @id @default(uuid(7)) @db.Uuid
  storeId      Int
  store        Store       @relation(fields: [storeId], references: [id])
  orderId      String?     @db.Uuid
  customerId   String?     @db.Uuid
  reason       String
  status       QueueStatus @default(OPEN)
  assignedToId String?     @db.Uuid
  agentKey     String?
  dueAt        DateTime?   @db.Timestamptz(3)
  outcome      String?
  notes        String?
  closedAt     DateTime?   @db.Timestamptz(3)
  createdAt    DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime    @updatedAt @db.Timestamptz(3)

  @@index([storeId, status, dueAt])
}

/// @stage S14 · PR 148, 505 — a message template (SMS, WhatsApp, email, Telegram), every word editable.
model NotificationTemplate {
  id                 String              @id @default(uuid(7)) @db.Uuid
  storeId            Int
  store              Store               @relation(fields: [storeId], references: [id])
  key                String
  channel            NotificationChannel
  locale             String
  name               String
  subject            String?
  body               String
  /// Meta-approved WhatsApp template name / SMS masking template id.
  providerTemplateId String?
  enabled            Boolean             @default(false)
  archivedAt         DateTime?           @db.Timestamptz(3)
  createdAt          DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime            @updatedAt @db.Timestamptz(3)
  /// PR 291, 292 — the provider's word on `providerTemplateId` (WhatsApp: Meta's review; SMS: the gateway's registered
  /// text for the masking name): PENDING, APPROVED, REJECTED or PAUSED; null = never sent for approval.
  providerStatus     String?
  /// PR 291, 292 — the provider's reason for a refusal (a short line), when it gave one.
  providerReason     String?
  /// PR 292 — when the state was last read from the provider (or set by a person).
  providerCheckedAt  DateTime?           @db.Timestamptz(3)

  rules NotificationRule[]

  @@unique([storeId, key, channel, locale])
}

enum NotificationChannel {
  SMS
  WHATSAPP
  EMAIL
  TELEGRAM
  PUSH
  MESSENGER
}

/// @stage S14 · PR 148, 505 — which event sends which template on which channel (the owner's 2 SMS + 1 WhatsApp rule;
/// later steps exist as switches, off).
model NotificationRule {
  id         String               @id @default(uuid(7)) @db.Uuid
  storeId    Int
  store      Store                @relation(fields: [storeId], references: [id])
  eventKey   String
  channel    NotificationChannel
  templateId String               @db.Uuid
  template   NotificationTemplate @relation(fields: [templateId], references: [id])
  enabled    Boolean              @default(false)
  conditions Json?
  createdAt  DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime             @updatedAt @db.Timestamptz(3)

  @@unique([storeId, eventKey, channel])
}

/// @stage S05 · PR 148, 149 — the notification log with retries and the no-double-send guard (`dedupeKey`).
/// PR 148 (CN-019): one row per message the shop means to send — an order-journey step on one channel
/// (`order:<orderId>:<step>:<channel>`), so a step never goes twice — planned from the order's timeline by
/// @extas/messages and sent by the worker once `sendAfter` has passed. No message text is stored (the template and the
/// order make it again); `reason` says why a row was skipped or blocked by the guard (cap, audience, no number …).
model NotificationLog {
  id                String                @id @default(uuid(7)) @db.Uuid
  storeId           Int
  store             Store                 @relation(fields: [storeId], references: [id])
  orderId           String?               @db.Uuid
  customerId        String?               @db.Uuid
  broadcastId       String?               @db.Uuid
  channel           NotificationChannel
  templateId        String?               @db.Uuid
  recipient         String
  status            NotificationStatus    @default(QUEUED)
  dedupeKey         String
  providerMessageId String?
  attempts          Int                   @default(0)
  error             String?
  costMinor         Int?
  sentAt            DateTime?             @db.Timestamptz(3)
  createdAt         DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime              @updatedAt @db.Timestamptz(3)
  /// PR 148 — the journey step (`placed`, `confirmed`, `day1Care` …) or what else the message is for (`account.code`).
  step              String?
  /// PR 148 — the language the message goes in (`bn`, `en`).
  locale            String?
  /// PR 148, 149 — not sent before this time: the step's delay, the quiet hours, or the next try after a failure.
  sendAfter         DateTime?             @db.Timestamptz(3)
  /// PR 148 — why a row was SKIPPED or BLOCKED_BY_GUARD (a code: CAP_SMS, AUDIENCE, NO_RECIPIENT, MASTER_OFF …).
  reason            String?
  /// PR 148 — the sender that took it: its provider key and mode (MOCK = "would send": nothing left the server).
  provider          String?
  mode              AdapterMode?
  /// PR 148 — the order timeline row (OrderEvent) that planned it.
  eventId           String?               @db.Uuid
  /// PR 149 — every try at sending it, with its result (append-only).
  tries             NotificationAttempt[]
  /// PR 291 — how many SMS parts the text took (the gateway counts each part; Bengali parts are shorter).
  segments          Int?
  /// PR 291, 292 — when the provider said the message reached the phone (its delivery receipt).
  deliveredAt       DateTime?             @db.Timestamptz(3)
  /// PR 291, 292 — the provider's own last word on it (`delivered`, `read`, `failed 131026` …), from its receipt.
  providerStatus    String?

  @@unique([storeId, dedupeKey])
  @@index([storeId, orderId])
  @@index([storeId, status, createdAt])
  @@index([status, sendAfter])
  @@index([provider, providerMessageId])
}

/// @stage S05 · PR 149 — one try at sending a message: the sender (provider and mode), the result, the provider's
/// message id and cost, and who asked for it when staff retried by hand. A retry is a new row; a row is never changed
/// (append-only, locked at the database). No message text is stored.
/// @append-only
model NotificationAttempt {
  id                String              @id @default(uuid(7)) @db.Uuid
  storeId           Int
  store             Store               @relation(fields: [storeId], references: [id])
  notificationLogId String              @db.Uuid
  notificationLog   NotificationLog     @relation(fields: [notificationLogId], references: [id])
  /// 1 for the first try, then 2, 3 …
  attempt           Int
  channel           NotificationChannel
  provider          String?
  mode              AdapterMode?
  ok                Boolean
  /// Why it failed (a short line from the sender), or null.
  error             String?
  providerMessageId String?
  costMinor         Int?
  /// The staff member who asked for this try (Messages › log › Retry), or null for the engine's own tries.
  retriedById       String?             @db.Uuid
  createdAt         DateTime            @default(now()) @db.Timestamptz(3)

  @@unique([notificationLogId, attempt])
  @@index([storeId, createdAt])
}

enum NotificationStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
  SKIPPED
  BLOCKED_BY_GUARD
}

// =====================================================================================================================
// S06 · Fraud & location — PR 156–164, 502, 519–524, 540, 542–545, 549–557, 559, 562, 567.
// Governing rules: nothing is ever blocked automatically; a genuine order is never trapped; the delivery charge is never
// computed from free text, only from a resolved gazetteer entry.
// =====================================================================================================================

/// @stage S06 · PR 549 — the national gazetteer: division → district → upazila/thana → area, with Bengali, English and
/// Banglish spellings, postcodes and coordinates.
/// @scope installation — shared reference data for every store; bands and charges are per store (DeliveryBand).
model GeoArea {
  id              String    @id @default(uuid(7)) @db.Uuid
  level           GeoLevel
  parentId        String?   @db.Uuid
  parent          GeoArea?  @relation("GeoTree", fields: [parentId], references: [id])
  children        GeoArea[] @relation("GeoTree")
  ancestorIds     String[]  @db.Uuid
  /// The importer's stable key (PR 549), e.g. `bd.rajshahi.bogura.gabtali`: one row per code, so a re-import updates.
  code            String?   @unique
  nameEn          String
  nameBn          String?
  /// Alternate spellings (Gabtali ↔ Gabtoli, Bogra ↔ Bogura); prefix matching only (PR 552).
  aliases         String[]
  postcodes       String[]
  /// DNCC / DSCC where the area is inside Dhaka City (PR 550).
  cityCorporation String?
  lat             Decimal?  @db.Decimal(9, 6)
  lng             Decimal?  @db.Decimal(9, 6)
  archivedAt      DateTime? @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(3)

  bandMappings      AreaBand[]
  courierMappings   CourierAreaMapping[]
  customerAddresses CustomerAddress[]
  orders            Order[]

  @@index([parentId])
  @@index([level, nameEn])
  @@index([aliases], type: Gin)
  @@index([postcodes], type: Gin)
}

enum GeoLevel {
  DIVISION
  DISTRICT
  UPAZILA
  THANA
  AREA
}

/// @stage S06 · PR 502, 550, 565 — a delivery charge band (Dhaka City · Sub-area · Rest of Bangladesh). The charge, COD
/// limit and delivery hours are owner-set values in this row.
model DeliveryBand {
  id            String    @id @default(uuid(7)) @db.Uuid
  storeId       Int
  store         Store     @relation(fields: [storeId], references: [id])
  key           String
  nameEn        String
  nameBn        String?
  chargeMinor   Int
  codLimitMinor Int?
  hoursMin      Int?
  hoursMax      Int?
  /// Sub-area mode: own charge · folded into Dhaka City · folded into outside.
  mode          String?
  enabled       Boolean   @default(false)
  sortOrder     Int       @default(0)
  archivedAt    DateTime? @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(3)

  areas  AreaBand[]
  orders Order[]

  @@unique([storeId, key])
}

/// @stage S06 · PR 550 — one band per area per store (the owner's sub-area list is the only exception to the map).
model AreaBand {
  id         String       @id @default(uuid(7)) @db.Uuid
  storeId    Int
  store      Store        @relation(fields: [storeId], references: [id])
  areaId     String       @db.Uuid
  area       GeoArea      @relation(fields: [areaId], references: [id])
  bandId     String       @db.Uuid
  band       DeliveryBand @relation(fields: [bandId], references: [id])
  /// Taken off the owner's list: the row stays (hard rule 3); adding the area again brings the same row back.
  archivedAt DateTime?    @db.Timestamptz(3)
  createdAt  DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime     @updatedAt @db.Timestamptz(3)

  @@unique([storeId, areaId])
}

/// @stage S06 · PR 554 — our gazetteer mapped to each courier's own city/zone/area ids.
model CourierAreaMapping {
  id               String         @id @default(uuid(7)) @db.Uuid
  storeId          Int
  store            Store          @relation(fields: [storeId], references: [id])
  courierAccountId String         @db.Uuid
  courierAccount   CourierAccount @relation(fields: [courierAccountId], references: [id])
  areaId           String         @db.Uuid
  area             GeoArea        @relation(fields: [areaId], references: [id])
  courierCityId    String?
  courierZoneId    String?
  courierAreaId    String?
  syncedAt         DateTime?      @db.Timestamptz(3)
  createdAt        DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime       @updatedAt @db.Timestamptz(3)
  /// PR 554 — who made the mapping: `auto` (the zone sync matched the names exactly) or `staff` (a person picked the
  /// courier's place; a sync never changes it); how it was matched; who mapped it. A mapping whose courier place was
  /// dropped from the courier's list is archived with the reason (`courierDropped`; a person's `staff`), never deleted,
  /// and the sync brings it back when the courier lists the place again.
  source           String         @default("staff")
  matchedBy        String?
  mappedById       String?        @db.Uuid
  archivedAt       DateTime?      @db.Timestamptz(3)
  archivedReason   String?

  @@unique([courierAccountId, areaId])
}

/// @stage S06 · PR 554 — one place of a courier's own list (a city, a zone of a city, an area of a zone), as the courier
/// itself names it, read by the courier zone sync. A place the courier no longer lists is archived, never deleted, and
/// comes back with the same row when the courier lists it again.
model CourierPlace {
  id               String            @id @default(uuid(7)) @db.Uuid
  storeId          Int
  store            Store             @relation(fields: [storeId], references: [id])
  courierAccountId String            @db.Uuid
  courierAccount   CourierAccount    @relation(fields: [courierAccountId], references: [id])
  level            CourierPlaceLevel
  /// The courier's own id of the place (text, whatever the courier uses).
  providerId       String
  /// The courier ids above it: the city of a zone; the city and the zone of an area.
  cityId           String?
  zoneId           String?
  name             String
  /// The name as the matcher reads it (lower case, letters and digits only; PR 554 `placeKey`).
  nameKey          String
  /// The start of the last sync that saw the place in the courier's list.
  lastSeenAt       DateTime          @db.Timestamptz(3)
  archivedAt       DateTime?         @db.Timestamptz(3)
  createdAt        DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime          @updatedAt @db.Timestamptz(3)

  @@unique([courierAccountId, level, providerId])
  @@index([courierAccountId, nameKey])
  @@index([courierAccountId, level, cityId])
}

enum CourierPlaceLevel {
  CITY
  ZONE
  AREA
}

/// @stage S06 · PR 554 — one run of the courier zone sync for a courier account: asked by a person or due by the
/// owner's interval, read level by level within a budget of calls (the walk left is kept in `cursor`, so a long list
/// is read over several runs), and only a complete read archives the places the courier dropped.
model CourierZoneSync {
  id               String           @id @default(uuid(7)) @db.Uuid
  storeId          Int
  store            Store            @relation(fields: [storeId], references: [id])
  courierAccountId String           @db.Uuid
  courierAccount   CourierAccount   @relation(fields: [courierAccountId], references: [id])
  status           BackgroundStatus @default(QUEUED)
  mode             AdapterMode?
  requestedById    String?          @db.Uuid
  startedAt        DateTime?        @db.Timestamptz(3)
  finishedAt       DateTime?        @db.Timestamptz(3)
  cursor           Json?
  stats            Json?
  error            String?
  createdAt        DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime         @updatedAt @db.Timestamptz(3)

  @@index([courierAccountId, createdAt])
  @@index([storeId, status])
}

/// @stage S06 · PR 519 — one identity built from phone, name, address, IP and device (a customer who changes his number
/// is still the same person).
model IdentityCluster {
  id                String    @id @default(uuid(7)) @db.Uuid
  storeId           Int
  store             Store     @relation(fields: [storeId], references: [id])
  primaryCustomerId String?   @db.Uuid
  confidence        Float?
  mergedIntoId      String?   @db.Uuid
  archivedAt        DateTime? @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @db.Timestamptz(3)

  links IdentityLink[]
}

/// @stage S06 · PR 519, 603 — one signal value tied to an identity (normalised phone, name, address, IP, device, PSID).
model IdentityLink {
  id          String          @id @default(uuid(7)) @db.Uuid
  storeId     Int
  store       Store           @relation(fields: [storeId], references: [id])
  clusterId   String          @db.Uuid
  cluster     IdentityCluster @relation(fields: [clusterId], references: [id])
  kind        IdentityKind
  valueNorm   String
  orderId     String?         @db.Uuid
  confidence  Float?
  firstSeenAt DateTime        @default(now()) @db.Timestamptz(3)
  lastSeenAt  DateTime        @default(now()) @db.Timestamptz(3)
  /// IP and device values expire with the retention setting (PR 159).
  expiresAt   DateTime?       @db.Timestamptz(3)
  createdAt   DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime        @updatedAt @db.Timestamptz(3)

  @@index([storeId, kind, valueNorm])
  @@index([valueNorm(ops: raw("gin_trgm_ops"))], type: Gin, map: "idx_identity_value_trgm")
}

enum IdentityKind {
  PHONE
  NAME
  ADDRESS
  EMAIL
  IP
  DEVICE
  MESSENGER_PSID
  WHATSAPP_ID
}

/// @stage S06 · PR 156 — a risk signal and its owner-set weight.
model RiskSignalConfig {
  id         String    @id @default(uuid(7)) @db.Uuid
  storeId    Int
  store      Store     @relation(fields: [storeId], references: [id])
  key        String
  labelEn    String
  labelBn    String?
  weight     Int
  enabled    Boolean   @default(false)
  archivedAt DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @db.Timestamptz(3)

  @@unique([storeId, key])
}

/// @stage S06 · PR 156, 161 — a risk band (owner thresholds) and the actions it triggers: watch, hold, confirmation call,
/// delivery charge in advance, full advance, COD off.
model RiskBand {
  id         String    @id @default(uuid(7)) @db.Uuid
  storeId    Int
  store      Store     @relation(fields: [storeId], references: [id])
  key        String
  labelEn    String
  labelBn    String?
  minScore   Int
  maxScore   Int
  actions    Json
  enabled    Boolean   @default(false)
  archivedAt DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @db.Timestamptz(3)

  @@unique([storeId, key])
}

/// @stage S06 · PR 156, 160 — a risk score with the reasons it is what it is.
/// @append-only
model RiskAssessment {
  id              String   @id @default(uuid(7)) @db.Uuid
  storeId         Int
  store           Store    @relation(fields: [storeId], references: [id])
  orderId         String?  @db.Uuid
  checkoutDraftId String?  @db.Uuid
  phone           String?
  score           Int
  bandKey         String?
  signals         Json
  modelVersion    String?
  createdAt       DateTime @default(now()) @db.Timestamptz(3)

  @@index([storeId, orderId])
  @@index([storeId, phone, createdAt])
}

/// @stage S06 · PR 520, 524, 544 — a duplicate / re-order / fraud rule (scenarios A–M). Actions: cancel · hold · warn ·
/// allow. There is no block action.
model FraudRule {
  id                  String          @id @default(uuid(7)) @db.Uuid
  storeId             Int
  store               Store           @relation(fields: [storeId], references: [id])
  key                 String
  scenario            String?
  nameEn              String
  nameBn              String?
  windowHours         Int?
  confidenceThreshold Int?
  action              FraudRuleAction
  config              Json?
  enabled             Boolean         @default(false)
  archivedAt          DateTime?       @db.Timestamptz(3)
  createdAt           DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime        @updatedAt @db.Timestamptz(3)

  alerts FraudAlert[]

  @@unique([storeId, key])
}

enum FraudRuleAction {
  CANCEL
  HOLD
  WARN
  ALLOW
}

/// @stage S06 · PR 521, 541 — an alert: which rule fired, the matching orders, the rider's note, the decision.
model FraudAlert {
  id              String           @id @default(uuid(7)) @db.Uuid
  storeId         Int
  store           Store            @relation(fields: [storeId], references: [id])
  ruleId          String?          @db.Uuid
  rule            FraudRule?       @relation(fields: [ruleId], references: [id])
  orderId         String           @db.Uuid
  matchedOrderIds String[]         @db.Uuid
  severity        String?
  confidence      Int?
  proposedAction  FraudRuleAction
  status          FraudAlertStatus @default(OPEN)
  summary         Json?
  decidedById     String?          @db.Uuid
  decisionReason  String?
  decidedAt       DateTime?        @db.Timestamptz(3)
  createdAt       DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @db.Timestamptz(3)

  @@index([storeId, status, createdAt])
  @@index([orderId])
}

enum FraudAlertStatus {
  OPEN
  APPROVED
  DECLINED
  OVERRIDDEN
  AUTO_RESOLVED
}

/// @stage S06 · PR 543 — every approve/decline by the owner, an employee or the AI, with the reason (the learning loop).
/// @append-only
model FraudDecision {
  id        String    @id @default(uuid(7)) @db.Uuid
  storeId   Int
  store     Store     @relation(fields: [storeId], references: [id])
  alertId   String?   @db.Uuid
  orderId   String?   @db.Uuid
  decision  String
  reason    String?
  actorType ActorType
  actorId   String?
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  @@index([storeId, createdAt])
}

/// @stage S06 · PR 162, 163, 523 — the block register. The AI only proposes; a human blocks, and every block can be undone.
model BlockEntry {
  id                String      @id @default(uuid(7)) @db.Uuid
  storeId           Int
  store             Store       @relation(fields: [storeId], references: [id])
  identityClusterId String?     @db.Uuid
  customerId        String?     @db.Uuid
  phone             String?
  status            BlockStatus @default(PROPOSED)
  reason            String
  nameGiven         String?
  addressGiven      String?
  productsOrdered   Json?
  rejectionCount    Int         @default(0)
  proposedByAgent   String?
  proposedAt        DateTime    @default(now()) @db.Timestamptz(3)
  blockedById       String?     @db.Uuid
  blockedAt         DateTime?   @db.Timestamptz(3)
  unblockedById     String?     @db.Uuid
  unblockedAt       DateTime?   @db.Timestamptz(3)
  createdAt         DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime    @updatedAt @db.Timestamptz(3)

  @@index([storeId, status])
  @@index([storeId, phone])
}

enum BlockStatus {
  PROPOSED
  BLOCKED
  REJECTED
  UNBLOCKED
}

/// @stage S06 · PR 559, 567 — a cached result from a courier's fraud check (Steadfast, Pathao, aggregators) for a phone.
model CourierFraudCheck {
  id             String   @id @default(uuid(7)) @db.Uuid
  storeId        Int
  store          Store    @relation(fields: [storeId], references: [id])
  phone          String
  provider       String
  deliveredCount Int?
  cancelledCount Int?
  result         Json?
  ok             Boolean
  checkedAt      DateTime @default(now()) @db.Timestamptz(3)
  expiresAt      DateTime @db.Timestamptz(3)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  @@index([storeId, phone, checkedAt])
}

/// @stage S06 · PR 556, 557 — each firing of the in-transit duplicate notice, with the campaign that brought the customer.
/// @append-only
model DuplicateNoticeEvent {
  id              String   @id @default(uuid(7)) @db.Uuid
  storeId         Int
  store           Store    @relation(fields: [storeId], references: [id])
  phone           String
  existingOrderId String   @db.Uuid
  productId       String?  @db.Uuid
  variantId       String?  @db.Uuid
  differentSize   Boolean  @default(false)
  action          String
  campaignRef     String?
  utm             Json?
  createdAt       DateTime @default(now()) @db.Timestamptz(3)

  @@index([storeId, createdAt])
}

// =====================================================================================================================
// S07 · Payments & wallet — PR 165–174. Card data is never stored (the gateway holds it).
// =====================================================================================================================

/// @stage S07 · PR 165, 166, 170, 173 — a payment (split payments are several rows). Reconciliation fields included.
model Payment {
  id                   String         @id @default(uuid(7)) @db.Uuid
  storeId              Int
  store                Store          @relation(fields: [storeId], references: [id])
  orderId              String?        @db.Uuid
  order                Order?         @relation(fields: [orderId], references: [id])
  method               PaymentMethod
  provider             String?
  purpose              PaymentPurpose
  status               PaymentStatus  @default(INITIATED)
  amountMinor          Int
  currency             String
  gatewayFeeMinor      Int?
  providerRef          String?
  providerTrxId        String?
  idempotencyKey       String
  paidAt               DateTime?      @db.Timestamptz(3)
  /// Free text kept for history; PR 165 writes `moneyStatus` instead (§6.6 S11: the old column stays, nothing writes it).
  reconciliationStatus String?
  reconciledAt         DateTime?      @db.Timestamptz(3)
  erpSyncedAt          DateTime?      @db.Timestamptz(3)
  createdAt            DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime       @updatedAt @db.Timestamptz(3)
  /// PR 165 (§6.5.3, §6.6 S11) — where the money stands (null while none has come in): PROVISIONAL from the gateway's
  /// answer or a staff record, RECONCILED once matched to a statement (PR 174), FINAL at the month close.
  moneyStatus          MoneyStatus?
  /// PR 165 (F-040) — the staff member who recorded money received outside the checkout (bKash to the merchant number,
  /// a bank transfer); null for a gateway payment.
  recordedById         String?        @db.Uuid
  /// PR 165 — the try of this order's payment for this purpose (1, 2 … after "Try again"; SIM-F-026).
  attempt              Int            @default(1)
  /// PR 165 — what the gateway (or the staff record) says really came in, in minor units; null until money is in.
  receivedMinor        Int?
  /// PR 165, 170 — why the payment failed or closed: the gateway's code, CUSTOMER_CANCELLED, ABANDONED (no answer in time).
  failureCode          String?
  /// PR 165 (SIM-F-028) — the reason code of a mismatch on this payment (AMOUNT_DIFFERS, PAID_AFTER_CLOSE, DUPLICATE_PAYMENT …);
  /// a mismatch is never silent.
  mismatchReason       String?
  /// PR 165 — when the status last changed (the abandoned-payment sweep reads it).
  statusAt             DateTime?      @db.Timestamptz(3)
  /// PR 165 — the staff's note on a recorded payment.
  note                 String?
  /// S06 · PR 542 — the pay link of an advance a person asked for from the order (`/pay/<linkToken>`): a random token,
  /// the same on every try of that request ("Try again" makes a new payment row with the same token), never an id.
  linkToken            String?

  refunds Refund[]

  @@unique([storeId, idempotencyKey])
  @@index([storeId, orderId])
  @@index([provider, providerTrxId])
  // PR 170: the open payments the sweep looks at, oldest first
  @@index([storeId, status, createdAt])
  // PR 542: the pay link's page finds its payment by the token
  @@index([linkToken])
}

/// PR 165 (§6.5.3) — where an amount of money stands, shared by payments, COD collections and settlement lines (and later
/// the cost ledger and P&L): ESTIMATED from a rate card, PROVISIONAL from an event, RECONCILED when matched to a
/// settlement or statement, FINAL when the month is closed and pushed. It only moves forward.
enum MoneyStatus {
  ESTIMATED
  PROVISIONAL
  RECONCILED
  FINAL
}

/// PR 125 (S04): the checkout's methods (PR 120) — Rocket and Upay among the mobile wallets, and the one "Pay online"
/// page — are added; the exact wallet or card type the customer picked is kept on the Payment (`provider`).
enum PaymentMethod {
  COD
  BKASH
  NAGAD
  CARD
  CASH
  WALLET
  BANK_TRANSFER
  ROCKET
  UPAY
  ONLINE
}

enum PaymentPurpose {
  ORDER
  ADVANCE_DELIVERY_CHARGE
  FULL_ADVANCE
  EXCHANGE_DIFFERENCE
  PREORDER_ADVANCE
  /// also S06 · PR 542: a part of the amount due asked first from the order (the owner's percent, `risk.levels.partialPercent`).
  PART_ADVANCE
}

enum PaymentStatus {
  INITIATED
  PENDING
  AUTHORIZED
  PAID
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

/// @stage S07 · PR 542 — a payment link sent by SMS, WhatsApp or in chat.
model PaymentLink {
  id          String         @id @default(uuid(7)) @db.Uuid
  storeId     Int
  store       Store          @relation(fields: [storeId], references: [id])
  orderId     String?        @db.Uuid
  paymentId   String?        @db.Uuid
  provider    String
  url         String
  amountMinor Int
  purpose     PaymentPurpose
  sentVia     String?
  status      String
  expiresAt   DateTime?      @db.Timestamptz(3)
  createdById String?        @db.Uuid
  createdAt   DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime       @updatedAt @db.Timestamptz(3)
}

/// @stage S07 · PR 166 — a courier COD settlement (what the courier paid us for a period).
model CourierSettlement {
  id                 String         @id @default(uuid(7)) @db.Uuid
  storeId            Int
  store              Store          @relation(fields: [storeId], references: [id])
  courierAccountId   String         @db.Uuid
  courierAccount     CourierAccount @relation(fields: [courierAccountId], references: [id])
  reference          String
  periodFrom         DateTime?      @db.Timestamptz(3)
  periodTo           DateTime?      @db.Timestamptz(3)
  totalCodMinor      Int
  chargesMinor       Int
  netMinor           Int
  receivedAt         DateTime?      @db.Timestamptz(3)
  status             String
  createdAt          DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime       @updatedAt @db.Timestamptz(3)
  /// PR 166 (§6.5.5, §6.6 S5; CN-021 P16) — how the payout reached us (BANK, BKASH, CASH_AT_COURIER_OFFICE) and the account
  /// Accounts posts it to; the imported file's hash (the same file twice is one settlement); who imported it.
  receivedAs         String?
  receivedAccountRef String?
  fileHash           String?
  importedById       String?        @db.Uuid

  lines CourierSettlementLine[]

  @@unique([courierAccountId, reference])
  @@unique([courierAccountId, fileHash])
}

/// @stage S07 · PR 166 — one parcel on a COD settlement.
model CourierSettlementLine {
  id                  String            @id @default(uuid(7)) @db.Uuid
  storeId             Int
  store               Store             @relation(fields: [storeId], references: [id])
  settlementId        String            @db.Uuid
  settlement          CourierSettlement @relation(fields: [settlementId], references: [id])
  orderId             String?           @db.Uuid
  shipmentId          String?           @db.Uuid
  consignmentId       String?
  codMinor            Int
  chargeMinor         Int
  createdAt           DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime          @updatedAt @db.Timestamptz(3)
  /// PR 166 (§6.5.5, §6.6 S4; SIM-F-028) — the line as the courier's file had it (its row and status words), what we
  /// expected (cash and charge, from our own records), the match with its reason code, the days the money took to
  /// arrive, where the money stands, and how a person resolved a mismatch. A parcel is on one settled line per kind:
  /// a second line for the same parcel is kept without its shipment and marked DOUBLE_LINE.
  lineNo              Int               @default(0)
  kind                String            @default("COD")
  courierStatus       String?
  expectedMinor       Int?
  expectedChargeMinor Int?
  matchState          SettlementMatch?
  reasonCode          String?
  settleDays          Int?
  moneyStatus         MoneyStatus?
  resolvedAt          DateTime?         @db.Timestamptz(3)
  resolvedById        String?           @db.Uuid
  resolutionNote      String?

  @@unique([storeId, shipmentId, kind])
  @@index([settlementId, lineNo])
  @@index([storeId, matchState])
}

/// PR 166 (§6.5.5; SIM-F-028) — how a settlement line stands against our records: MATCHED, MISMATCH (always with a reason
/// code), or LATE (the money is right but came after the owner's limit).
enum SettlementMatch {
  MATCHED
  MISMATCH
  LATE
}

/// @stage S07 · PR 166 — what the rider did at the door and the money with it (SIM-F-001, SIM-F-005, SIM-F-028): one row per
/// outcome the courier reports or the team records — delivered, partly delivered (kept pieces; our approval when the
/// owner's setting asks for it), returned with the delivery charge paid, returned, attempt failed. What we expected the
/// rider to collect (the order's live amount due, never the total: a paid customer is never asked again), what he
/// collected, the charge collected, and the reason of every difference. The money stays PROVISIONAL until the courier's
/// settlement line matches it. Order status and stock are moved by their own services (S08), never here.
model CodCollection {
  id                   String             @id @default(uuid(7)) @db.Uuid
  storeId              Int
  store                Store              @relation(fields: [storeId], references: [id])
  orderId              String             @db.Uuid
  shipmentId           String?            @db.Uuid
  outcome              CodOutcome
  state                CodCollectionState @default(RECORDED)
  expectedMinor        Int
  collectedMinor       Int
  chargeCollectedMinor Int                @default(0)
  varianceReason       String?
  keptItemIds          String[]           @default([]) @db.Uuid
  returnedItemIds      String[]           @default([]) @db.Uuid
  note                 String?
  /// Who reported it: courier (an event), staff (typed from the rider's report), system.
  source               String
  recordedById         String?            @db.Uuid
  decidedById          String?            @db.Uuid
  decidedAt            DateTime?          @db.Timestamptz(3)
  decisionNote         String?
  moneyStatus          MoneyStatus        @default(PROVISIONAL)
  settlementLineId     String?            @db.Uuid
  idempotencyKey       String
  occurredAt           DateTime           @db.Timestamptz(3)
  createdAt            DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime           @updatedAt @db.Timestamptz(3)

  @@unique([storeId, idempotencyKey])
  @@index([storeId, orderId])
  @@index([storeId, state, occurredAt])
  @@index([shipmentId])
}

/// PR 166 (SIM-F-005) — the door outcomes with money: every one the couriers support, each with its own money effect.
enum CodOutcome {
  DELIVERED
  PARTIAL
  RETURNED_CHARGE_PAID
  RETURNED
  ATTEMPT_FAILED
}

/// PR 166 — a recorded door outcome: RECORDED, or PENDING_APPROVAL (a partial delivery while the owner's setting asks
/// for our approval) → APPROVED / REJECTED.
enum CodCollectionState {
  RECORDED
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

/// @stage S07 · PR 171 — a customer's wallet (store credit; works at the counter too, A6.2).
model WalletAccount {
  id           String   @id @default(uuid(7)) @db.Uuid
  storeId      Int
  store        Store    @relation(fields: [storeId], references: [id])
  customerId   String   @unique @db.Uuid
  customer     Customer @relation(fields: [customerId], references: [id])
  /// Cached; the ledger below is the truth.
  balanceMinor Int      @default(0)
  status       String
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  entries WalletEntry[]
}

/// @stage S07 · PR 171, 172 — the wallet ledger.
/// @append-only
model WalletEntry {
  id                String          @id @default(uuid(7)) @db.Uuid
  storeId           Int
  store             Store           @relation(fields: [storeId], references: [id])
  walletId          String          @db.Uuid
  wallet            WalletAccount   @relation(fields: [walletId], references: [id])
  direction         LedgerDirection
  amountMinor       Int
  balanceAfterMinor Int
  reason            String
  orderId           String?         @db.Uuid
  exchangeId        String?         @db.Uuid
  idempotencyKey    String
  note              String?
  actorId           String?
  createdAt         DateTime        @default(now()) @db.Timestamptz(3)
  /// PR 171 (migration 0038) — a correction is a new entry the other way, never an edit: the entry this one reverses
  /// (an entry is reversed at most once).
  reversesEntryId   String?         @unique @db.Uuid

  @@unique([walletId, idempotencyKey])
  @@index([walletId, createdAt])
  @@index([storeId, reason, createdAt])
}

enum LedgerDirection {
  CREDIT
  DEBIT
}

/// @stage S07 · PR 172 — a refund (only before dispatch, B3.6). Needs the owner's OK (CLAUDE.md rule 6).
model Refund {
  id                String       @id @default(uuid(7)) @db.Uuid
  storeId           Int
  store             Store        @relation(fields: [storeId], references: [id])
  orderId           String       @db.Uuid
  paymentId         String?      @db.Uuid
  payment           Payment?     @relation(fields: [paymentId], references: [id])
  amountMinor       Int
  method            String
  reason            String
  status            RefundStatus @default(REQUESTED)
  approvalRequestId String?      @db.Uuid
  requestedById     String?      @db.Uuid
  approvedById      String?      @db.Uuid
  completedAt       DateTime?    @db.Timestamptz(3)
  createdAt         DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime     @updatedAt @db.Timestamptz(3)
  /// PR 144 (§6.6 S1; F-041) — what made the request (CANCEL, …) and its key: one request per cause, never two. A
  /// request moves no money; approving and paying it is the owner's (CLAUDE.md rule 6, PR 172).
  source            String?
  idempotencyKey    String?
  /// PR 172 (migration 0038; §6.5.4 facts 4a/4b, F-041) — the requester's note; the approver's decision (when, and
  /// why); who paid it out and how: the wallet entry of a refund to the wallet, or the reference of money a person sent
  /// back by hand (a bKash send-money, a bank transfer) — nothing is paid out by itself; why a payout failed.
  note              String?
  decidedAt         DateTime?    @db.Timestamptz(3)
  decisionNote      String?
  executedById      String?      @db.Uuid
  walletEntryId     String?      @db.Uuid
  payoutReference   String?
  failureNote       String?

  @@unique([storeId, idempotencyKey])
  @@index([storeId, orderId])
  @@index([storeId, status, createdAt])
}

enum RefundStatus {
  REQUESTED
  APPROVED
  REJECTED
  COMPLETED
  FAILED
}

/// @stage S07 · PR 174 — a gateway statement imported for reconciliation.
model GatewayStatement {
  id           String   @id @default(uuid(7)) @db.Uuid
  storeId      Int
  store        Store    @relation(fields: [storeId], references: [id])
  provider     String
  periodFrom   DateTime @db.Timestamptz(3)
  periodTo     DateTime @db.Timestamptz(3)
  fileAssetId  String?  @db.Uuid
  status       String
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)
  /// PR 174 (migration 0038; SIM-F-028) — the gateway's own statement reference, the imported file's hash (the same
  /// file twice is one statement), who imported it, and the statement's own totals (money in and the gateway's fees).
  reference    String?
  fileHash     String?
  importedById String?  @db.Uuid
  totalMinor   Int      @default(0)
  feesMinor    Int      @default(0)

  lines GatewayStatementLine[]

  @@unique([storeId, provider, fileHash])
  @@unique([storeId, provider, reference])
}

/// @stage S07 · PR 174 — one statement line and what it matched.
model GatewayStatementLine {
  id               String           @id @default(uuid(7)) @db.Uuid
  storeId          Int
  store            Store            @relation(fields: [storeId], references: [id])
  statementId      String           @db.Uuid
  statement        GatewayStatement @relation(fields: [statementId], references: [id])
  providerTrxId    String
  amountMinor      Int
  feeMinor         Int?
  occurredAt       DateTime?        @db.Timestamptz(3)
  matchedPaymentId String?          @db.Uuid
  matchStatus      String
  createdAt        DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime         @updatedAt @db.Timestamptz(3)
  /// PR 174 (migration 0038; SIM-F-028) — the line's row in the file, whether it is money in (PAYMENT) or money back
  /// (REFUND), what our own record expected, the reason code of every mismatch, and how a person resolved it. A payment
  /// is on one statement line only: a second line for it is kept without the payment and marked DOUBLE_LINE.
  lineNo           Int              @default(0)
  kind             String           @default("PAYMENT")
  expectedMinor    Int?
  reasonCode       String?
  resolvedAt       DateTime?        @db.Timestamptz(3)
  resolvedById     String?          @db.Uuid
  resolutionNote   String?

  @@unique([storeId, matchedPaymentId, kind])
  @@index([statementId, matchStatus])
  @@index([storeId, providerTrxId])
  @@index([storeId, matchStatus])
}

// =====================================================================================================================
// S08 · Courier, returns, exchange — PR 175–193, 525–526, 564. The consignment number and barcode always come from the
// courier; the shop never generates them (B1.1).
// =====================================================================================================================

/// @stage S08 · PR 175, 176, 177, 365 — a courier account of a store (Steadfast, Pathao, RedX …).
model CourierAccount {
  id            String    @id @default(uuid(7)) @db.Uuid
  storeId       Int
  store         Store     @relation(fields: [storeId], references: [id])
  providerKey   String
  name          String
  integrationId String?   @db.Uuid
  enabled       Boolean   @default(false)
  archivedAt    DateTime? @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(3)

  rateCards    CourierRateCard[]
  shipments    Shipment[]
  areaMappings CourierAreaMapping[]
  settlements  CourierSettlement[]
  handovers    HandoverBatch[]
  places       CourierPlace[]
  zoneSyncs    CourierZoneSync[]

  @@unique([storeId, providerKey, name])
}

/// @stage S08 · PR 178 — what this courier really charges us per destination and weight (the shop's cost only, never the
/// customer's charge).
model CourierRateCard {
  id                String         @id @default(uuid(7)) @db.Uuid
  storeId           Int
  store             Store          @relation(fields: [storeId], references: [id])
  courierAccountId  String         @db.Uuid
  courierAccount    CourierAccount @relation(fields: [courierAccountId], references: [id])
  zoneKey           String
  weightFromGrams   Int
  weightToGrams     Int
  chargeMinor       Int
  codFeeBps         Int?
  returnChargeMinor Int?
  validFrom         DateTime       @db.Timestamptz(3)
  validTo           DateTime?      @db.Timestamptz(3)
  createdAt         DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime       @updatedAt @db.Timestamptz(3)

  @@index([courierAccountId, zoneKey, validFrom])
}

/// @stage S08 · PR 176, 179, 180, 184 — a booked parcel. Reprinting a sticker never creates a second shipment.
model Shipment {
  id                  String         @id @default(uuid(7)) @db.Uuid
  storeId             Int
  store               Store          @relation(fields: [storeId], references: [id])
  orderId             String         @db.Uuid
  order               Order          @relation(fields: [orderId], references: [id])
  courierAccountId    String         @db.Uuid
  courierAccount      CourierAccount @relation(fields: [courierAccountId], references: [id])
  consignmentId       String?
  trackingCode        String?
  status              ShipmentStatus @default(BOOKING)
  providerStatus      String?
  chargeMinor         Int?
  codAmountMinor      Int            @default(0)
  codCollectedMinor   Int?
  weightGrams         Int?
  isExchangeLeg       Boolean        @default(false)
  exchangeId          String?        @db.Uuid
  labelPrintCount     Int            @default(0)
  bookedAt            DateTime?      @db.Timestamptz(3)
  pickedAt            DateTime?      @db.Timestamptz(3)
  deliveredAt         DateTime?      @db.Timestamptz(3)
  returnedAt          DateTime?      @db.Timestamptz(3)
  idempotencyKey      String
  erpSyncedAt         DateTime?      @db.Timestamptz(3)
  createdAt           DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime       @updatedAt @db.Timestamptz(3)
  /// PR 144 (§6.5.7, §6.6 S18; D5) — cancel after booking: asked (CANCEL_REQUESTED), then the courier's answer as a
  /// separate step: who recorded it, when, the courier's reference, and the outcome (CONFIRMED or REFUSED).
  cancelRequestedAt   DateTime?      @db.Timestamptz(3)
  cancelConfirmedById String?        @db.Uuid
  cancelConfirmedAt   DateTime?      @db.Timestamptz(3)
  cancelRef           String?
  cancelOutcome       String?
  /// PR 175 (§7.4, SIM-F-017, SIM-F-027) — the booking as it was sent: the adapter's mode (a MOCK parcel is practice and
  /// never a real cost), the try number, the shop's reference the courier knows the parcel by, the declared value, the
  /// courier's own city / zone / area ids, the receiver block and the note sent, why a booking failed, the courier's
  /// latest exception reason, when tracking last read it, and who booked it.
  mode                AdapterMode?
  attempt             Int            @default(1)
  merchantRef         String?
  declaredValueMinor  Int?
  courierCityId       String?
  courierZoneId       String?
  courierAreaId       String?
  receiver            Json?
  bookingNote         String?
  bookingError        String?
  exceptionKey        String?
  lastTrackedAt       DateTime?      @db.Timestamptz(3)
  bookedById          String?        @db.Uuid

  events ShipmentEvent[]

  @@unique([storeId, idempotencyKey])
  @@unique([courierAccountId, consignmentId])
  @@index([storeId, status, bookedAt])
  @@index([orderId])
}

enum ShipmentStatus {
  BOOKING
  IN_REVIEW
  PENDING_PICKUP
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  PARTIALLY_DELIVERED
  RETURNING
  RETURNED
  CANCELLED
  BOOKING_FAILED
  /// PR 144 (§6.5.7, D5): cancel after booking asked; staff phone the courier and record the answer.
  CANCEL_REQUESTED
  /// PR 175 (§6.5.2, SIM-F-017): the courier's exceptions — a delivery try failed (receiver unreachable, not at home),
  /// the address is a problem, the parcel is lost, the parcel is damaged. Recorded and shown; nothing moves money.
  ATTEMPT_FAILED
  ADDRESS_PROBLEM
  LOST
  DAMAGED
}

/// @stage S08 · PR 184 — a courier status event with its time and the rider's note.
/// @append-only
model ShipmentEvent {
  id              String         @id @default(uuid(7)) @db.Uuid
  storeId         Int
  store           Store          @relation(fields: [storeId], references: [id])
  shipmentId      String         @db.Uuid
  shipment        Shipment       @relation(fields: [shipmentId], references: [id])
  status          ShipmentStatus
  rawStatus       String?
  message         String?
  riderNote       String?
  occurredAt      DateTime       @db.Timestamptz(3)
  createdAt       DateTime       @default(now()) @db.Timestamptz(3)
  /// PR 175 (§7.4, §7.7) — the courier's own id of the event (a poll or a webhook), so one event is stored once; the
  /// reason of an exception (`courier.reasons`); where it came from (booking, poll, webhook, staff); what the courier
  /// sent with it (the amount it says it collected, its charge, the raw words); the staff member who recorded it.
  providerEventId String?
  reasonKey       String?
  source          String         @default("courier")
  data            Json?
  actorId         String?        @db.Uuid

  @@unique([shipmentId, providerEventId])
  @@index([shipmentId, occurredAt])
}

/// @stage S08 · PR 180 — a sticker / picking-list / handover print job (reprints reuse the stored consignment).
model PrintJob {
  id          String           @id @default(uuid(7)) @db.Uuid
  storeId     Int
  store       Store            @relation(fields: [storeId], references: [id])
  kind        DocumentKind
  orderIds    String[]         @db.Uuid
  isReprint   Boolean          @default(false)
  documentId  String?          @db.Uuid
  status      BackgroundStatus @default(QUEUED)
  actorId     String?          @db.Uuid
  printedAt   DateTime?        @db.Timestamptz(3)
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @db.Timestamptz(3)
  /// PR 180 (B1.5) — the parcels printed (a sticker print), the reason a reprint was asked for, the key of the press
  /// (a repeated press returns the same job and counts nothing twice), what was printed (each parcel's print number),
  /// and the handover batch a handover sheet belongs to.
  shipmentIds String[]         @default([]) @db.Uuid
  reason      String?
  requestKey  String?
  data        Json?
  batchId     String?          @db.Uuid

  @@unique([storeId, requestKey])
  @@index([storeId, createdAt])
}

/// @stage S08 · PR 180 — the handover sheet: parcels given to a courier.
model HandoverBatch {
  id               String         @id @default(uuid(7)) @db.Uuid
  storeId          Int
  store            Store          @relation(fields: [storeId], references: [id])
  courierAccountId String         @db.Uuid
  courierAccount   CourierAccount @relation(fields: [courierAccountId], references: [id])
  shipmentIds      String[]       @db.Uuid
  handedOverAt     DateTime?      @db.Timestamptz(3)
  receivedBy       String?
  documentId       String?        @db.Uuid
  createdById      String?        @db.Uuid
  createdAt        DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime       @updatedAt @db.Timestamptz(3)
  /// PR 180 (B1.5) — the orders on the sheet, who marked the batch handed over, how many times the sheet was printed,
  /// and what the sheet showed (each parcel's consignment and amount to collect when it was printed).
  orderIds         String[]       @default([]) @db.Uuid
  handedOverById   String?        @db.Uuid
  printCount       Int            @default(0)
  data             Json?

  @@index([storeId, courierAccountId, createdAt])
}

/// @stage S08 · PR 183; B1.2 — Damaged / Not found at packing, and its resolution. Never auto-cancelled.
model PackingIssue {
  id               String    @id @default(uuid(7)) @db.Uuid
  storeId          Int
  store            Store     @relation(fields: [storeId], references: [id])
  orderId          String    @db.Uuid
  orderItemId      String    @db.Uuid
  kind             String
  resolution       String?
  markedById       String?   @db.Uuid
  resolvedById     String?   @db.Uuid
  resolvedAt       DateTime? @db.Timestamptz(3)
  badStockPushedAt DateTime? @db.Timestamptz(3)
  note             String?
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @db.Timestamptz(3)

  @@index([storeId, resolvedAt])
}

/// @stage S08 · PR 182 — one piece checked at the packing table: its SKU scanned (or typed when the scanner is off, or
/// ticked when the owner packs without scanning) against an order line. Rows are only added: a wrong scan is never
/// stored (it is refused), and a line counts as checked once its scans reach its quantity.
/// @append-only
model PackingScan {
  id          String   @id @default(uuid(7)) @db.Uuid
  storeId     Int
  store       Store    @relation(fields: [storeId], references: [id])
  orderId     String   @db.Uuid
  orderItemId String   @db.Uuid
  sku         String
  quantity    Int      @default(1)
  /// scan · typed · tick
  source      String
  scannedById String?  @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  @@index([storeId, orderId])
}

/// @stage S08 · PR 182 (CN-014c, SIM-F-010) — a packing proof photo of an order's parcel, kept for the owner's number of
/// days (`keepUntil`), then archived by the daily sweep (never deleted).
model PackingPhoto {
  id           String    @id @default(uuid(7)) @db.Uuid
  storeId      Int
  store        Store     @relation(fields: [storeId], references: [id])
  orderId      String    @db.Uuid
  mediaAssetId String    @db.Uuid
  takenById    String?   @db.Uuid
  keepUntil    DateTime? @db.Timestamptz(3)
  archivedAt   DateTime? @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(3)

  @@index([storeId, orderId])
  @@index([storeId, keepUntil])
}

/// @stage S08 · PR 182 — an order's packing check: the scale reading against the pieces' own weights (follow-up 434),
/// a big gap the packer confirmed, and the owner's override of a required photo with its reason (SIM-F-010).
model PackingCheck {
  id                 String    @id @default(uuid(7)) @db.Uuid
  storeId            Int
  store              Store     @relation(fields: [storeId], references: [id])
  orderId            String    @db.Uuid
  weighedGrams       Int?
  expectedGrams      Int?
  weighedById        String?   @db.Uuid
  weighedAt          DateTime? @db.Timestamptz(3)
  weightGapConfirmed Boolean   @default(false)
  photoWaivedReason  String?
  photoWaivedById    String?   @db.Uuid
  photoWaivedAt      DateTime? @db.Timestamptz(3)
  createdAt          DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @db.Timestamptz(3)

  @@unique([storeId, orderId])
}

/// @stage S08 · PR 185–190 — an exchange (size issue, defect, damage or wrong item) with its tier and money box.
model Exchange {
  id                   String         @id @default(uuid(7)) @db.Uuid
  storeId              Int
  store                Store          @relation(fields: [storeId], references: [id])
  orderId              String         @db.Uuid
  customerId           String?        @db.Uuid
  number               String
  status               ExchangeStatus @default(REQUESTED)
  reason               String
  tier                 Int
  isOurMistake         Boolean        @default(false)
  priceDifferenceMinor Int            @default(0)
  deliveryChargeMinor  Int            @default(0)
  walletCreditMinor    Int            @default(0)
  codToCollectMinor    Int            @default(0)
  photoAssetIds        String[]       @db.Uuid
  windowEndsAt         DateTime?      @db.Timestamptz(3)
  newOrderId           String?        @db.Uuid
  qcById               String?        @db.Uuid
  qcAt                 DateTime?      @db.Timestamptz(3)
  completedAt          DateTime?      @db.Timestamptz(3)
  erpSyncedAt          DateTime?      @db.Timestamptz(3)
  createdAt            DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime       @updatedAt @db.Timestamptz(3)
  /// PR 185 (B1.8; migration 0044) — the reason's note, the root cause of a wrong item (SIM-F-022), the order's
  /// delivery band when the charge was read, who opened it and from where, its key (one exchange per press) and its
  /// version (two people never decide it at once). `newOrderId` is the linked exchange order (one per exchange).
  reasonNote           String?
  rootCause            String?
  bandKey              String?
  source               String         @default("admin")
  createdById          String?        @db.Uuid
  idempotencyKey       String?
  version              Int            @default(0)
  decidedById          String?        @db.Uuid
  decidedAt            DateTime?      @db.Timestamptz(3)
  decisionNote         String?
  /// PR 187 — the wallet credit of a cheaper swap, recorded as a refund REQUEST after QC passes (no money moves).
  refundId             String?        @db.Uuid
  /// PR 190 (CN-018 (5), CN-014e) — who pays the second delivery charge and why: SET (the customer, for his own size
  /// choice), NOT_SET (no charge figure yet), FREE_OUR_MISTAKE, WAIVED (staff, with a logged reason), CLAIM_ACCEPTED
  /// (his "your mistake" claim approved by staff) or ONE_TRIP (the one-trip size swap price). The claim's note and photos
  /// (`photoAssetIds`), who decided it; the waiver's reason and who gave it.
  chargeState          String?
  chargePayer          String?
  oneTrip              Boolean        @default(false)
  claimState           String?
  claimNote            String?
  claimDecidedById     String?        @db.Uuid
  claimDecidedAt       DateTime?      @db.Timestamptz(3)
  waiveReason          String?
  waivedById           String?        @db.Uuid
  waivedAt             DateTime?      @db.Timestamptz(3)

  items ExchangeItem[]

  @@unique([storeId, number])
  @@unique([storeId, idempotencyKey])
  @@unique([newOrderId])
  @@index([storeId, status])
  @@index([storeId, orderId])
}

enum ExchangeStatus {
  REQUESTED
  APPROVED
  PICKUP_BOOKED
  RECEIVED
  QC_PASSED
  QC_FAILED
  COMPLETED
  REJECTED
  CANCELLED
}

/// @stage S08 · PR 187, 188 — one item swapped, with its QC result and restock / write-off.
model ExchangeItem {
  id                  String    @id @default(uuid(7)) @db.Uuid
  storeId             Int
  store               Store     @relation(fields: [storeId], references: [id])
  exchangeId          String    @db.Uuid
  exchange            Exchange  @relation(fields: [exchangeId], references: [id])
  originalOrderItemId String    @db.Uuid
  newVariantId        String?   @db.Uuid
  quantity            Int
  qcStatus            QcStatus?
  restockAction       String?
  createdAt           DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime  @updatedAt @db.Timestamptz(3)
  /// PR 185, 188 (migration 0044) — the swap as it was priced: the old piece and the new one with their prices then,
  /// the new piece's words for the timeline, its tier (1 same colour · 2 other colours · 3 same category · 4 other), and
  /// the SKU that is really coming back (SIM-F-022: a wrong item returns what was packed, not what was ordered).
  oldVariantId        String?   @db.Uuid
  oldSku              String?
  oldUnitMinor        Int       @default(0)
  newSku              String?
  newUnitMinor        Int       @default(0)
  newName             String?
  newColourName       String?
  newSizeLabel        String?
  tier                Int?
  receivedSku         String?
}

enum QcStatus {
  GOOD
  B_GRADE
  DAMAGED
}

/// @stage S08 · PR 189, 191, 525, 526 — a parcel that came back (refused at the door, returned, charge-paid return), the
/// rider's reason, and what was really received.
model ReturnRecord {
  id              String       @id @default(uuid(7)) @db.Uuid
  storeId         Int
  store           Store        @relation(fields: [storeId], references: [id])
  orderId         String       @db.Uuid
  shipmentId      String?      @db.Uuid
  customerId      String?      @db.Uuid
  kind            ReturnKind
  reasonCode      String?
  riderNote       String?
  chargePaidMinor Int          @default(0)
  courierClaim    String?
  actualOutcome   String?
  mismatch        Boolean      @default(false)
  receivedAt      DateTime?    @db.Timestamptz(3)
  erpSyncedAt     DateTime?    @db.Timestamptz(3)
  createdAt       DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime     @updatedAt @db.Timestamptz(3)
  /// PR 187, 189, 191 (§6.5.4 D4; migration 0044) — where the parcel is (EXPECTED → RECEIVED → QC_DONE → CLOSED), whether
  /// the shop caused it (never counted against the customer, SIM-F-044), the exchange it belongs to (an exchange
  /// pick-up), its key, who received and closed it, and the staff's note.
  status          ReturnStatus @default(EXPECTED)
  ourFault        Boolean      @default(false)
  exchangeId      String?      @db.Uuid
  idempotencyKey  String?
  receivedById    String?      @db.Uuid
  closedAt        DateTime?    @db.Timestamptz(3)
  closedById      String?      @db.Uuid
  note            String?
  version         Int          @default(0)

  items ReturnItem[]

  @@unique([storeId, idempotencyKey])
  @@index([storeId, customerId])
  @@index([storeId, kind, createdAt])
  @@index([storeId, status])
  @@index([storeId, orderId])
}

enum ReturnKind {
  REFUSED_AT_DOOR
  RETURNED
  CHARGE_PAID_RETURN
  DEFECT_RETURN
  /// PR 185 — the old piece of an exchange, picked up when the new one is delivered.
  EXCHANGE_PICKUP
}

/// PR 187, 189 (§6.5.4) — a return's place: on its way, at the shop, every piece checked, closed.
enum ReturnStatus {
  EXPECTED
  RECEIVED
  QC_DONE
  CLOSED
}

/// PR 187 (§6.5.4 D4) — what QC decided for a piece: sellable again (the ERP restocks it) or not (a loss).
enum ReturnDisposition {
  SELLABLE
  UNSELLABLE
}

/// PR 187 (§6.5.4 D4) — where a decided piece stands: sent to the ERP and waiting, restocked, the ERP refused or never
/// answered, no ERP connected (nothing to restock), or written off as a loss.
enum DispositionState {
  ERP_PENDING
  RESTOCKED
  ERP_FAILED
  NO_ERP
  LOSS_RECORDED
}

/// @stage S08 · PR 189 — an item on a return with its QC result.
model ReturnItem {
  id               String             @id @default(uuid(7)) @db.Uuid
  storeId          Int
  store            Store              @relation(fields: [storeId], references: [id])
  returnId         String             @db.Uuid
  returnRecord     ReturnRecord       @relation(fields: [returnId], references: [id])
  orderItemId      String             @db.Uuid
  quantity         Int
  qcStatus         QcStatus?
  createdAt        DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime           @updatedAt @db.Timestamptz(3)
  /// PR 187 (§6.5.4; SIM-F-022; migration 0044) — the SKU expected back and the SKU scanned at QC (what is restocked is
  /// always what was scanned), the piece's disposition and where it stands, the loss reason and its cost entry, the ERP
  /// document, who checked it and when, the photos and the note. `exchangeItemId`: the exchange line it closes.
  variantId        String?            @db.Uuid
  exchangeItemId   String?            @db.Uuid
  expectedSku      String?
  scannedSku       String?
  disposition      ReturnDisposition?
  dispositionState DispositionState?
  lossReason       String?
  lossCostEntryId  String?            @db.Uuid
  erpPushId        String?            @db.Uuid
  qcById           String?            @db.Uuid
  qcAt             DateTime?          @db.Timestamptz(3)
  photoAssetIds    String[]           @db.Uuid
  note             String?

  @@index([returnId])
  @@index([storeId, dispositionState])
}

/// @stage S08 · PR 191 — one phone number that refused parcels, proposed for the refused-parcel list (Blueprint C6: the
/// list ad audiences exclude, PR 264). A person decides every entry (LISTED, DISMISSED, REMOVED); nothing here blocks an
/// order, turns COD off or changes a price (CLAUDE.md rule 6). A refusal the shop caused never feeds it (SIM-F-044).
model RefusedParcelEntry {
  id             String           @id @default(uuid(7)) @db.Uuid
  storeId        Int
  store          Store            @relation(fields: [storeId], references: [id])
  phone          String
  customerId     String?          @db.Uuid
  state          RefusedListState @default(PROPOSED)
  refusals       Int              @default(0)
  lastOrderId    String?          @db.Uuid
  lastReasonCode String?
  lastRefusedAt  DateTime         @db.Timestamptz(3)
  decidedById    String?          @db.Uuid
  decidedAt      DateTime?        @db.Timestamptz(3)
  decisionNote   String?
  version        Int              @default(0)
  createdAt      DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @db.Timestamptz(3)

  @@unique([storeId, phone])
  @@index([storeId, state, lastRefusedAt])
}

/// PR 191 — a refused-parcel list entry: proposed by a refusal, then on the list, dismissed, or taken off again.
enum RefusedListState {
  PROPOSED
  LISTED
  DISMISSED
  REMOVED
}

/// @stage S08 · PR 525 — true-delivery check: a parcel the courier calls "Delivered" while the shop's own records say it
/// came back (only the delivery charge was paid, the door record says returned, the courier's statement, the return was
/// received). One per parcel; a person resolves it. `signals` the signs found (CHARGE_ONLY, DOOR_RETURNED, STATEMENT,
/// RETURN_RECEIVED), `collectedMinor` / `chargeMinor` what the courier reported, `resolution` what really happened.
/// Nothing here moves money or changes COD.
model DeliveryCheck {
  id             String                @id @default(uuid(7)) @db.Uuid
  storeId        Int
  store          Store                 @relation(fields: [storeId], references: [id])
  orderId        String                @db.Uuid
  shipmentId     String                @unique @db.Uuid
  customerId     String?               @db.Uuid
  courierClaim   String
  signals        String[]              @default([])
  evidence       Json?
  collectedMinor Int?
  chargeMinor    Int?
  state          DeliveryCheckState    @default(OPEN)
  resolution     DeliveryCheckOutcome?
  resolvedById   String?               @db.Uuid
  resolvedAt     DateTime?             @db.Timestamptz(3)
  note           String?
  createdAt      DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime              @updatedAt @db.Timestamptz(3)

  @@index([storeId, state, createdAt])
  @@index([storeId, orderId])
  @@index([storeId, customerId])
}

enum DeliveryCheckState {
  OPEN
  RESOLVED
}

enum DeliveryCheckOutcome {
  DELIVERED
  CHARGE_PAID_RETURN
  RETURNED
}

/// @stage S08 · PR 564 — the courier resolved a different location than the band charged: recorded, nothing changed.
/// @append-only
model ChargeMismatch {
  id                  String   @id @default(uuid(7)) @db.Uuid
  storeId             Int
  store               Store    @relation(fields: [storeId], references: [id])
  orderId             String   @db.Uuid
  chargedBandKey      String
  courierResolvedArea String?
  differenceMinor     Int
  createdAt           DateTime @default(now()) @db.Timestamptz(3)

  @@index([storeId, createdAt])
}

/// @stage S08 · PR 193; B1.14 — holiday mode: banner, ship-after date or closed checkout; the site is never taken down.
model HolidayPeriod {
  id           String    @id @default(uuid(7)) @db.Uuid
  storeId      Int
  store        Store     @relation(fields: [storeId], references: [id])
  name         String
  startsAt     DateTime  @db.Timestamptz(3)
  endsAt       DateTime  @db.Timestamptz(3)
  checkoutMode String
  shipAfter    DateTime? @db.Timestamptz(3)
  bannerEn     String?
  bannerBn     String?
  pauseAds     Boolean   @default(false)
  pauseSms     Boolean   @default(false)
  autoReply    Boolean   @default(false)
  enabled      Boolean   @default(false)
  archivedAt   DateTime? @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(3)
}

// =====================================================================================================================
// S09 · Inventory & ERP sync — PR 194–207, 497–499. One stock pool, one warehouse, shared by all stores (A4.4);
// reservation is global. The ERP is the master; cart reservations stay local (A3.5).
// =====================================================================================================================

/// @stage S09 · PR 196, 497 — the store's ERP mapping: mode (EXTAS ERP · another ERP · none), company and warehouse.
model StoreErpMapping {
  id             String   @id @default(uuid(7)) @db.Uuid
  storeId        Int      @unique
  store          Store    @relation(fields: [storeId], references: [id])
  mode           ErpMode  @default(NONE)
  integrationId  String?  @db.Uuid
  erpCompanyId   String?
  erpWarehouseId String?
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)
}

enum ErpMode {
  EXTAS_ERP
  OTHER_ERP
  NONE
}

/// @stage S09 · PR 196, 201 — a warehouse in the shared pool.
/// @scope installation — one shared stock pool (A4.4).
model Warehouse {
  id             String    @id @default(uuid(7)) @db.Uuid
  code           String    @unique
  name           String
  erpWarehouseId String?
  archivedAt     DateTime? @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(3)

  locations InventoryLocation[]
}

/// @stage S09 · PR 201; A6.2 — a stock location: warehouse, showroom, in transit, damaged bin.
/// @scope installation — one shared stock pool (A4.4).
model InventoryLocation {
  id          String       @id @default(uuid(7)) @db.Uuid
  warehouseId String       @db.Uuid
  warehouse   Warehouse    @relation(fields: [warehouseId], references: [id])
  code        String
  name        String
  kind        LocationKind
  archivedAt  DateTime?    @db.Timestamptz(3)
  createdAt   DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @db.Timestamptz(3)

  stockLevels StockLevel[]

  @@unique([warehouseId, code])
}

enum LocationKind {
  WAREHOUSE
  SHOWROOM
  IN_TRANSIT
  DAMAGED
}

/// @stage S09 · PR 195, 197, 198 — the local stock mirror per variant per location. `onHand` and `reserved` come from
/// the ERP (StockBalance); `cartReserved` is the shop's short-lived hold. Checkout locks this row (SELECT … FOR UPDATE).
/// @scope installation — one shared stock pool; a sale on any store reduces it everywhere (A4.4).
model StockLevel {
  id           String            @id @default(uuid(7)) @db.Uuid
  variantId    String            @db.Uuid
  variant      ProductVariant    @relation(fields: [variantId], references: [id])
  locationId   String            @db.Uuid
  location     InventoryLocation @relation(fields: [locationId], references: [id])
  onHand       Int               @default(0)
  reserved     Int               @default(0)
  available    Int               @default(0)
  cartReserved Int               @default(0)
  erpUpdatedAt DateTime?         @db.Timestamptz(3)
  createdAt    DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime          @updatedAt @db.Timestamptz(3)

  @@unique([variantId, locationId])
  @@index([locationId, available])
}

/// @stage S09 · PR 197, 198 — a cart or checkout hold on the shared pool, released on abandon or expiry.
model StockReservation {
  id         String            @id @default(uuid(7)) @db.Uuid
  storeId    Int
  store      Store             @relation(fields: [storeId], references: [id])
  variantId  String            @db.Uuid
  locationId String?           @db.Uuid
  quantity   Int
  cartId     String?           @db.Uuid
  orderId    String?           @db.Uuid
  status     ReservationStatus @default(ACTIVE)
  expiresAt  DateTime          @db.Timestamptz(3)
  releasedAt DateTime?         @db.Timestamptz(3)
  createdAt  DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime          @updatedAt @db.Timestamptz(3)

  @@index([variantId, status])
  @@index([status, expiresAt])
}

enum ReservationStatus {
  ACTIVE
  CONVERTED
  RELEASED
  EXPIRED
}

/// @stage S09 · PR 200, 207 — every stock movement the shop knows of, idempotent (no duplicate movement is possible).
/// @scope store-optional — the sale that caused it names its store; ERP sync movements have none.
/// @append-only
model StockMovement {
  id             String   @id @default(uuid(7)) @db.Uuid
  storeId        Int?
  store          Store?   @relation(fields: [storeId], references: [id])
  variantId      String   @db.Uuid
  locationId     String   @db.Uuid
  delta          Int
  reason         String
  referenceType  String?
  referenceId    String?
  idempotencyKey String   @unique
  erpRef         String?
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  @@index([variantId, createdAt])
}

/// @stage S09 · PR 202 — a low-stock alert, raised once on the shared number (A4.4).
/// @scope installation — one shared stock pool.
model LowStockAlert {
  id         String    @id @default(uuid(7)) @db.Uuid
  variantId  String    @db.Uuid
  threshold  Int
  available  Int
  notifiedAt DateTime? @db.Timestamptz(3)
  resolvedAt DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @db.Timestamptz(3)

  @@index([variantId, resolvedAt])
}

/// @stage S09 · PR 203 — a stock audit by barcode.
/// @scope installation — one shared stock pool.
model StockAudit {
  id          String    @id @default(uuid(7)) @db.Uuid
  locationId  String    @db.Uuid
  status      String
  startedById String?   @db.Uuid
  completedAt DateTime? @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)

  lines StockAuditLine[]
}

/// @stage S09 · PR 203 — one counted line with its variance and reason.
/// @scope installation — one shared stock pool.
model StockAuditLine {
  id          String     @id @default(uuid(7)) @db.Uuid
  auditId     String     @db.Uuid
  audit       StockAudit @relation(fields: [auditId], references: [id])
  variantId   String?    @db.Uuid
  barcode     String
  expectedQty Int
  countedQty  Int
  reason      String?
  createdAt   DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime   @updatedAt @db.Timestamptz(3)
}

/// @stage S09 · PR 195, 205 — the sync cursor per store and resource (variants, stock); the poll fallback reads it.
model ErpSyncState {
  id            String    @id @default(uuid(7)) @db.Uuid
  storeId       Int
  store         Store     @relation(fields: [storeId], references: [id])
  resource      String
  cursor        String?
  updatedSince  DateTime? @db.Timestamptz(3)
  lastSuccessAt DateTime? @db.Timestamptz(3)
  lastError     String?
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(3)

  @@unique([storeId, resource])
}

/// @stage S09 · PR 205 — one sync run (pull or push) for the sync health panel.
/// @append-only
model ErpSyncRun {
  id          String           @id @default(uuid(7)) @db.Uuid
  storeId     Int
  store       Store            @relation(fields: [storeId], references: [id])
  kind        String
  status      BackgroundStatus
  itemsOk     Int              @default(0)
  itemsFailed Int              @default(0)
  error       String?
  startedAt   DateTime         @default(now()) @db.Timestamptz(3)
  finishedAt  DateTime?        @db.Timestamptz(3)
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)

  @@index([storeId, kind, startedAt])
}

/// @stage S09 · PR 199, 200, 498 — a business document pushed to the ERP (order, status, payment, shipment, return, ad
/// spend, expense) — never journal lines (A3.5). Idempotency-Key is required on every POST (ERP contract).
model ErpPush {
  id             String        @id @default(uuid(7)) @db.Uuid
  storeId        Int
  store          Store         @relation(fields: [storeId], references: [id])
  documentType   String
  referenceId    String
  idempotencyKey String
  status         ErpPushStatus @default(PENDING)
  attempts       Int           @default(0)
  requestBody    Json
  responseStatus Int?
  responseBody   Json?
  erpId          String?
  lastError      String?
  nextAttemptAt  DateTime?     @db.Timestamptz(3)
  sentAt         DateTime?     @db.Timestamptz(3)
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @db.Timestamptz(3)
  // ---- PR 610 (CN-028, migration 0053) ----
  /// The ERP keeps a 4xx answer against its Idempotency-Key (site-changes-v6 §2.3), so a document it refused for now
  /// (account on hold, short of stock, no shop price yet) goes again with a new key: `<idempotencyKey>:k<keyRound>`.
  /// The row's own key never changes (one row per document); 0 sends the row's key as it is.
  keyRound       Int           @default(0)
  /// Why a HELD document waits: ACCOUNT_ON_HOLD, INSUFFICIENT_STOCK, NO_SHOP_PRICE or LINE_WAITING (a short line).
  heldReason     String?

  @@unique([storeId, idempotencyKey])
  @@index([status, nextAttemptAt])
  @@index([storeId, status, heldReason])
}

enum ErpPushStatus {
  PENDING
  SENT
  FAILED
  DEAD
  SKIPPED_NO_ERP
  /// PR 607 (CN-028): a v5 call that v6 retired on the switch date; kept for the record, never sent.
  RETIRED
  /// PR 610 (CN-028): the ERP refused the order while Retail's account is on hold (409 ACCOUNT_ON_HOLD); it is sent
  /// again by itself when the account is released (`account.released`, or the account check).
  HELD
}

/// @stage S09 · PR 608 (CN-028, CN-029) — the ERP event ledger: every v6 event (webhook or pull) kept once by its eventId,
/// forever (the ERP never uses an id again, docs/erp/site-changes-v6.md §2.8). The same event by webhook and by pull is
/// one row. A correction (`reverses`) that arrives before its original waits for it. One store = one ERP company
/// (RETAIL-ERP-MODEL §16): every event belongs to the one store whose own key or secret it came through, under that
/// store's current ERP link. The body of a row is fixed at the database (migration 0049: a trigger refuses any change to
/// it, and no role may delete a row); only its processing state (status, attempts, result, error) moves.
model ErpEvent {
  id              String         @id @default(uuid(7)) @db.Uuid
  storeId         Int
  store           Store          @relation(fields: [storeId], references: [id])
  /// The store's ERP link (a handover starts a new one, PR 509/619): event ids are unique per link.
  linkId          String         @db.Uuid
  link            ErpStoreLink   @relation(fields: [linkId, storeId], references: [id, storeId])
  /// The store's own ERP connection (Integration.id) the event came through.
  integrationId   String         @db.Uuid
  eventId         String
  type            String
  source          ErpEventSource
  status          ErpEventStatus @default(RECEIVED)
  /// Moves money or credit (§2.8): the books must never lose it.
  moneyEvent      Boolean        @default(false)
  occurredAt      DateTime?      @db.Timestamptz(3)
  /// The ERP's business date (Asia/Dhaka).
  businessDate    DateTime?      @db.Date
  /// The eventId this event corrects (undoes), if any.
  reverses        String?
  /// The eventId of the correction that undid this event, once applied.
  reversedBy      String?
  externalOrderId String?
  data            Json
  /// SHA-256 of the event as the ledger reads it (canonical JSON of eventId, type, occurredAt, date, reverses, data):
  /// the same for the webhook and the pull, so a repeat with another body is seen.
  bodyHash        String
  /// SHA-256 of the exact signed raw body, for an event that came by webhook.
  rawBodyHash     String?
  /// A repeat of this eventId arrived with another body (never applied, kept to be checked): how often, last when, and
  /// that body's hash.
  conflictCount   Int            @default(0)
  conflictAt      DateTime?      @db.Timestamptz(3)
  conflictHash    String?
  /// What applying it did (counts and notes), for the admin and the books match.
  result          Json?
  error           String?
  attempts        Int            @default(0)
  receivedAt      DateTime       @default(now()) @db.Timestamptz(3)
  appliedAt       DateTime?      @db.Timestamptz(3)
  createdAt       DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @db.Timestamptz(3)

  @@unique([linkId, eventId])
  @@index([status, receivedAt])
  @@index([linkId, reverses])
  @@index([storeId, type, businessDate])
  @@index([storeId, externalOrderId])
}

enum ErpEventSource {
  WEBHOOK
  PULL
}

enum ErpEventStatus {
  /// Stored, not applied yet.
  RECEIVED
  /// Applied to the shop's records.
  APPLIED
  /// Kept in the ledger for the part of the shop that reads it (returns, exchanges, account, books).
  STORED
  /// A correction whose original event has not arrived yet.
  WAITING_ORIGINAL
  /// Nothing to do (for example an order the shop does not know).
  IGNORED
  /// Could not be applied after every try.
  FAILED
}

/// @stage S09 · PR 608 (CN-028) — a courier claim the ERP found (a missing parcel or piece, or stain or damage that
/// may be the courier's fault, §2.5.4): from `return.piece.decided` and from `GET /returns/claims`, one row per piece and
/// reason. The Returns section (PR 613) works the claim with the courier.
model ErpClaim {
  id              String         @id @default(uuid(7)) @db.Uuid
  storeId         Int
  store           Store          @relation(fields: [storeId], references: [id])
  linkId          String         @db.Uuid
  link            ErpStoreLink   @relation(fields: [linkId, storeId], references: [id, storeId])
  integrationId   String         @db.Uuid
  externalOrderId String
  /// The order line (empty when the claim is for the whole parcel).
  lineId          String         @default("")
  sku             String?
  reason          String
  returnListId    String?
  consignmentId   String?
  courier         String?
  handedBackAt    DateTime?      @db.Date
  decidedAt       DateTime?      @db.Date
  /// The piece's value at the price paid to the ERP, in minor units.
  valueMinor      BigInt?
  source          ErpEventSource
  /// The decision event, when the claim came by event.
  eventId         String?
  status          ErpClaimStatus @default(OPEN)
  firstSeenAt     DateTime       @default(now()) @db.Timestamptz(3)
  lastSeenAt      DateTime       @default(now()) @db.Timestamptz(3)
  createdAt       DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @db.Timestamptz(3)

  @@unique([linkId, externalOrderId, lineId, reason])
  @@index([storeId, status, handedBackAt])
}

enum ErpClaimStatus {
  OPEN
  /// The owner's decision was reversed in the ERP: kept for the record.
  REVERSED
}

// =====================================================================================================================
// CN-028 · PR 607–618 (CN-029 Phase 0) — Retail as a separate buyer of the ERP (docs/RETAIL-ERP-MODEL.md). Every table
// of the run is here, made by one migration (0049_erp_v6), so the five lanes never change the schema at the same time.
// Each row carries its store; the ledgers also carry the store's ERP link (a handover to a new owner starts a new
// link, and the new keys never reach the old link's rows, §16). Money is in minor units of the store's currency (the
// ERP speaks whole taka in v6). Ledgers and closes are append-only at the database: a correction is a reversing row
// plus a new row, never an edit (schema-meta APPEND_ONLY_LOCKED).
// =====================================================================================================================

/// @stage S09 · PR 607, 619 (CN-029 §16) — one store's link to its own ERP company: the store's own connection
/// (Integration row with this storeId; its API key, webhook secret and signing secret are in the vault under the store's
/// id, never here), the company the key belongs to, the switch date, the opening balance and the dry run. One open link
/// per store; a handover to a new owner ends it (`endedAt`) and starts the next epoch, whose keys never reach the old
/// link's ledgers (PR 509, 619). No secret is ever stored in this table.
model ErpStoreLink {
  id                  String    @id @default(uuid(7)) @db.Uuid
  storeId             Int
  store               Store     @relation(fields: [storeId], references: [id])
  /// 1 for the first link of the store; each handover adds one.
  epoch               Int       @default(1)
  /// The store's own ERP connection (Integration.id, storeId = this store).
  integrationId       String?   @db.Uuid
  /// The ERP company the store's key belongs to (from `GET /health`, filled when the link opens or at its first pull).
  erpCompanyId        String?
  /// `erpCompanyId` while the link is open, null once it ended: kept by a database trigger (migration 0049), never
  /// written by the app. Unique, so two stores' open links can never hold one ERP company (§16: SHARED_COMPANY).
  openErpCompanyId    String?   @unique
  /// The ERP's switch date for this store (v6 from that day, PR 619), and when the switch was made after a dry run.
  switchDate          DateTime? @db.Date
  dryRunAt            DateTime? @db.Timestamptz(3)
  switchedAt          DateTime? @db.Timestamptz(3)
  /// What Retail owed the ERP at the switch (from the ERP's list of moved orders, at the buying price), minor units.
  openingBalanceMinor BigInt?
  openingBalanceDate  DateTime? @db.Date
  openingImportedAt   DateTime? @db.Timestamptz(3)
  /// The link was handed over (or replaced): its history stays, unreachable from the new keys.
  endedAt             DateTime? @db.Timestamptz(3)
  endedReason         String?
  createdAt           DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime  @updatedAt @db.Timestamptz(3)

  events          ErpEvent[]
  claims          ErpClaim[]
  orders          ErpOrder[]
  accountStates   ErpAccountState[]
  accountEntries  ErpAccountEntry[]
  paymentRecords  ErpPaymentRecord[]
  pipelinePieces  ErpPipelinePiece[]
  pipelineMoves   ErpPipelineMove[]
  returnLists     ErpReturnList[]
  exchangeLinks   ErpExchangeLink[]
  dailySummaries  ErpDailySummary[]
  fixedCostMonths ErpFixedCostMonth[]
  booksSends      ErpBooksSend[]
  matchRuns       BooksMatchRun[]
  dayCloses       BooksDayClose[]
  periodCloses    BooksPeriodClose[]
  differences     BooksDifference[]
  adjustments     BooksAdjustment[]
  // PR 613 (migration 0054_returns_v6)
  returnsCompares ErpReturnsCompare[]
  // PR 619 (migration 0057_erp_switchover)
  switchRuns      ErpSwitchRun[]
  switchOrders    ErpSwitchOrder[]

  @@unique([storeId, epoch])
  /// The key of the composite foreign keys (linkId, storeId): a row's link is always its own store's link.
  @@unique([id, storeId])
  @@index([storeId, endedAt])
}

// ---- PR 610 · orders to the ERP v6 ---------------------------------------------------------------------------------------

/// @stage S09 · PR 610, 611 (CN-028) — an order as the ERP has it in contract v6 (docs/erp/site-changes-v6.md §2.3): what
/// Retail owes for it (`erpTotal`, fixed at the ERP's shop prices when the order is placed), when the parcel was picked
/// up and the ERP billed it (`POST /shipments`, PR 611), and the ERP's identification of the delivery result.
model ErpOrder {
  id              String       @id @default(uuid(7)) @db.Uuid
  storeId         Int
  store           Store        @relation(fields: [storeId], references: [id])
  linkId          String       @db.Uuid
  link            ErpStoreLink @relation(fields: [linkId, storeId], references: [id, storeId])
  /// The shop's order (Order.id) and its number as the ERP knows it.
  orderId         String       @db.Uuid
  externalOrderId String
  erpOrderId      String?
  /// An exchange order names the order it exchanges (PR 614); it is not a sale.
  exchangeOfId    String?      @db.Uuid
  /// What Retail owes the ERP for the order, minor units (the answer's `erpTotal`); null until the ERP answers.
  erpTotalMinor   BigInt?
  acceptedAt      DateTime?    @db.Timestamptz(3)
  /// The ERP's last refusal of the order (ACCOUNT_ON_HOLD, NO_SHOP_PRICE, INSUFFICIENT_STOCK) and its details.
  refusal         String?
  refusalDetails  Json?
  refusedAt       DateTime?    @db.Timestamptz(3)
  /// PR 611: the courier confirmed pickup and the shipment went to the ERP (that is when the ERP bills).
  consignmentId   String?
  courier         String?
  pickedUpAt      DateTime?    @db.Timestamptz(3)
  shipmentSentAt  DateTime?    @db.Timestamptz(3)
  billedAt        DateTime?    @db.Timestamptz(3)
  /// PR 611: the ERP's identification of the delivery result (GREEN, YELLOW, ORANGE) and when it came.
  identification  String?
  identifiedAt    DateTime?    @db.Timestamptz(3)
  createdAt       DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime     @updatedAt @db.Timestamptz(3)

  lines           ErpOrderLine[]
  deliveryResults ErpDeliveryResult[]

  @@unique([linkId, externalOrderId])
  @@unique([linkId, orderId])
  @@index([storeId, billedAt])
}

/// @stage S09 · PR 610 (CN-028) — one piece of an order as the ERP has it: its own `lineId` (`<order number>-<n>`, never
/// reused), the customer's whole-taka price after the combo split and discounts, the grade, and the ERP's answer (the
/// shop price fixed on the order, whether it came from the ERP's Return stock). A Return-stock piece that fails the
/// packing check is SHORT (`order.line.short`) until it is filled or the admin decides (WAIT, REPLACE, CANCEL).
model ErpOrderLine {
  id                 String         @id @default(uuid(7)) @db.Uuid
  storeId            Int
  store              Store          @relation(fields: [storeId], references: [id])
  erpOrderId         String         @db.Uuid
  erpOrder           ErpOrder       @relation(fields: [erpOrderId], references: [id])
  /// The shop's order line this piece belongs to, and which piece of it (1 … quantity).
  orderItemId        String?        @db.Uuid
  piece              Int            @default(1)
  lineId             String
  sku                String
  grade              ErpGrade       @default(A)
  /// The customer's price for this piece, minor units of whole taka (the remainder of a split is on the last piece).
  customerPriceMinor Int
  comboId            String?        @db.Uuid
  /// An exchange order's line names the line it replaces (PR 614).
  replacesLineId     String?
  /// The ERP's shop price fixed on the order for this piece ("bought from ERP at"), minor units.
  shopPriceMinor     Int?
  fromReturnStock    Boolean        @default(false)
  state              ErpLineState   @default(OPEN)
  shortReason        String?
  shortAt            DateTime?      @db.Timestamptz(3)
  filledAt           DateTime?      @db.Timestamptz(3)
  decision           ErpLineAction?
  /// REPLACE: the SKU asked for instead.
  decisionSku        String?
  decidedAt          DateTime?      @db.Timestamptz(3)
  decidedById        String?        @db.Uuid
  createdAt          DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime       @updatedAt @db.Timestamptz(3)

  @@unique([erpOrderId, lineId])
  @@index([storeId, state])
}

enum ErpLineState {
  OPEN
  /// The ERP could not fill it (`order.line.short`): the order waits for the admin's decision or the stock.
  SHORT
  /// Dropped by the admin's CANCEL: never billed; kept in the order's history.
  CANCELLED
  /// No longer in the shop's order (an edit sent the order again without it).
  REMOVED
}

enum ErpLineAction {
  WAIT
  REPLACE
  CANCEL
}

/// @stage S09 · PR 611 (CN-028) — one courier result sent to the ERP (`PUT /orders/{id}/delivery`): delivered, partial
/// (with the staff's Partial delivery box: the kept lines, what was paid, any discount promised by phone) or returned.
/// A courier correction is a new row; the ERP's answer (its identification) is kept on the row.
model ErpDeliveryResult {
  id                 String             @id @default(uuid(7)) @db.Uuid
  storeId            Int
  store              Store              @relation(fields: [storeId], references: [id])
  erpOrderId         String             @db.Uuid
  erpOrder           ErpOrder           @relation(fields: [erpOrderId], references: [id])
  outcome            ErpDeliveryOutcome
  courier            String
  consignmentId      String?
  /// What the courier collected, minor units of whole taka.
  collectedMinor     BigInt             @default(0)
  at                 DateTime           @db.Timestamptz(3)
  keptLineIds        String[]           @default([])
  discountGivenMinor BigInt             @default(0)
  phoneConfirmed     Boolean            @default(false)
  note               String?
  markedById         String?            @db.Uuid
  sentAt             DateTime?          @db.Timestamptz(3)
  answer             Json?
  createdAt          DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime           @updatedAt @db.Timestamptz(3)

  @@index([storeId, at])
  @@index([erpOrderId])
}

enum ErpDeliveryOutcome {
  DELIVERED
  PARTIAL
  RETURNED
}

/// @stage S09 · PR 610 (CN-028) — Retail's account at the ERP as the ERP last said (`GET /account`, `account.hold`,
/// `account.released`): what Retail owes, the hold and when it would start. One row per link; the account check and
/// the hold events refresh it. A cache of the ERP's answer: the books (PR 615) never read their balance from here.
model ErpAccountState {
  id                   String       @id @default(uuid(7)) @db.Uuid
  storeId              Int
  store                Store        @relation(fields: [storeId], references: [id])
  linkId               String       @unique @db.Uuid
  link                 ErpStoreLink @relation(fields: [linkId, storeId], references: [id, storeId])
  onHold               Boolean      @default(false)
  reason               String?
  /// The date the hold starts if no payment comes, and the ERP's own warning window.
  holdsOn              DateTime?    @db.Date
  warnFromDays         Int?
  lastPaymentAt        DateTime?    @db.Date
  daysSinceLastPayment Int?
  /// What Retail owes (not counting pieces waiting for the owner's check), and those, and exchanges at risk; minor units.
  balanceMinor         BigInt?
  waitingCheckMinor    BigInt?
  exchangesAtRiskMinor BigInt?
  heldAt               DateTime?    @db.Timestamptz(3)
  releasedAt           DateTime?    @db.Timestamptz(3)
  checkedAt            DateTime?    @db.Timestamptz(3)
  createdAt            DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime     @updatedAt @db.Timestamptz(3)

  @@index([storeId])
}

// ---- PR 615 · Retail's ERP account ledger and the pipeline stock ---------------------------------------------------------

/// @stage S09 · PR 615 (CN-028) — Retail's ERP account (docs/RETAIL-ERP-MODEL.md §3.1): one entry per ERP event, never
/// edited, never deleted. `eventId` is unique forever within the link (an entry the shop writes from an answer or by
/// hand has a key of its own: `ship:<consignment>`, `adj:<adjustment id>`, `switch:<date>`). The business date is the
/// ERP's own date (Asia/Dhaka). A correction is a REVERSAL entry (`reverses`) plus a new entry. `seq` and the hash chain
/// (`prevHash` → `hash`) show any change. Balance = the sum of `amountMinor` (+ what Retail owes more, − less).
/// @append-only
model ErpAccountEntry {
  id              String              @id @default(uuid(7)) @db.Uuid
  storeId         Int
  store           Store               @relation(fields: [storeId], references: [id])
  linkId          String              @db.Uuid
  link            ErpStoreLink        @relation(fields: [linkId, storeId], references: [id, storeId])
  /// Position in the link's chain: 1, 2, 3 … with no gap.
  seq             Int
  kind            ErpAccountEntryKind
  eventId         String
  businessDate    DateTime            @db.Date
  /// Signed, minor units of whole taka: + Retail owes more, − Retail owes less.
  amountMinor     BigInt
  externalOrderId String?
  lineId          String?
  returnListId    String?
  consignmentId   String?
  exchangeId      String?
  paymentRef      String?
  source          ErpEntrySource
  /// The eventId this entry reverses (REVERSAL), if any.
  reverses        String?
  /// The ledger row of the ERP event it came from (ErpEvent.id), the shop adjustment it came from (BooksAdjustment.id).
  erpEventRowId   String?             @db.Uuid
  adjustmentId    String?             @db.Uuid
  prevHash        String?
  hash            String
  createdById     String?             @db.Uuid
  createdAt       DateTime            @default(now()) @db.Timestamptz(3)

  @@unique([linkId, eventId])
  @@unique([linkId, seq])
  /// One reversal per original entry (PostgreSQL: rows with no `reverses` never clash).
  @@unique([linkId, reverses])
  @@index([storeId, businessDate])
  @@index([linkId, kind, businessDate])
  @@index([linkId, externalOrderId])
}

enum ErpAccountEntryKind {
  /// The order billed when the shipment is recorded (`erpTotal`, `billedAt`): +.
  BILL
  /// `exchange.settled` EXTRA (+) / ADJUSTMENT (−).
  EXCHANGE_EXTRA
  EXCHANGE_ADJUSTMENT
  /// `exchange.billed` (+) / `exchange.credited` (−).
  EXCHANGE_BILL
  EXCHANGE_CREDIT
  /// `return.piece.decided` APPROVED or APPROVED_AT_PACKING (`credit`): −.
  RETURN_CREDIT
  /// `payment.recorded` (the ERP Accounts team): −.
  PAYMENT
  /// The one-time move of old open amounts at the switch date, at the buying price: +.
  SWITCH_TRANSFER
  /// Any event with `reverses`: the original undone by an opposite entry: ∓.
  REVERSAL
  /// A shop correction by Accounts with the PIN and a reason, paired with the ERP's matching entry: ∓.
  ADJUSTMENT
}

enum ErpEntrySource {
  WEBHOOK
  PULL
  /// From an ERP answer (the bill in the answer to `POST /shipments`).
  ANSWER
  MANUAL
  SWITCH
}

/// @stage S09 · PR 615 (CN-028) — "paid to ERP" as the shop records it (Retail's cash going out; docs/RETAIL-ERP-MODEL.md
/// §3.1): by the Accounts role or the owner only (`erp.payments.record`). Matched against the ERP's `payment.recorded`
/// (amount, date within 2 days, reference) by the books match; a wrong record is put right by a new record that reverses
/// it (`reversesId`), never edited.
/// @append-only
model ErpPaymentRecord {
  id           String       @id @default(uuid(7)) @db.Uuid
  storeId      Int
  store        Store        @relation(fields: [storeId], references: [id])
  linkId       String       @db.Uuid
  link         ErpStoreLink @relation(fields: [linkId, storeId], references: [id, storeId])
  paidOn       DateTime     @db.Date
  /// Minor units of whole taka; a reversing record carries the opposite amount.
  amountMinor  BigInt
  method       String?
  reference    String?
  note         String?
  /// The record this one reverses: one reversal per record.
  reversesId   String?      @unique @db.Uuid
  /// PR 616 (follow-up 551): the form's request key (`Idempotency-Key`): the same request again answers this record.
  requestKey   String?
  recordedById String       @db.Uuid
  createdAt    DateTime     @default(now()) @db.Timestamptz(3)

  @@unique([linkId, requestKey])
  @@index([storeId, paidOn])
  @@index([linkId, reference])
}

/// @stage S09 · PR 615 (CN-028) — one billed piece and where it is now (docs/RETAIL-ERP-MODEL.md §3.2): in the pipeline
/// (billed and with the courier, coming back, or handed back and waiting for the owner's check) or out of it (delivered
/// = goods cost, approved = credit, declined = return loss). Built from the shop's own piece states, not from the ERP, so
/// it is an independent check. Every move is kept in ErpPipelineMove.
model ErpPipelinePiece {
  id               String        @id @default(uuid(7)) @db.Uuid
  storeId          Int
  store            Store         @relation(fields: [storeId], references: [id])
  linkId           String        @db.Uuid
  link             ErpStoreLink  @relation(fields: [linkId, storeId], references: [id, storeId])
  orderId          String?       @db.Uuid
  externalOrderId  String
  lineId           String
  sku              String
  /// The buying price on the bill (the shop price fixed on the order), minor units.
  buyingPriceMinor Int
  state            ErpPieceState
  billedOn         DateTime      @db.Date
  /// The business date the piece reached its current state.
  stateDate        DateTime      @db.Date
  exchangeId       String?
  createdAt        DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime      @updatedAt @db.Timestamptz(3)

  moves ErpPipelineMove[]

  @@unique([linkId, externalOrderId, lineId])
  @@index([storeId, state])
  @@index([linkId, state, stateDate])
}

enum ErpPieceState {
  /// In the pipeline: billed, with the courier or out for delivery.
  BILLED
  /// In the pipeline: the courier is bringing it back.
  RETURNING
  /// In the pipeline: handed back, on Hold or in Return stock, not checked yet (equals the ERP's `waitingCheck`).
  WAITING_CHECK
  /// Out: delivered to the customer (goods cost on the delivery day).
  DELIVERED
  /// Out: checked and approved (a credit, no cost).
  APPROVED
  /// Out: checked and declined (a return loss on the decision day).
  DECLINED
}

/// @stage S09 · PR 615 (CN-028) — one move of a pipeline piece from a state to the next, on a business date, with the
/// event that caused it. The pipeline value of any day is rebuilt from these rows.
/// @append-only
model ErpPipelineMove {
  id               String           @id @default(uuid(7)) @db.Uuid
  storeId          Int
  store            Store            @relation(fields: [storeId], references: [id])
  linkId           String           @db.Uuid
  link             ErpStoreLink     @relation(fields: [linkId, storeId], references: [id, storeId])
  pieceId          String           @db.Uuid
  piece            ErpPipelinePiece @relation(fields: [pieceId], references: [id])
  fromState        ErpPieceState?
  toState          ErpPieceState
  businessDate     DateTime         @db.Date
  buyingPriceMinor Int
  /// The ERP event (or shop fact) that moved it: an eventId, or `delivery:<id>`, `handback:<id>`.
  cause            String
  createdAt        DateTime         @default(now()) @db.Timestamptz(3)

  @@unique([pieceId, cause])
  @@index([linkId, businessDate])
}

// ---- PR 612 · courier return lists and the hand-back counts -------------------------------------------------------------

/// @stage S09 · PR 612 (CN-028) — a courier's hand-back, sent to the ERP as a return list (`POST /return-lists`, §2.5.3):
/// which parcels came back, counted and noted by staff (`returns.handback`). The shop never decides whether a piece can be
/// sold again: the owner decides in the ERP. A return that does not come through a courier uses `courier` HAND.
model ErpReturnList {
  id           String              @id @default(uuid(7)) @db.Uuid
  storeId      Int
  store        Store               @relation(fields: [storeId], references: [id])
  linkId       String              @db.Uuid
  link         ErpStoreLink        @relation(fields: [linkId, storeId], references: [id, storeId])
  /// The list's own id as the ERP gets it (never reused).
  returnListId String
  courier      String
  /// The courier's own date the parcels reached the shop.
  handedBackAt DateTime            @db.Date
  status       ErpReturnListStatus @default(OPEN)
  sentAt       DateTime?           @db.Timestamptz(3)
  answer       Json?
  error        String?
  createdById  String?             @db.Uuid
  createdAt    DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime            @updatedAt @db.Timestamptz(3)
  /// PR 612 (CN-029 Phase 1, migration 0054_returns_v6): how often the list was sent and when last; the list whose
  /// refused parcels this one sends again (a new returnListId, never the old one); who closed it for sending.
  sendAttempts Int                 @default(0)
  lastTriedAt  DateTime?           @db.Timestamptz(3)
  resendOfId   String?             @db.Uuid
  closedById   String?             @db.Uuid

  parcels ErpReturnListParcel[]

  @@unique([linkId, returnListId])
  @@index([storeId, status, handedBackAt])
}

enum ErpReturnListStatus {
  /// Being scanned at the desk.
  OPEN
  /// Sent, waiting for the ERP's answer (or to be sent again).
  SENT
  ACCEPTED
  REFUSED
}

/// @stage S09 · PR 612 (CN-028) — one parcel on a return list: the pieces the ERP expects, the pieces counted at the desk,
/// a short condition note and (with `returns.handback.photo`) a photo of the sealed bag. A count that differs starts the
/// courier claim at once (`claimStartedAt`). The ERP's answer for the parcel (IN_RETURN_STOCK, HOLD, REFUSED) is kept.
model ErpReturnListParcel {
  id              String        @id @default(uuid(7)) @db.Uuid
  storeId         Int
  store           Store         @relation(fields: [storeId], references: [id])
  returnListId    String        @db.Uuid
  returnList      ErpReturnList @relation(fields: [returnListId], references: [id])
  orderId         String?       @db.Uuid
  externalOrderId String
  consignmentId   String?
  expectedCount   Int?
  receivedCount   Int
  note            String?
  /// The photo of the sealed bag (MediaAsset.id), when `returns.handback.photo` asks for one.
  photoAssetId    String?       @db.Uuid
  result          String?
  countDiffers    Boolean       @default(false)
  claimStartedAt  DateTime?     @db.Timestamptz(3)
  scannedById     String?       @db.Uuid
  scannedAt       DateTime      @default(now()) @db.Timestamptz(3)
  createdAt       DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @db.Timestamptz(3)
  /// PR 612 (migration 0054_returns_v6): the ERP's refusal reason (NOT_OUR_ORDER, NOT_RETURNED, ALREADY_HANDED_BACK)
  /// and the pieces it named; a parcel the shop did not expect back (taken with a note); the shop's return records it
  /// received; the exchange whose old piece it carries; the list it was sent again on after a refusal.
  reason          String?
  answerPieces    Json?
  unexpected      Boolean       @default(false)
  returnRecordIds String[]      @default([]) @db.Uuid
  exchangeLinkId  String?       @db.Uuid
  resentInListId  String?       @db.Uuid

  @@unique([returnListId, externalOrderId])
  @@index([storeId, consignmentId])
}

// ---- PR 614 · exchange through the ERP ----------------------------------------------------------------------------------

/// @stage S09 · PR 614 (CN-028) — an exchange as the ERP has it (§2.10): the shop's exchange case (Exchange.id), the new
/// order that names the old one, the ERP's exchange id and status, the 4-day return watch and the late-return mark, and
/// what is at risk until the old piece is back and checked. The customer's original sale stands; the swap difference and
/// the exchange charge are Retail's own income lines, never sent as ERP events.
model ErpExchangeLink {
  id                 String       @id @default(uuid(7)) @db.Uuid
  storeId            Int
  store              Store        @relation(fields: [storeId], references: [id])
  linkId             String       @db.Uuid
  link               ErpStoreLink @relation(fields: [linkId, storeId], references: [id, storeId])
  /// The shop's exchange case (Exchange.id).
  exchangeId         String       @db.Uuid
  erpExchangeId      String?
  ofExternalOrderId  String
  newExternalOrderId String?
  /// The ERP's status (WAITING_STOCK … CANCELLED), as last read.
  erpStatus          String?
  approvedAt         DateTime?    @db.Timestamptz(3)
  approvedById       String?      @db.Uuid
  /// What the customer pays for a dearer new piece (`exchange.passPriceRiseToCustomer`), minor units.
  customerPaysMinor  BigInt       @default(0)
  newDeliveredAt     DateTime?    @db.Timestamptz(3)
  /// The old piece must be back by then (the ERP's 4 days, `exchange.returnWatch.days`).
  returnWatchUntil   DateTime?    @db.Timestamptz(3)
  lateReturnMarkedAt DateTime?    @db.Timestamptz(3)
  valueAtRiskMinor   BigInt?
  settledKind        String?
  settledAmountMinor BigInt?
  createdAt          DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime     @updatedAt @db.Timestamptz(3)
  /// PR 614 (CN-029 Phase 1, migration 0054_returns_v6): the shop's new parcel (Order.id); each send to the ERP (a
  /// retry after a stock refusal goes with a new idempotency key: `exchange:<id>:a<attempts>`), the ERP's last refusal and
  /// its details; the ERP's deadline day and last change; when it finished (settled, billed, credited, cancelled); the
  /// clear note sent; the late-return mark as sent.
  newOrderId         String?      @db.Uuid
  sendAttempts       Int          @default(0)
  lastRefusal        String?
  lastRefusalDetails Json?
  lastTriedAt        DateTime?    @db.Timestamptz(3)
  deadline           DateTime?    @db.Date
  erpUpdatedAt       DateTime?    @db.Timestamptz(3)
  finishedAt         DateTime?    @db.Timestamptz(3)
  note               String?
  lateReturn         Json?

  lines ErpExchangeLine[]

  @@unique([linkId, exchangeId])
  @@index([storeId, erpStatus])
}

/// @stage S09 · PR 614 (CN-028) — one line of an exchange: the old order's line marked exchanged and the new line that
/// replaces it, with both customer prices and the new piece's shop price of that day.
model ErpExchangeLine {
  id                String          @id @default(uuid(7)) @db.Uuid
  storeId           Int
  store             Store           @relation(fields: [storeId], references: [id])
  exchangeLinkId    String          @db.Uuid
  exchangeLink      ErpExchangeLink @relation(fields: [exchangeLinkId], references: [id])
  oldLineId         String
  oldSku            String
  newLineId         String?
  newSku            String
  oldPriceMinor     Int
  newPriceMinor     Int
  newShopPriceMinor Int?
  createdAt         DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime        @updatedAt @db.Timestamptz(3)
  /// PR 614 (migration 0054_returns_v6): what Retail paid the ERP for the old piece (`replacedShopPrice`), what the
  /// customer pays for this swap (a dearer piece with `exchange.passPriceRiseToCustomer`; a cheaper one is never
  /// refunded), and the shop's exchange line and old order line it belongs to.
  oldShopPriceMinor Int?
  customerPaysMinor Int             @default(0)
  exchangeItemId    String?         @db.Uuid
  oldOrderItemId    String?         @db.Uuid

  @@unique([exchangeLinkId, oldLineId])
}

// ---- PR 613 · the nightly compare of the Returns section (CN-029 Phase 1, migration 0054_returns_v6) ----------------------

/// @stage S09 · PR 613 (CN-028) — one compare of the shop's Returns section with the ERP's `GET /returns/summary?date=`
/// (docs/erp/site-changes-v6.md §2.9): for one business date, the shop's own counts (pieces handed back, on hold, in
/// return stock, approved with the total credit, declined, the value waiting for the owner's check), the ERP's, and
/// every difference. Run every night and after a pull. A difference is never fixed by editing a number here: the shop
/// pulls `GET /returns?updatedSince=` and compares again. Each run is a new row (the history stays).
/// @append-only
model ErpReturnsCompare {
  id          String       @id @default(uuid(7)) @db.Uuid
  storeId     Int
  store       Store        @relation(fields: [storeId], references: [id])
  linkId      String       @db.Uuid
  link        ErpStoreLink @relation(fields: [linkId, storeId], references: [id, storeId])
  /// The business date compared (Asia/Dhaka, the ERP's own dates).
  date        DateTime     @db.Date
  /// `night`, `manual` or `pull` (after a pull asked by a person).
  trigger     String
  matched     Boolean
  shop        Json
  erp         Json?
  /// [{ field, shop, erp }] — empty when matched.
  differences Json         @default("[]")
  /// The ERP could not be asked (the compare is then not matched and says why).
  error       String?
  ranAt       DateTime     @default(now()) @db.Timestamptz(3)
  createdAt   DateTime     @default(now()) @db.Timestamptz(3)

  @@index([storeId, date])
  @@index([linkId, ranAt])
}

// ---- PR 617, 618 · what Retail sends the ERP: the daily summary and the fixed costs --------------------------------------

/// @stage S09 · PR 617 (CN-028) — one version of a day's summary as the shop built it from its own records (§3.3):
/// every line with its source, `incomplete` for a category with no figure yet (never sent as 0), `netProfit` before
/// fixed costs. A late fact makes a new version (while the day is open, `books.resend.days`); every send and the ERP's
/// reply are in ErpBooksSend.
/// @append-only
model ErpDailySummary {
  id             String       @id @default(uuid(7)) @db.Uuid
  storeId        Int
  store          Store        @relation(fields: [storeId], references: [id])
  linkId         String       @db.Uuid
  link           ErpStoreLink @relation(fields: [linkId, storeId], references: [id, storeId])
  date           DateTime     @db.Date
  version        Int
  /// The body sent (`PUT /daily-summaries/{date}`), its SHA-256 and what was still unknown.
  body           Json
  bodyHash       String
  incomplete     String[]     @default([])
  netProfitMinor BigInt
  /// qa-gate (0056): the same lines exactly, in minor units (books-rules.ts `SummaryMinor`); the books match ties the day
  /// with these, never with the whole-taka body. Empty on a version built before 0056.
  minorLines     Json?
  /// Why this version was built: NIGHTLY, LATE_FACT, MISSING (the ERP's `summary.missing`), BACKFILL (the switch).
  reason         String
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)

  @@unique([linkId, date, version])
  @@index([storeId, date])
}

/// @stage S09 · PR 618 (CN-028) — one version of a month's fixed costs (salary, rent, utilities, other) as the owner set
/// them (`fixedcosts.write`); raising one is a new version. Sent by `PUT /fixed-costs/{month}` and spread by the days of
/// the month with the ERP's rule (exact to the paisa, the remainder on the last day). Never part of `costs.other`.
/// @append-only
model ErpFixedCostMonth {
  id             String       @id @default(uuid(7)) @db.Uuid
  storeId        Int
  store          Store        @relation(fields: [storeId], references: [id])
  linkId         String       @db.Uuid
  link           ErpStoreLink @relation(fields: [linkId, storeId], references: [id, storeId])
  /// The month's first day.
  month          DateTime     @db.Date
  version        Int
  salaryMinor    BigInt
  rentMinor      BigInt
  utilitiesMinor BigInt
  otherMinor     BigInt
  note           String?
  createdById    String?      @db.Uuid
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)

  @@unique([linkId, month, version])
  @@index([storeId, month])
}

/// @stage S09 · PR 617, 618 (CN-028) — every time the shop sent a daily summary or a month's fixed costs to the ERP, with
/// the ERP's reply as it came (accepted or not). The admin sees this log; nothing in it is ever changed.
/// @append-only
model ErpBooksSend {
  id         String           @id @default(uuid(7)) @db.Uuid
  storeId    Int
  store      Store            @relation(fields: [storeId], references: [id])
  linkId     String           @db.Uuid
  link       ErpStoreLink     @relation(fields: [linkId, storeId], references: [id, storeId])
  kind       ErpBooksSendKind
  /// The version sent (ErpDailySummary.id or ErpFixedCostMonth.id).
  refId      String           @db.Uuid
  attempt    Int
  sentAt     DateTime         @db.Timestamptz(3)
  httpStatus Int?
  accepted   Boolean
  answer     Json?
  error      String?
  createdAt  DateTime         @default(now()) @db.Timestamptz(3)

  @@index([storeId, kind, sentAt])
  @@index([refId])
}

enum ErpBooksSendKind {
  DAILY_SUMMARY
  FIXED_COSTS
}

// ---- PR 616 · the books match engine -------------------------------------------------------------------------------------

/// @stage S09 · PR 616 (CN-028) — one run of the books match (checks A–F, §4.1): nightly at 01:30, or by hand
/// (`books.reconcile`). The run row is written when it starts and finished when it ends.
model BooksMatchRun {
  id          String         @id @default(uuid(7)) @db.Uuid
  storeId     Int
  store       Store          @relation(fields: [storeId], references: [id])
  linkId      String         @db.Uuid
  link        ErpStoreLink   @relation(fields: [linkId, storeId], references: [id, storeId])
  /// NIGHTLY, MANUAL, RECHECK.
  trigger     String
  fromDate    DateTime       @db.Date
  toDate      DateTime       @db.Date
  status      BooksRunStatus @default(RUNNING)
  /// Each check's result (A–F: MATCHED, PARTIAL, PENDING, MISMATCH) and its counts.
  checks      Json?
  differences Int            @default(0)
  error       String?
  startedById String?        @db.Uuid
  startedAt   DateTime       @db.Timestamptz(3)
  finishedAt  DateTime?      @db.Timestamptz(3)
  createdAt   DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime       @updatedAt @db.Timestamptz(3)

  @@index([storeId, startedAt])
}

enum BooksRunStatus {
  RUNNING
  DONE
  FAILED
}

/// @stage S09 · PR 616 (CN-028) — the immutable close of one day (§4.2): the shop's balance and the ERP's, the parts of
/// the tie formula (§3.4), the result and a hash chained to the day before. A re-close is a new version; a change to a
/// closed day raises HISTORY_CHANGED.
/// @append-only
model BooksDayClose {
  id                     String       @id @default(uuid(7)) @db.Uuid
  storeId                Int
  store                  Store        @relation(fields: [storeId], references: [id])
  linkId                 String       @db.Uuid
  link                   ErpStoreLink @relation(fields: [linkId, storeId], references: [id, storeId])
  date                   DateTime     @db.Date
  version                Int
  result                 BooksResult
  runId                  String?      @db.Uuid
  openingBalanceMinor    BigInt
  closingBalanceMinor    BigInt
  erpClosingBalanceMinor BigInt?
  goodsMinor             BigInt
  returnLossesMinor      BigInt
  pipelineStartMinor     BigInt
  pipelineEndMinor       BigInt
  switchTransferMinor    BigInt       @default(0)
  paymentsMinor          BigInt
  /// What the tie formula leaves over (0 = it ties).
  tieRemainderMinor      BigInt
  waitingCheckMinor      BigInt       @default(0)
  exchangesAtRiskMinor   BigInt       @default(0)
  /// Every figure of the day with its parts, for the "explain this number" view.
  figures                Json
  prevHash               String?
  hash                   String
  closedById             String?      @db.Uuid
  createdAt              DateTime     @default(now()) @db.Timestamptz(3)

  @@unique([linkId, date, version])
  @@index([storeId, date])
}

/// @stage S09 · PR 616 (CN-028) — a week, month, year or lifetime close built from the day closes (never from raw data):
/// the parts add up to the whole and the chain of balances holds. A month closes only when every day matched; the
/// owner's override (reason and PIN) is kept and shown on every report of that month. Re-opening writes a new version.
/// @append-only
model BooksPeriodClose {
  id                  String           @id @default(uuid(7)) @db.Uuid
  storeId             Int
  store               Store            @relation(fields: [storeId], references: [id])
  linkId              String           @db.Uuid
  link                ErpStoreLink     @relation(fields: [linkId, storeId], references: [id, storeId])
  level               BooksPeriodLevel
  periodStart         DateTime         @db.Date
  periodEnd           DateTime         @db.Date
  version             Int
  result              BooksResult
  openingBalanceMinor BigInt
  closingBalanceMinor BigInt
  matchedDays         Int
  totalDays           Int
  figures             Json
  /// Closed with differences by the owner (reason and PIN), or re-opened (`reopens` = the version it re-opens).
  override            Boolean          @default(false)
  overrideReason      String?
  reopens             Int?
  pinVerified         Boolean          @default(false)
  closedById          String?          @db.Uuid
  prevHash            String?
  hash                String
  createdAt           DateTime         @default(now()) @db.Timestamptz(3)

  @@unique([linkId, level, periodStart, version])
  @@index([storeId, level, periodStart])
}

enum BooksPeriodLevel {
  WEEK
  MONTH
  YEAR
  LIFETIME
}

enum BooksResult {
  MATCHED
  /// Matched as far as v6 lets the shop compare (the v7 requests of §13 are missing).
  PARTIAL
  /// A difference the ERP's rows explain, waiting for the pull (`books.timing.maxMinutes`).
  PENDING
  MISMATCH
}

/// @stage S09 · PR 616 (CN-028) — one difference the match found (§4.3), by class, with its amount and what it points at.
/// It is fixed only by reversing and adding (a pull, a reversal, a `books.adjust` adjustment), never by editing a number;
/// the row records when and how it was fixed. `key` keeps one row per difference across runs.
model BooksDifference {
  id              String                @id @default(uuid(7)) @db.Uuid
  storeId         Int
  store           Store                 @relation(fields: [storeId], references: [id])
  linkId          String                @db.Uuid
  link            ErpStoreLink          @relation(fields: [linkId, storeId], references: [id, storeId])
  date            DateTime              @db.Date
  check           BooksCheck
  kind            BooksDifferenceClass
  key             String
  status          BooksDifferenceStatus @default(PENDING)
  amountMinor     BigInt?
  eventId         String?
  externalOrderId String?
  detail          Json
  firstRunId      String?               @db.Uuid
  lastRunId       String?               @db.Uuid
  firstSeenAt     DateTime              @db.Timestamptz(3)
  lastSeenAt      DateTime              @db.Timestamptz(3)
  fixedAt         DateTime?             @db.Timestamptz(3)
  /// How it was fixed: the adjustment or the ledger entry that settled it.
  adjustmentId    String?               @db.Uuid
  entryId         String?               @db.Uuid
  createdAt       DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime              @updatedAt @db.Timestamptz(3)

  notes BooksDifferenceNote[]

  @@unique([linkId, date, kind, key])
  @@index([storeId, status, date])
}

enum BooksCheck {
  /// A. the ERP account and its statement rows.
  ACCOUNT
  /// B. the tie formula (§3.4).
  TIES
  /// C. returns and exchanges.
  RETURNS
  /// D. the stored daily summaries.
  SUMMARY
  /// E. fixed costs.
  FIXED_COSTS
  /// F. billed orders.
  ORDERS
}

enum BooksDifferenceClass {
  MISSING_EVENT
  UNKNOWN_ROW
  AMOUNT_DIFF
  UNMATCHED_PAYMENT
  TIE_BROKEN
  STALE_SUMMARY
  HISTORY_CHANGED
}

enum BooksDifferenceStatus {
  /// Timing: the pull is fetching an event the ERP holds (for `books.timing.maxMinutes`).
  PENDING
  MISMATCH
  FIXED
  /// Left in a month the owner closed with differences (reason and PIN).
  OVERRIDDEN
}

/// @stage S09 · PR 616 (CN-028) — a note on a difference (`books.reconcile`), never edited.
/// @append-only
model BooksDifferenceNote {
  id           String          @id @default(uuid(7)) @db.Uuid
  storeId      Int
  store        Store           @relation(fields: [storeId], references: [id])
  differenceId String          @db.Uuid
  difference   BooksDifference @relation(fields: [differenceId], references: [id])
  text         String
  createdById  String          @db.Uuid
  createdAt    DateTime        @default(now()) @db.Timestamptz(3)

  @@index([differenceId])
}

/// @stage S09 · PR 616 (CN-028) — a shop correction (§4.3): `books.adjust`, the owner's PIN, a reason and the ERP's
/// matching event; it writes an ADJUSTMENT entry to the account ledger. A late fact on a closed month is a PRIOR_PERIOD
/// adjustment dated in the open period. Never edited; a wrong adjustment is reversed by another (`reversesId`).
/// @append-only
model BooksAdjustment {
  id           String              @id @default(uuid(7)) @db.Uuid
  storeId      Int
  store        Store               @relation(fields: [storeId], references: [id])
  linkId       String              @db.Uuid
  link         ErpStoreLink        @relation(fields: [linkId, storeId], references: [id, storeId])
  kind         BooksAdjustmentKind
  /// The business date it counts on (in the open period).
  date         DateTime            @db.Date
  /// Signed, minor units of whole taka, as the account entry it writes.
  amountMinor  BigInt
  reason       String
  /// The ERP's matching event (its eventId), which the adjustment pairs with: one adjustment per ERP event.
  erpEventId   String
  differenceId String?             @db.Uuid
  /// The adjustment this one reverses: one reversal per adjustment.
  reversesId   String?             @unique @db.Uuid
  pinVerified  Boolean
  createdById  String              @db.Uuid
  createdAt    DateTime            @default(now()) @db.Timestamptz(3)

  @@unique([linkId, erpEventId])
  /// PR 616 (qa-gate): one correction per difference, ever (a second one at the same moment is refused here too).
  @@unique([linkId, differenceId])
  @@index([storeId, date])
}

enum BooksAdjustmentKind {
  ADJUSTMENT
  PRIOR_PERIOD
}

/// @stage S27 · parked — goods received into the shared pool when no ERP is connected (the no-ERP seam, PR 499).
/// @scope installation — one shared stock pool.
/// @append-only
model LocalStockIntake {
  id            String   @id @default(uuid(7)) @db.Uuid
  variantId     String   @db.Uuid
  locationId    String   @db.Uuid
  quantity      Int
  unitCostMinor Int?
  supplierName  String?
  enteredById   String?  @db.Uuid
  receivedAt    DateTime @db.Timestamptz(3)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
}

// =====================================================================================================================
// S10 · Smart Rules — PR 208–219. Rule text everywhere reads from the rule (PR 215).
// =====================================================================================================================

/// @stage S10 · PR 208, 210–214 — a rule: delivery, exchange, set tier, discount, festive, fulfilment exception, payment
/// campaign. Conditions and actions are data; the engine interprets them.
model SmartRule {
  id           String          @id @default(uuid(7)) @db.Uuid
  storeId      Int
  store        Store           @relation(fields: [storeId], references: [id])
  key          String
  kind         String
  nameEn       String
  nameBn       String?
  conditions   Json
  actions      Json
  priority     Int             @default(0)
  status       SmartRuleStatus @default(DRAFT)
  version      Int             @default(1)
  startsAt     DateTime?       @db.Timestamptz(3)
  endsAt       DateTime?       @db.Timestamptz(3)
  archivedAt   DateTime?       @db.Timestamptz(3)
  createdAt    DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime        @updatedAt @db.Timestamptz(3)
  /// PR 215 — every text a customer reads, by slot (short, full, …) and language: {slot: {en, bn}}. Tokens like
  /// {windowHours} are filled from the rule's own values, so no number is ever written into a text twice.
  text         Json?
  /// PR 209 — the values the text and the actions use ("Settings" in the editor): [{key, type, value, labelEn, labelBn}].
  params       Json?
  /// PR 209 — "Applies to" and "Except": {include: [...], exclude: [...]} (all · category · collection · product).
  scope        Json?
  /// PR 209, 215 — where the rule's text is shown (keys of the `rules.placements` dictionary).
  placements   String[]        @default([])
  /// PR 217 — may combine with other offers on the same line (default: does not).
  stackable    Boolean         @default(false)
  /// PR 210–213 — the rule moves money (a charge, a price, a discount, COD): switching it on needs the owner's OK
  /// (CLAUDE.md rule 6), recorded below.
  needsOwnerOk Boolean         @default(false)
  approvedById String?         @db.Uuid
  approvedAt   DateTime?       @db.Timestamptz(3)
  /// PR 209, 219 — changes saved but not live yet: the whole candidate rule, previewed and simulated before publish.
  draft        Json?
  draftById    String?         @db.Uuid
  draftAt      DateTime?       @db.Timestamptz(3)
  createdById  String?         @db.Uuid
  updatedById  String?         @db.Uuid

  versions SmartRuleVersion[]

  @@unique([storeId, key])
  @@index([storeId, kind, status, priority])
}

enum SmartRuleStatus {
  DRAFT
  ACTIVE
  PAUSED
  ENDED
}

/// @stage S10 · PR 218 — rule history: what changed, when, by whom.
/// @append-only
model SmartRuleVersion {
  id         String    @id @default(uuid(7)) @db.Uuid
  storeId    Int
  store      Store     @relation(fields: [storeId], references: [id])
  ruleId     String    @db.Uuid
  rule       SmartRule @relation(fields: [ruleId], references: [id])
  version    Int
  snapshot   Json
  changeNote String?
  actorId    String?   @db.Uuid
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)

  @@unique([ruleId, version])
}

/// @stage S10 · PR 217 — a detected conflict between two rules and how it was resolved.
model SmartRuleConflict {
  id           String    @id @default(uuid(7)) @db.Uuid
  storeId      Int
  store        Store     @relation(fields: [storeId], references: [id])
  ruleAId      String    @db.Uuid
  ruleBId      String    @db.Uuid
  kind         String
  resolution   String?
  resolvedAt   DateTime? @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(3)
  /// What the other side is: another rule, a notice, or a setting (then ruleBId repeats ruleAId; the key is in detail).
  otherType    String    @default("rule")
  /// The same pair with the same kind is the same conflict: a re-check updates it instead of adding another row.
  fingerprint  String?
  detail       Json?
  /// The rule the resolution order lets win (PR 217).
  winnerRuleId String?   @db.Uuid
  resolvedById String?   @db.Uuid

  @@unique([storeId, fingerprint])
  @@index([storeId, resolvedAt])
}

/// @stage S10 · PR 219 — a simulation: what an order would have cost under a rule.
/// @append-only
model SmartRuleSimulation {
  id        String   @id @default(uuid(7)) @db.Uuid
  storeId   Int
  store     Store    @relation(fields: [storeId], references: [id])
  ruleId    String?  @db.Uuid
  input     Json
  result    Json
  actorId   String?  @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
}

/// @stage S10 · PR 216 — a notice or pop-up with placement, timing and frequency cap (never an automatic welcome pop-up).
model Notice {
  id           String    @id @default(uuid(7)) @db.Uuid
  storeId      Int
  store        Store     @relation(fields: [storeId], references: [id])
  kind         String
  placement    Json
  timing       Json?
  contentEn    String
  contentBn    String?
  ruleId       String?   @db.Uuid
  frequencyCap Json?
  enabled      Boolean   @default(false)
  startsAt     DateTime? @db.Timestamptz(3)
  endsAt       DateTime? @db.Timestamptz(3)
  archivedAt   DateTime? @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(3)
  /// PR 216 — a stable key and the admin's name for the notice; the customer sees only the title and content.
  key          String?
  nameEn       String?
  nameBn       String?
  titleEn      String?
  titleBn      String?
  /// The button: {labelEn, labelBn, href} (a path inside the shop).
  cta          Json?
  priority     Int       @default(0)
  /// Bumped on every change; each change is in the audit log with before and after (nothing is overwritten unseen).
  version      Int       @default(1)
  createdById  String?   @db.Uuid
  updatedById  String?   @db.Uuid

  @@unique([storeId, key])

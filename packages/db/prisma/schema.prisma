/// @stage S19 · PR 396 — a restore: staging first, typed confirmation for production.
/// Settings › System › Backups › Restore: `environment` "staging" restores a backup into the check copy (container
/// extas-pg-restore, never the live database); "production" puts the same backup on the live shop and is accepted only
/// for the newest staging restore that SUCCEEDED (`stagingOfId`), with RESTORE typed (`confirmationTyped`) and the
/// owner's PIN (`approvedById`). The server's vault sync takes a QUEUED row (RUNNING) and writes the outcome back.
/// After a production restore the live database is the backup's, so this row of it is gone: the server keeps the
/// outcome (state/restore-production.json) and tells the owner on Telegram. Never deleted.
/// @scope installation — the one server.
model RestoreRequest {
  id                String           @id @default(uuid(7)) @db.Uuid
  /// What is restored: `database` (the photos have their own command, extas-restore media).
  target            String
  /// `staging` or `production`.
  environment       String
  pointInTime       DateTime?        @db.Timestamptz(3)
  confirmationTyped Boolean          @default(false)
  requestedById     String?          @db.Uuid
  approvedById      String?          @db.Uuid
  status            BackgroundStatus @default(QUEUED)
  startedAt         DateTime?        @db.Timestamptz(3)
  finishedAt        DateTime?        @db.Timestamptz(3)
  createdAt         DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime         @updatedAt @db.Timestamptz(3)
  /// PR 396: where from — `local` (the server's disk), `blob` (Azure Blob) or `drive` (Google Drive).
  source            String?
  /// PR 396: the backup's stamp (YYYYMMDD-HHMM); null = the newest. The server writes back the one it used.
  backup            String?
  /// PR 396: what the server said.
  detail            String?
  /// PR 396: a production restore names the staging restore of the same backup it follows.
  stagingOfId       String?          @db.Uuid

  @@index([status, createdAt])
}

/// @stage S19 · PR 507 (CN-030) — a backup or a restore drill asked for in the admin (Settings › System › Backups:
/// "Back up now", "Run the restore drill now"). The server's vault sync (infra/server/bin/extas-vault-sync) takes a
/// QUEUED row within a few minutes (RUNNING), runs it on the server and writes the outcome back (SUCCEEDED or FAILED,
/// with the server's own words). Never deleted; a request the server never reported is FAILED after
/// `BACKUP_REQUEST_STALE_H` hours. It never restores into the live database (that is RestoreRequest, PR 396).
/// @scope installation — the one server.
model BackupRequest {
  id            String            @id @default(uuid(7)) @db.Uuid
  kind          BackupRequestKind
  /// The drill's copies: `all` (the server's disk and each copy the drill settings name), `local`, `blob` or `drive`.
  /// Null for a backup.
  source        String?
  status        BackgroundStatus  @default(QUEUED)
  /// The server's own words on the outcome (never a key, never a value).
  detail        String?
  requestedById String?           @db.Uuid
  startedAt     DateTime?         @db.Timestamptz(3)
  finishedAt    DateTime?         @db.Timestamptz(3)
  createdAt     DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime          @updatedAt @db.Timestamptz(3)

  @@index([status, createdAt])
}

enum BackupRequestKind {
  BACKUP
  RESTORE_DRILL
}


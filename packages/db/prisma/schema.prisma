  recipeId       String?         @db.Uuid
  modelId        String?         @db.Uuid
  sceneId        String?         @db.Uuid
  angle          String
  tier           String
  status         StudioJobStatus @default(DRAFT)
  provider       String?
  providerJobId  String?
  idempotencyKey String
  attempt        Int             @default(1)
  seed           String?
  inputAssetIds  String[]        @db.Uuid
  /// Source-image + model + settings + provider-version hash: approved output is reused while it matches.
  reuseHash      String?

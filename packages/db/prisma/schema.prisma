}

// =====================================================================================================================
// S15 · AI 360 Control Room — PR 304–341, 506, 577–585. The control room is shared by all stores with per-store switches
// and cost attribution (A4.3). AI is additive: every agent has a non-AI fallback (C1.4).
// =====================================================================================================================

/// @stage S15 · PR 305, 577, 581, 583, 593 — an agent (the seven fixed agents, the five blog authors, engine agents such
/// as Photoshoot). Owner-editable profile; keep-on works with the master switch off (C1.3).
/// @scope installation — the shared AI 360 control room (A4.3).
model AiAgent {
  id                  String    @id @default(uuid(7)) @db.Uuid
  key                 String    @unique
  /// Employee code, e.g. A360-02.
  code                String    @unique
  nameEn              String
  nameBn              String?
  role                String
  emoji               String?
  photoAssetRef       String?
  bio                 String?
  joinedOn            DateTime? @db.Date
  isChief             Boolean   @default(false)
  reportsToId         String?   @db.Uuid
  reportsTo           AiAgent?  @relation("AgentChain", fields: [reportsToId], references: [id])
  reports             AiAgent[] @relation("AgentChain")
  enabled             Boolean   @default(false)
  keepOnWhenMasterOff Boolean   @default(false)
  verified            Boolean   @default(false)
  monthlyCapMinor     Int?
  schedule            Json?
  archivedAt          DateTime? @db.Timestamptz(3)
  createdAt           DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime  @updatedAt @db.Timestamptz(3)

  storeSettings AiAgentStoreSetting[]
  permissions   AgentPermission[]
  skills        AiSkill[]
  usage         AiUsageLedger[]
  diary         AiDiaryEntry[]
  assignments   AiAgentAssignment[]
  workLogs      AiWorkLog[]
  memories      AiMemory[]
  appraisals    AiAppraisal[]
  curriculum    AiCurriculumLevel[]
}

/// @stage S15 · PR 369 — an agent's switch, schedule and cap in one store.
model AiAgentStoreSetting {
  id              String   @id @default(uuid(7)) @db.Uuid
  storeId         Int
  store           Store    @relation(fields: [storeId], references: [id])
  agentId         String   @db.Uuid
  agent           AiAgent  @relation(fields: [agentId], references: [id])
  enabled         Boolean  @default(false)
  monthlyCapMinor Int?
  schedule        Json?
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)

  @@unique([storeId, agentId])
}

/// @stage S15 · PR 306 — an AI provider behind the adapter (Anthropic, OpenAI, Google, OpenRouter, FASHN, video vendors).
/// @scope installation — the shared AI 360 control room.
model AiProvider {
  id            String    @id @default(uuid(7)) @db.Uuid
  key           String    @unique
  name          String
  kinds         String[]
  integrationId String?   @db.Uuid
  enabled       Boolean   @default(false)
  archivedAt    DateTime? @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(3)

  models AiModel[]
}

/// @stage S15 · PR 306, 312, 580 — a model with its editable price table (millionths of a USD per million units).
/// @scope installation — the shared AI 360 control room.
model AiModel {
  id                     String     @id @default(uuid(7)) @db.Uuid
  providerId             String     @db.Uuid
  provider               AiProvider @relation(fields: [providerId], references: [id])
  modelKey               String
  displayName            String
  kind                   String
  priceCurrency          String
  inputPerMillionMicros  BigInt?
  outputPerMillionMicros BigInt?
  perImageMicros         BigInt?
  perVideoSecondMicros   BigInt?
  isFree                 Boolean    @default(false)
  enabled                Boolean    @default(false)
  priceCheckedAt         DateTime?  @db.Timestamptz(3)
  archivedAt             DateTime?  @db.Timestamptz(3)
  createdAt              DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime   @updatedAt @db.Timestamptz(3)

  @@unique([providerId, modelKey])
}

/// @stage S15 · PR 312, 313 — a row of the AI Cost Book: one job type with its chosen model, estimate and actual.
/// @scope installation — the shared AI 360 control room.
model AiJobType {
  id                   String    @id @default(uuid(7)) @db.Uuid
  key                  String    @unique
  section              String
  nameEn               String
  nameBn               String?
  description          String?
  agentKey             String?
  selectedModelId      String?   @db.Uuid
  recommendedModelId   String?   @db.Uuid
  recommendationNote   String?
  estimatePerRunMicros BigInt?
  actualPerRunMicros   BigInt?
  typicalRunsPerDay    Int?
  qualityBar           Json?
  dataClass            String?
  archivedAt           DateTime? @db.Timestamptz(3)
  createdAt            DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime  @updatedAt @db.Timestamptz(3)
}

/// @stage S15 · PR 314 — the Economy / Balanced / Premium presets (job → model mapping).
/// @scope installation — the shared AI 360 control room.
model AiModelPreset {
  id        String   @id @default(uuid(7)) @db.Uuid
  key       String   @unique
  name      String
  mapping   Json
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

/// @stage S15 · PR 310, 311 — which class of data may reach which class of model, and whether masking applies.
/// @scope installation — the shared AI 360 control room.
model DataClassRoute {
  id                String   @id @default(uuid(7)) @db.Uuid
  dataClass         String   @unique
  allowedModelKinds String[]
  maskingRequired   Boolean  @default(true)
  createdAt         DateTime @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @db.Timestamptz(3)
}

/// @stage S15 · PR 318, 583 — what an agent may do alone, may only propose, or may not touch (enforced by code).
/// @scope installation — the shared AI 360 control room.
model AgentPermission {
  id        String   @id @default(uuid(7)) @db.Uuid
  agentId   String   @db.Uuid
  agent     AiAgent  @relation(fields: [agentId], references: [id])
  resource  String
  level     String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@unique([agentId, resource])
}

/// @stage S15 · PR 315; C1.6 — the one shared ai_usage_ledger behind every AI cost figure (photoshoot and video too).
/// @scope store-optional — attributed to a store where the work was for one (PR 369).
/// @append-only
model AiUsageLedger {
  id             String   @id @default(uuid(7)) @db.Uuid
  storeId        Int?
  store          Store?   @relation(fields: [storeId], references: [id])
  agentId        String?  @db.Uuid
  agent          AiAgent? @relation(fields: [agentId], references: [id])
  jobTypeKey     String?
  providerKey    String
  modelKey       String
  idempotencyKey String   @unique
  inputTokens    Int      @default(0)
  outputTokens   Int      @default(0)
  images         Int      @default(0)
  videoSeconds   Int      @default(0)
  costUsdMicros  BigInt
  costMinor      Int
  exchangeRateId String?  @db.Uuid
  refType        String?
  refId          String?
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  @@index([storeId, createdAt])
  @@index([agentId, createdAt])
  @@index([jobTypeKey, createdAt])
}

/// @stage S15 · PR 309 — the 80 % warning and the 100 % pause of an agent's monthly cap.
/// @scope store-optional — caps exist installation-wide and per store.
/// @append-only
model AiCapEvent {
  id        String   @id @default(uuid(7)) @db.Uuid

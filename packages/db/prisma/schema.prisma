/// @stage S15 · PR 317, 540, 583 — the single approval queue: everything waiting on the owner (money, refunds, COD,
/// prices, discounts, ad budget increases, blocks, deletions, skills, fixes).
/// @scope store-optional — most requests belong to a store; skill and fix approvals are installation-wide.
model AiApprovalRequest {
  id           String         @id @default(uuid(7)) @db.Uuid
  storeId      Int?
  store        Store?         @relation(fields: [storeId], references: [id])
  agentKey     String?
  kind         String
  title        String
  summary      String?
  payload      Json
  status       ApprovalStatus @default(PENDING)
  channel      String?
  refType      String?
  refId        String?
  decidedById  String?        @db.Uuid
  decisionNote String?
  decidedAt    DateTime?      @db.Timestamptz(3)
  expiresAt    DateTime?      @db.Timestamptz(3)
  createdAt    DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime       @updatedAt @db.Timestamptz(3)

  @@index([status, createdAt])
  @@index([storeId, status])
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
  CANCELLED
}


  views            Int            @default(0)
  attributedOrders Int            @default(0)
  publishedAt      DateTime?      @db.Timestamptz(3)
  createdAt        DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime       @updatedAt @db.Timestamptz(3)

  @@unique([channelId, externalId])
}

/// @stage S13 · PR 279 — an SEO outreach prospect.
model OutreachProspect {
  id         String    @id @default(uuid(7)) @db.Uuid
  storeId    Int
  store      Store     @relation(fields: [storeId], references: [id])
  site       String
  contact    String?
  status     String
  linkUrl    String?
  notes      String?
  archivedAt DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @db.Timestamptz(3)
}

/// @stage S13 · PR 280 — a scheduled seasonal homepage switch (applies a snapshot, then reverts).
model ScheduledLayoutSwitch {
  id         String    @id @default(uuid(7)) @db.Uuid
  storeId    Int
  store      Store     @relation(fields: [storeId], references: [id])
  snapshotId String    @db.Uuid
  applyAt    DateTime  @db.Timestamptz(3)
  revertAt   DateTime? @db.Timestamptz(3)
  status     String
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @db.Timestamptz(3)
}

/// @stage S13 · PR 548; S15 · PR 335–337 — a saved competitor or market page studied on a schedule.
model Competitor {
  id         String    @id @default(uuid(7)) @db.Uuid
  storeId    Int
  store      Store     @relation(fields: [storeId], references: [id])
  name       String
  url        String
  schedule   String?
  lastRunAt  DateTime? @db.Timestamptz(3)
  archivedAt DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @db.Timestamptz(3)

  reports CompetitorReport[]
}

/// @stage S15 · PR 335–337 — a teardown report, saved and comparable over time.
/// @append-only
model CompetitorReport {
  id            String     @id @default(uuid(7)) @db.Uuid
  storeId       Int
  store         Store      @relation(fields: [storeId], references: [id])
  competitorId  String     @db.Uuid
  competitor    Competitor @relation(fields: [competitorId], references: [id])
  findings      Json
  diff          Json?
  reportAssetId String?    @db.Uuid
  createdAt     DateTime   @default(now()) @db.Timestamptz(3)
}

/// @stage S13 · PR 569 — district-level ad guidance from where parcels are delivered and paid for.
/// @append-only
model GeoAdRecommendation {
  id             String   @id @default(uuid(7)) @db.Uuid
  storeId        Int
  store          Store    @relation(fields: [storeId], references: [id])
  districtId     String   @db.Uuid
  categoryId     String?  @db.Uuid
  recommendation String
  metrics        Json
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  @@index([storeId, createdAt])
}

/// @stage S13 · PR 589 — a product feed (Merchant Center, Meta catalogue) and its test results.
model ProductFeed {
  id          String    @id @default(uuid(7)) @db.Uuid
  storeId     Int
  store       Store     @relation(fields: [storeId], references: [id])
  kind        String
  url         String?
  itemCount   Int?
  status      String
  testResult  Json?
  lastBuiltAt DateTime? @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)
}

// =====================================================================================================================
// S14 · CRM & customers — PR 284–303, 505, 533–535. One customer record per store, keyed by phone (B5.5). Customers are
// never auto-deleted; only IP and GPS expire (PR 302).
// =====================================================================================================================

/// @stage S14 · PR 284, 534; S06 · PR 163 — a customer (website, Messenger, WhatsApp and phone orders share it).
model Customer {
  id                       String         @id @default(uuid(7)) @db.Uuid
  storeId                  Int
  store                    Store          @relation(fields: [storeId], references: [id])
  /// Normalised E.164; null only for a walk-in at the counter (A6.2).
  phone                    String?
  name                     String?
  email                    String?
  whatsappNumber           String?
  gender                   String?
  /// An inferred gender is shown as a guess, never a fact (B5.2).
  genderInferred           Boolean        @default(false)
  birthday                 DateTime?      @db.Date
  firstSource              String?
  firstCampaignRef         String?
  gradeId                  String?        @db.Uuid
  grade                    CustomerGrade? @relation(fields: [gradeId], references: [id])
  verifiedAt               DateTime?      @db.Timestamptz(3)
  /// PR 163: COD policy a human set for a repeat refuser (reversible by hand).
  codPolicy                String?
  codPolicySetById         String?        @db.Uuid
  codPolicyReason          String?
  smsMarketingConsent      Boolean?
  whatsappMarketingConsent Boolean?
  /// Denormalised counters for the list and the approval screen (PR 533).
  orderCount               Int            @default(0)
  deliveredCount           Int            @default(0)
  returnedCount            Int            @default(0)
  refusedCount             Int            @default(0)
  lifetimeValueMinor       Int            @default(0)
  lastOrderAt              DateTime?      @db.Timestamptz(3)
  legacyImportId           String?        @db.Uuid
  erasedAt                 DateTime?      @db.Timestamptz(3)
  archivedAt               DateTime?      @db.Timestamptz(3)
  createdAt                DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt                DateTime       @updatedAt @db.Timestamptz(3)

  credential CustomerCredential?
  sessions   CustomerSession[]
  addresses  CustomerAddress[]
  carts      Cart[]
  orders     Order[]
  wallet     WalletAccount?
  notes      CustomerNote[]
  tagLinks   CustomerTagLink[]

  @@unique([storeId, phone])
  @@index([storeId, lastOrderAt])
  // PR 603: fuzzy name matching for the identity graph (PR 519).
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "idx_customer_name_trgm")
}

/// @stage S14 · PR 534 — a grade / badge level earned from real delivery history.
model CustomerGrade {
  id         String    @id @default(uuid(7)) @db.Uuid
  storeId    Int
  store      Store     @relation(fields: [storeId], references: [id])
  key        String
  nameEn     String
  nameBn     String?
  criteria   Json
  icon       String?
  sortOrder  Int       @default(0)
  archivedAt DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @db.Timestamptz(3)

  customers Customer[]

  @@unique([storeId, key])
}

/// @stage S14 · PR 297 — an internal note on a customer.
model CustomerNote {
  id         String    @id @default(uuid(7)) @db.Uuid
  storeId    Int
  store      Store     @relation(fields: [storeId], references: [id])
  customerId String    @db.Uuid
  customer   Customer  @relation(fields: [customerId], references: [id])
  body       String
  pinned     Boolean   @default(false)
  authorId   String?   @db.Uuid
  archivedAt DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @db.Timestamptz(3)
}

/// @stage S14 · PR 297 — a customer tag.
model CustomerTag {
  id         String    @id @default(uuid(7)) @db.Uuid
  storeId    Int
  store      Store     @relation(fields: [storeId], references: [id])
  name       String
  color      String?
  archivedAt DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @db.Timestamptz(3)

  links CustomerTagLink[]

  @@unique([storeId, name])
}

/// @stage S14 · PR 297 — a tag on a customer.
model CustomerTagLink {
  id         String      @id @default(uuid(7)) @db.Uuid
  storeId    Int
  store      Store       @relation(fields: [storeId], references: [id])
  customerId String      @db.Uuid
  customer   Customer    @relation(fields: [customerId], references: [id])
  tagId      String      @db.Uuid
  tag        CustomerTag @relation(fields: [tagId], references: [id])
  createdAt  DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime    @updatedAt @db.Timestamptz(3)

  @@unique([customerId, tagId])
}

/// @stage S14 · B5.1 — "Who looked at this customer": every profile open, number copy and export.
/// @append-only
model CustomerAccessLog {
  id          String   @id @default(uuid(7)) @db.Uuid
  storeId     Int
  store       Store    @relation(fields: [storeId], references: [id])
  customerId  String   @db.Uuid
  staffUserId String?  @db.Uuid
  action      String
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  @@index([customerId, createdAt])
}

/// @stage S14 · PR 123, 298 — a consent change per channel, with where and when (SMS and WhatsApp stored separately).
/// @append-only
model ConsentRecord {
  id         String              @id @default(uuid(7)) @db.Uuid
  storeId    Int
  store      Store               @relation(fields: [storeId], references: [id])
  customerId String?             @db.Uuid
  orderId    String?             @db.Uuid
  phone      String?
  channel    NotificationChannel
  granted    Boolean
  source     String
  ip         String?
  createdAt  DateTime            @default(now()) @db.Timestamptz(3)

  @@index([storeId, customerId, channel, createdAt])
}

/// @stage S14 · PR 287, 294 — a saved segment from real behaviour.
model Segment {
  id             String    @id @default(uuid(7)) @db.Uuid
  storeId        Int
  store          Store     @relation(fields: [storeId], references: [id])
  name           String
  definition     Json
  memberCount    Int?
  lastComputedAt DateTime? @db.Timestamptz(3)
  archivedAt     DateTime? @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(3)

  members SegmentMember[]
}

/// @stage S14 · PR 287 — a customer in a computed segment snapshot.
model SegmentMember {
  id         String   @id @default(uuid(7)) @db.Uuid
  storeId    Int
  store      Store    @relation(fields: [storeId], references: [id])

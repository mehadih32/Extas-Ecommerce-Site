  archivedAt DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @db.Timestamptz(3)

  @@index([storeId, customerId])
  @@index([storeId, visitorId])
}

/// @stage S02 · PR 58, 59 — the Find My Size model per garment type and fit (chart data plus the ease model).

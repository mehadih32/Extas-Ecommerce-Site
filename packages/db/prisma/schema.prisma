/// @stage S12 · PR 239, 592 — a blog category (pillar) or sub-category.
model BlogCategory {
  id         String         @id @default(uuid(7)) @db.Uuid
  storeId    Int
  store      Store          @relation(fields: [storeId], references: [id])
  parentId   String?        @db.Uuid
  parent     BlogCategory?  @relation("BlogCategoryTree", fields: [parentId], references: [id])
  children   BlogCategory[] @relation("BlogCategoryTree")
  slug       String
  nameEn     String
  nameBn     String?
  isPillar   Boolean        @default(false)
  sortOrder  Int            @default(0)
  archivedAt DateTime?      @db.Timestamptz(3)
  createdAt  DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime       @updatedAt @db.Timestamptz(3)

  posts BlogPost[]

  @@unique([storeId, slug])
}

/// @stage S12 · PR 239, 593 — an author page. AI authors are labelled honestly (EXTAS's AI writing team).
model BlogAuthor {
  id            String    @id @default(uuid(7)) @db.Uuid
  storeId       Int
  store         Store     @relation(fields: [storeId], references: [id])
  slug          String
  displayName   String
  agentKey      String?
  isAiAuthor    Boolean   @default(false)
  bioEn         String?
  bioBn         String?
  avatarAssetId String?   @db.Uuid
  reviewerLine  String?
  archivedAt    DateTime? @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(3)

  posts BlogPost[]

  @@unique([storeId, slug])
}

/// @stage S12 · PR 239–245, 591 — a blog post through brief → draft → proofread → fact check → SEO → publish.
model BlogPost {
  id               String         @id @default(uuid(7)) @db.Uuid
  storeId          Int
  store            Store          @relation(fields: [storeId], references: [id])
  categoryId       String?        @db.Uuid
  category         BlogCategory?  @relation(fields: [categoryId], references: [id])
  authorId         String?        @db.Uuid
  author           BlogAuthor?    @relation(fields: [authorId], references: [id])
  clusterId        String?        @db.Uuid
  topicId          String?        @db.Uuid
  /// The Bengali twin (PR 588) or the English original.
  twinPostId       String?        @db.Uuid
  locale           String
  slug             String
  title            String
  excerpt          String?
  body             String?
  status           BlogPostStatus @default(IDEA)
  featured         Boolean        @default(false)
  wordCount        Int?
  readingMinutes   Int?
  similarityScore  Float?
  aiAssisted       Boolean        @default(false)
  sourceUrls       String[]
  factSources      Json?
  scheduledAt      DateTime?      @db.Timestamptz(3)
  publishedAt      DateTime?      @db.Timestamptz(3)
  contentUpdatedAt DateTime?      @db.Timestamptz(3)
  archivedAt       DateTime?      @db.Timestamptz(3)
  createdAt        DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime       @updatedAt @db.Timestamptz(3)

  reviews BlogPostReview[]
  tags    BlogPostTag[]

  @@unique([storeId, locale, slug])
  @@index([storeId, status, publishedAt])
}

enum BlogPostStatus {
  IDEA
  BRIEFED
  DRAFT
  PROOFREAD
  FACT_CHECKED
  SEO_CHECKED
  SCHEDULED
  PUBLISHED
  UNPUBLISHED
  ARCHIVED
}

/// @stage S12 · PR 591, 593 — a review step on a post (another author proofreads, Gyani checks facts, Doot does SEO).
/// @append-only
model BlogPostReview {
  id            String   @id @default(uuid(7)) @db.Uuid
  storeId       Int
  store         Store    @relation(fields: [storeId], references: [id])
  postId        String   @db.Uuid
  post          BlogPost @relation(fields: [postId], references: [id])
  stage         String
  reviewerAgent String?
  reviewerId    String?  @db.Uuid
  verdict       String
  notes         String?
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
}

/// @stage S12 · PR 592 — a blog tag.
model BlogTag {
  id        String   @id @default(uuid(7)) @db.Uuid
  storeId   Int
  store     Store    @relation(fields: [storeId], references: [id])
  slug      String
  name      String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  posts BlogPostTag[]

  @@unique([storeId, slug])
}

/// @stage S12 · PR 592 — a tag on a post.
model BlogPostTag {
  id        String   @id @default(uuid(7)) @db.Uuid
  storeId   Int
  store     Store    @relation(fields: [storeId], references: [id])
  postId    String   @db.Uuid
  post      BlogPost @relation(fields: [postId], references: [id])
  tagId     String   @db.Uuid
  tag       BlogTag  @relation(fields: [tagId], references: [id])
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@unique([postId, tagId])

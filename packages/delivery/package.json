{
  "name": "@extas/delivery",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The delivery-zone engine (S06): the national gazetteer and its importer (PR 549), band mapping (PR 550), the ambiguity resolver that waits for the whole line (PR 551), address autocomplete (PR 552), the charge accuracy guard and its collision suite (PR 553) and phone-first area recognition (PR 555).",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./sample": "./src/sample.ts",
    "./settle": "./src/settle.ts"
  },
  "scripts": {
    "gazetteer:import": "tsx src/cli.ts import",
    "gazetteer:sample": "node scripts/make-sample-gazetteer.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "collisions": "vitest run test/accuracy.pure.test.ts"
  },
  "dependencies": {
    "@extas/auth": "workspace:*",
    "@extas/db": "workspace:*",
    "@extas/settings": "workspace:*",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "^22.20.5",
    "eslint": "9.39.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vitest": "3.2.7"
  }
}

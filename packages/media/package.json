{
  "name": "@extas/media",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Image pipeline and media library (PR 22, 23, 24, 25, 37): standardised renditions with sharp, watermark on download, responsive delivery, the photo minimum, search, reuse and orphan clean-up on the storage adapter.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./delivery": "./src/delivery.ts"
  },
  "scripts": {
    "render-pending": "tsx src/cli.ts render-pending",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@extas/adapters": "workspace:*",
    "@extas/auth": "workspace:*",
    "@extas/db": "workspace:*",
    "@extas/settings": "workspace:*",
    "@extas/vault": "workspace:*",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "^22.20.5",
    "eslint": "9.39.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vitest": "3.2.7"
  }
}

{
  "name": "@extas/adapters",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Adapter framework (PR 18): every integration runs mock / sandbox / live with a test-connection, plus the storage adapter (local disk, Azure Blob, S3-compatible).",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1139.0",
    "@azure/storage-blob": "12.34.0",
    "@extas/db": "workspace:*",
    "@extas/erp-types": "workspace:*",
    "@extas/vault": "workspace:*",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "^22.20.5",
    "eslint": "9.39.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vitest": "3.2.7"
  }
}

{
  "name": "extas",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "status:gen": "node tools/make-status.mjs",
    "dev": "pnpm --filter @extas/web dev",
    "build": "pnpm status:gen && pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "guard": "node tools/hardcode-guard.mjs",
    "check": "pnpm guard && pnpm lint && pnpm typecheck && pnpm test"
  }
}

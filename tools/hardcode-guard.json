{
  "$comment": "PR 494 — the hardcode guard's rules. Patterns are data, not code: add a rule here, not in the script. A line can opt out with `hardcode-ok: <reason>` in a comment on the same line; the reason is required and shows in review.",
  "scan": {
    "roots": ["apps", "packages", "tools"],
    "extensions": [".ts", ".tsx", ".js", ".mjs", ".cjs", ".json", ".css"],
    "skipDirs": ["node_modules", ".next", "generated", "dist", "coverage", ".lighthouseci", "migrations"],
    "skipFiles": ["\\.test\\.(ts|tsx|mjs|js)$", "(^|/)test/", "package\\.json$", "tsconfig\\.json$", "hardcode-guard\\.json$", "pnpm-lock\\.yaml$"]
  },
  "rules": [
    { "id": "secret-private-key", "what": "a private key", "pattern": "-----BEGIN [A-Z ]*PRIVATE KEY-----", "everywhere": true },
    { "id": "secret-aws", "what": "an AWS access key", "pattern": "\\bAKIA[0-9A-Z]{16}\\b", "everywhere": true },
    { "id": "secret-github", "what": "a GitHub token", "pattern": "\\bgh[pousr]_[A-Za-z0-9]{30,}\\b", "everywhere": true },
    { "id": "secret-google", "what": "a Google API key", "pattern": "\\bAIza[0-9A-Za-z_-]{35}\\b", "everywhere": true },
    { "id": "secret-openai-anthropic", "what": "an AI provider key", "pattern": "\\bsk-(ant-|proj-)?[A-Za-z0-9_-]{24,}\\b", "everywhere": true },
    { "id": "secret-slack-telegram", "what": "a Slack or Telegram bot token", "pattern": "\\bxox[abpr]-[A-Za-z0-9-]{10,}|\\b\\d{8,10}:AA[0-9A-Za-z_-]{30,}\\b", "everywhere": true },
    { "id": "secret-assignment", "what": "a secret written into code", "pattern": "(password|passwd|secret|api[_-]?key|token|private[_-]?key)[\"']?\\s*[:=]\\s*[\"'][^\"'\\s$]{8,}[\"']", "flags": "i" },
    { "id": "connection-string", "what": "a connection string with credentials", "pattern": "[a-z]+://[^\\s:@/\"']+:[^\\s@/\"']+@", "flags": "i" },
    { "id": "owner-domain", "what": "the shop's domain (a setting: EXTAS_STAGING_HOST, store domains)", "pattern": "\\b(new\\.)?extas\\.com\\.bd\\b", "flags": "i" },
    { "id": "owner-brand", "what": "the store name (a setting, owner data PR 509)", "pattern": "\\bEXTAS\\b" },
    { "id": "phone-bd", "what": "a Bangladeshi phone number (owner or customer data)", "pattern": "(?<![\\d.])(\\+?880|0)1[3-9]\\d{8}(?!\\d)" },
    { "id": "email", "what": "an e-mail address (owner data)", "pattern": "[A-Za-z0-9._%+-]+@[A-Za-z0-9-]+\\.[A-Za-z]{2,}", "allow": "noreply@|@example\\.(com|test)|@users\\.noreply\\.github\\.com" },
    { "id": "money-literal", "what": "a price or amount in Taka (prices are owner data and settings)", "pattern": "৳\\s*[০-৯0-9]|\\bTk\\.?\\s*\\d", "code": true },
    { "id": "business-number", "what": "a business number in code (charges, limits, thresholds come from settings)", "pattern": "\\b[A-Za-z_]*(price|fee|charge|discount|cod|delivery|shipping|threshold|limit|maxQty|minOrder|percent|rate)[A-Za-z_]*\\s*[:=]\\s*-?\\d+(\\.\\d+)?\\b", "flags": "i", "code": true },
    { "id": "clock-hours", "what": "opening or reply hours written into code (support hours are a setting; SIM-F-033)", "pattern": "\\b\\d{1,2}(:\\d\\d)?\\s?(am|pm)\\s*(–|-|to)\\s*\\d{1,2}(:\\d\\d)?\\s?(am|pm)\\b", "flags": "i", "code": true },
    { "id": "promise-copy", "what": "a promise to the customer written into code (customer texts come from messages files, the rule texts PR 215 and settings; SIM-F-031, F-033)", "pattern": "\\bwe(?:'ll| will)? (?:reply|confirm|send|deliver|ship|call|refund|guarantee)\\b|\\byour order is confirmed\\b|\\bat every step\\b|\\bconfirmed and packed\\b|\\binclud(?:e|es|ing) VAT\\b", "flags": "i", "code": true },
    { "id": "fixed-date", "what": "a fixed calendar date in code (festival and campaign dates are settings, empty by default; SIM-F-033)", "pattern": "[\"'`]20\\d\\d-[01]\\d-[0-3]\\d[\"'`]", "code": true },
    { "id": "jsx-text", "what": "visible text written into a component (it belongs in a messages file)", "pattern": ">\\s*[A-Za-z\\u0980-\\u09FF][^<>{}]*[A-Za-z\\u0980-\\u09FF.!?।]\\s*<", "only": "\\.tsx$" },
    {"id": "admin-style-literal", "what": "a colour or a font family in an admin page or style outside the theme layer (use a --lm-* token of apps/web/src/app/admin/theme/; PR 625, CN-036). baseline = what each file had when the rule came; a section PR lowers it, a new file has none", "pattern": "#[0-9A-Fa-f]{6}(?:[0-9A-Fa-f]{2})?\\b|#[0-9A-Fa-f]{3}\\b(?![-\\w])|\\b(?:rgba?|hsla?)\\(|font-family:\\s*['\"]|\\bfont:[^;{}]*'[A-Z]", "only": "^apps/web/src/(app/admin/(?!theme/)|components/admin/)", "code": true, "css": true, "baseline": {"apps/web/src/app/admin/build/build.css":1,"apps/web/src/app/admin/help/manual/manual.css":2,"apps/web/src/app/admin/look.css":103,"apps/web/src/app/admin/marketing/campaigns/campaigns.css":2,"apps/web/src/app/admin/marketing/landing/landing.css":7,"apps/web/src/app/admin/messages/messages.css":7,"apps/web/src/app/admin/orders/packing/invoices/invoices.css":1,"apps/web/src/app/admin/rules/rules.css":13,"apps/web/src/app/admin/settings-cards.css":4,"apps/web/src/app/admin/settings/settings.css":3,"apps/web/src/app/admin/shell.css":104,"apps/web/src/app/admin/support/support.css":3,"apps/web/src/app/admin/website/blog/blog.css":3,"apps/web/src/components/admin/look/kit.tsx":1,"apps/web/src/components/admin/look/thumbs.tsx":69}}
  ]
}
